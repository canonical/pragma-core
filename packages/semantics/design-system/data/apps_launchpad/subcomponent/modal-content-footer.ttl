@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps_launchpad.subcomponent.modal-content-footer a ds:Subcomponent;
    ds:name "Modal.Content.Footer";
    ds:summary "Modal.Content.Footer is the action row region for modal controls.\n\nMain use cases:\n\n- Place confirm/cancel actions in a predictable location.\n- Preserve consistent action alignment across modal variants.\n- Support variable action count with wrapping behavior.";
    ds:anatomyDsl "node:\n  uri: app-launchpad.subcomponent.modal-content_footer\n  styles:\n    layout.type: flow\n    layout.direction: horizontal\n    layout.justify: end\n    layout.wrap: true\n    spacing.gap: spacing/inline/m\n  edges:\n    - node:\n        role: action items\n      relation:\n        cardinality: \"1..*\"";
    ds:anatomyClassic "";
    ds:usage "## When to use\n\nUse it as the primary action container for modal outcomes.";
    ds:guidelines "";
    ds:tier ds:apps_launchpad;
    ds:hasProperty [
        a ds:Property;
        ds:name "children";
        ds:summary "Snippet that renders the content";
        ds:propertyType "Snippet";
        ds:optional "true"
    ];
    ds:parentComponent ds:apps_launchpad.subcomponent.modal-content.
