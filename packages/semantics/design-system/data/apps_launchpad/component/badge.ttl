@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps_launchpad.component.badge a ds:Component;
    ds:name "Badge";
    ds:summary "The **Badge** component is a small, non-interactive element that is used to display a short piece of information, such as a number or a status.\n\n**Main Use Cases:**\n\n- **Notifications:** Display the number of new notifications.\n- **Status:** Indicate the status of an item, such as “New” or “Updated”.\n- **Counts:** Show the number of items in a list.";
    ds:anatomyDsl "---\nnode:\n  uri: app-launchpad.component.badge\n  styles:\n    layout.display: inline-block\n    spacing.internal: spacing/inline/extra-extra-small\n    appearance.background: color/background/neutral/default\n    appearance.radius: radius/full\n    typography.size: typography/paragraph/extra-small/strong\n    typography.color: color/text/reversed\n  edges:\n    - node:\n        role: value text\n      relation:\n        cardinality: \"1\"\n        slotName: value";
    ds:anatomyClassic "https://www.figma.com/design/Y0cqKbTG4rejU9xm2oh5pR/%F0%9F%92%A0-Vanilla---Core-component-library?node-id=2066-5&m=dev";
    ds:usage "### 1. General Description\n\nThe Badge is used to draw attention to a small piece of information. It is a versatile component that can be used in a variety of situations.\n\n### 2. Implementation Guidelines\n\n2.1 When to Use\n\n- **Short information:** Use when you need to display a short piece of information.\n- **Non-interactive:** Use for non-interactive elements.\n\n2.2 When Not to Use\n\n- **Long information:** Do not use for long pieces of information.\n- **Interactive elements:** Do not use for interactive elements. Use a Chip instead.";
    ds:guidelines "### Content Specification\n\n- **Concise:** Keep the content of the badge concise.\n- **Numeric:** Use numeric values whenever possible.";
    ds:tier ds:apps_launchpad;
    ds:hasProperty [
        a ds:Property;
        ds:name "value";
        ds:summary "The value to be displayed in the badge.";
        ds:propertyType "number";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "variant";
        ds:summary "The variant of the badge.";
        ds:propertyType "choice";
        ds:optional "true";
        ds:defaultValue "neutral";
        ds:constraints "neutral, info, success, warning, danger"
    ].
