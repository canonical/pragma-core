@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps_landscape.component.password_constraints a ds:Component;
    ds:name "PasswordConstraints";
    ds:summary "The **Password Constraints** component is a validation feedback list that helps users ensure their password meets security requirements in real-time. It displays a list of criteria (length, casing, numbers) that update visually to indicate success, failure, or neutral states based on the user's input.\n\n\n\n";
    ds:anatomyDsl "---\n# 1. Container (Root)\nnode:\n  uri: global.component.password-constraints\n  styles:\n    # Structural\n    layout.display: block\n    layout.type: stack\n    layout.direction: vertical\n    # Themeable\n    spacing.gap: spacing/vertical/small\n\n  edges:\n    # 2. Title\n    - node:\n        role: title label\n        styles:\n          typography.size: font/size/small   # Maps to .p-text--small\n          typography.color: color/text/muted # Maps to .u-text--muted\n          spacing.margin.bottom: spacing/vertical/small\n        relation:\n          cardinality: \"1\"\n\n    # 3. Constraints List\n    - node:\n        role: constraints list container\n        styles:\n          layout.display: block\n        edges:\n          # 4. Constraint Item (Repeating)\n          - node:\n              role: constraint item\n              styles:\n                # Structural (from .constraint class)\n                layout.type: flow          # Maps to display: flex\n                layout.direction: horizontal\n                layout.align: center       # Maps to align-items: center\n\n                # Themeable\n                spacing.gap: spacing/small # Maps to column-gap: $sph--small\n                spacing.margin.bottom: spacing/small # Maps to margin-bottom: $spv--small\n\n                # Dynamic Appearance (State-based)\n                # Maps to .passed, .default, .failed classes\n                typography.color: [color/positive, color/text/muted, color/negative]\n\n              edges:\n                # 5. Status Icon\n                - node:\n                    uri: global.component.icon\n                    styles:\n                        size.width: size/icon/small\n                        size.height: size/icon/small\n                  relation:\n                    cardinality: \"1\"\n\n                # 6. Constraint Label\n                - node:\n                    role: label text\n                    styles:\n                       typography.size: font/size/small # Maps to .p-text--small\n                  relation:\n                    cardinality: \"1\"\n\n              relation:\n                cardinality: \"4\" # Fixed at 4 items in the original code\n        relation:\n            cardinality: \"1\"";
    ds:anatomyClassic "Table\n\n";
    ds:usage "**When to Use**\n\n- **Password Creation:** Use in registration or \"change password\" forms where specific complexity rules are enforced.\n- **Real-time Validation:** Use to provide immediate feedback as the user types, rather than waiting for form submission.\n\n**When Not to Use**\n\n- **Simple Inputs:** Do not use for standard text fields that do not require complex validation logic.\n- **Hidden logic:** Do not use if the password requirements are not publicly disclosed to the user.";
    ds:guidelines "Do not rely solely on color (red/green) to convey the state of a constraint. The component correctly uses icons (checkmarks/crosses) alongside text to ensure users with color blindness can distinguish between passed and failed states.\n\n\n\nValidation logic triggers on every keystroke (`password` prop update). Ensure the icons transition smoothly between states to prevent visual jarring (flickering).\n\n";
    ds:tier ds:apps_landscape;
    ds:documentationStage ds:tag.specialadoption-docs;
    ds:hasProperty [
        a ds:Property;
        ds:name "password";
        ds:summary "The current value of the password input";
        ds:propertyType "text";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "touched";
        ds:summary "Indicates if the user has interacted with the password field";
        ds:propertyType "boolean";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "hasError";
        ds:summary "Indicates if the parent form field has a validation error.";
        ds:propertyType "boolean";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "className";
        ds:summary "Additional CSS classes for the root container.";
        ds:propertyType "text";
        ds:optional "true"
    ].
