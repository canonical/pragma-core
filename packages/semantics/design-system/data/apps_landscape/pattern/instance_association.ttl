@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps_landscape.pattern.instance_association a ds:Pattern;
    ds:name "Instance Association";
    ds:summary "Instance Association is a Landscape profile-targeting pattern bound to Formik fields `all_computers` and `tags`. It always renders an “Associate to all instances” CheckboxInput; when that value is false, it fetches available tags through `useGetTags`, reveals a searchable MultiSelectField, maps selected options back to `string[]`, and renders every current Formik tag as a dismissible Chip.\n\nThe component owns data access and fixed Landscape terminology rather than exposing a generic composition API. Toggling all instances hides tag controls but does not clear the stored tag array.";
    ds:anatomyDsl "node:\n  uri: ds:apps_landscape.pattern.instance_association\n  edges:\n    - node:\n        semantic: p\n        role: section label\n        content: Association\n        relation:\n          cardinality: \"1\"\n    - node:\n        uri: global.component.checkbox\n        role: all instances control\n        relation:\n          cardinality: \"1\"\n    - node:\n        uri: ds:apps_landscape.component.multi_select_field\n        role: tag selector\n        relation:\n          cardinality: \"0..1\"\n          condition: all instances is false\n    - node:\n        role: selected tags container\n        styles:\n          layout.display: flex\n          layout.wrap: wrap\n          spacing.gap: $spv--x-small\n        edges:\n          - node:\n              uri: global.component.chip\n              role: selected tag\n              relation:\n                cardinality: \"0..*\"\n        relation:\n          cardinality: \"0..1\"\n          condition: all instances is false";
    ds:anatomyClassic "https://www.figma.com/design/I4WpvwMuQI6v1qhgUl63Sx/Landscape-Pragma-components?node-id=25-61&t=iG2ObZ6Q1XG2A2MB-4\n\nTable 35\n\n";
    ds:usage "### When to use\n\n**Profile targeting**\n\nUse when a profile can target every managed instance or instances matching selected tags.\n\n**Visible targeting state**\n\nUse when selected tags must remain reviewable and removable before submission.\n\n**Shared Landscape tag catalogue**\n\nUse when available choices should come from the feature-owned `useGetTags` query rather than a caller-supplied option list.\n\n### When not to use\n\n**Direct instance selection**\n\nSelecting individual instances instead of tag-based groups.\n\n**Incorrect pattern**: Using the MultiSelectField to allow users to pick individual `Instance` objects or instance IDs rather than selecting from predefined tags.\n\n**Remediation strategy**: Use a plain MultiSelectField with instance-level items if direct instance selection is required, not Instance Association.\n\n**Generic taxonomy editing**\n\nCreating or modifying tag definitions rather than selecting existing ones.\n\n**Incorrect pattern**: Rendering the tag selector as if users could add new tags or edit the tag catalogue within the profile form.\n\n**Remediation strategy**: Use a dedicated tag management feature; Instance Association only selects from a read-only tag list via `useGetTags()`.\n\n**Caller-supplied labels or options**\n\nCustomizing terminology, control labels, or dropdown options at the component level.\n\n**Incorrect pattern**: Passing custom label strings, field names, or placeholder text to the component expecting them to override the fixed English copy.\n\n**Remediation strategy**: The component intentionally fixes all visible strings (`Association`, `Associate to all instances`, etc.); only `titleClass` is configurable. If customization is required, build a separate custom component.\n\n**Group semantics supplied by the component**\n\nRelying on the visual “Association” paragraph to programmatically group controls for assistive technology.\n\n**Incorrect pattern**: Assuming the paragraph text acts as a semantic label for the checkbox and selector as a fieldset/legend group.\n\n**Remediation strategy**: Wrap Instance Association in an upstream `<fieldset>/<legend>` or use equivalent ARIA grouping (`role=\"group\"` + `aria-labelledby`); the component does not provide programmatic grouping.";
    ds:guidelines "### Accessibility\n\n- Keep the Tags label available to assistive technology even when it is visually hidden.\n- Canonical Chip supplies the dismiss button behavior; current tests find it by the generic accessible name “Dismiss”. Verify upstream whether the chip value is included in its accessible name before claiming tag-specific announcement.\n- “Association” is a plain paragraph and does not label the checkbox/selector as one group. Use `fieldset`/`legend` or equivalent semantics in an upstream design.\n- Selector, chip, and checkbox keyboard/ARIA behavior is inherited from Canonical components and MultiSelectField; Association Block adds no custom focus management.\n\n### Content\n\n- Use the product terms instances and tags consistently with the surrounding workflow.\n- Explain elsewhere whether selecting all instances also includes instances added later.\n- The visible strings are hardcoded English and are not exposed as props.\n\n### Internationalization\n\n- An upstream API must externalize “Association”, “Associate to all instances”, “Tags”, and “Search and add tags”.\n- Tag values are displayed verbatim as both labels and chips; do not translate identifiers unless the backend’s tag model supports localized display names.\n- Allow chips and long translated selector text to wrap without obscuring controls.\n\n### Keyboard navigation\n\n- Users must be able to toggle all instances, operate the tag selector, and dismiss chips by keyboard.\n- Toggling all instances unmounts potentially focused tag controls. The source does not explicitly relocate or announce focus.\n\n### Device and layout\n\n- The chips container directly uses `display: flex`, `flex-wrap: wrap`, `$spv--x-small` gap, `$spv--x-large` bottom margin, and negative `$spv--small` top margin.\n- The component defines no other responsive styles; MultiSelectField and surrounding forms own selector width and dropdown behavior.";
    ds:tier ds:apps_landscape;
    ds:documentationStage ds:tag.specialadoption-docs;
    ds:hasProperty [
        a ds:Property;
        ds:name "`InstanceAssociation.formik`";
        ds:summary "Supplies field bindings, current values, and async-compatible `setFieldValue`. ";
        ds:propertyType "object";
        ds:defaultValue "—";
        ds:constraints "TypeScript: `FormikContextType<T>` where `T extends AssociationBlockFormProps` and includes `all_computers: boolean` and `tags: string[]`. The component does not expose loading or error parameters for tag fetching. "
    ], [
        a ds:Property;
        ds:name "`InstanceAssociation.titleClass`";
        ds:summary "Merged onto the \"Association\" paragraph with `u-no-margin--bottom`. ";
        ds:propertyType "text";
        ds:defaultValue "—";
        ds:constraints "Does not affect a root wrapper because none exists.";
        ds:optional "true"
    ].
