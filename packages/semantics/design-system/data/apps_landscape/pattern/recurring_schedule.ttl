@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps_landscape.pattern.recurring_schedule a ds:Pattern;
    ds:name "Recurring Schedule";
    ds:summary "Recurring Schedule documents the `ScheduleBlock` composition for scheduling tasks with daily, weekly, monthly, or yearly recurrence. It binds to a supplied Formik context and renders a mode select (one-time or recurring), then condition-dependent controls for start date, interval, \"on\" selector, and end behavior.\n\nMain use cases:\n\n- Guiding users through calendar-based recurrence choices with constrained controls instead of freeform cron or RRULE syntax.  \n- Supporting daily, weekly, monthly, and yearly patterns with unit-specific selectors (weekday multi-select, date-derived monthly choice, month multi-select).  \n- Displaying one-time scheduling with a single required date input.  \n- Separating validation, timezone semantics, and RRULE serialization to the owning Formik consumer (not included in the component).";
    ds:anatomyDsl "node:\n  uri: ds:apps_landscape.pattern.recurring_schedule\n  role: Formik-bound schedule controls\n  edges:\n    - node:\n        uri: global.component.select\n        role: schedule type\n        options:\n          - on a date\n          - recurring\n        attributes:\n          required: true\n        relation:\n          cardinality: \"1\"\n    - node:\n        role: indented schedule branch\n        styles:\n          borderLeft: \"1px solid $colors--theme--border-default\"\n          paddingLeft: \"$sph--large\"\n        edges:\n          - node:\n              uri: global.component.input\n              role: one-time date\n              attributes:\n                type: datetime-local\n                min: current local date-time formatted for the input\n                required: true\n              relation:\n                cardinality: \"0..1\"\n                condition: start_type is on-a-date\n          - node:\n              role: recurring controls\n              edges:\n                - node:\n                    uri: global.component.input\n                    role: recurring start date\n                    attributes:\n                      type: datetime-local\n                      min: current local date-time formatted for the input\n                      required: true\n                    relation:\n                      cardinality: \"1\"\n                - node:\n                    role: repeat interval row\n                    edges:\n                      - node:\n                          uri: global.component.input\n                          role: repeat count\n                          attributes:\n                            type: number\n                            min: 7 when unit_of_time is DAILY; otherwise 1\n                            required: true\n                          relation:\n                            cardinality: \"1\"\n                      - node:\n                          uri: global.component.select\n                          role: repeat unit\n                          attributes:\n                            required: true\n                          relation:\n                            cardinality: \"1\"\n                    relation:\n                      cardinality: \"1\"\n                - node:\n                    role: daily recurrence branch\n                    attributes:\n                      onSelector: none\n                    relation:\n                      cardinality: \"0..1\"\n                      condition: unit_of_time is DAILY\n                - node:\n                    uri: ds:apps_landscape.component.multi_select_field\n                    role: weekly weekday selector\n                    attributes:\n                      required: true\n                    relation:\n                      cardinality: \"0..1\"\n                      condition: unit_of_time is WEEKLY\n                - node:\n                    uri: global.component.select\n                    role: monthly date-derived selector\n                    attributes:\n                      required: true\n                    relation:\n                      cardinality: \"0..1\"\n                      condition: unit_of_time is MONTHLY and start_date is truthy\n                - node:\n                    uri: ds:apps_landscape.component.multi_select_field\n                    role: yearly month selector\n                    attributes:\n                      required: true\n                    relation:\n                      cardinality: \"0..1\"\n                      condition: unit_of_time is YEARLY\n                - node:\n                    uri: global.component.select\n                    role: end type\n                    attributes:\n                      required: true\n                    relation:\n                      cardinality: \"1\"\n                - node:\n                    uri: global.component.input\n                    role: end date\n                    attributes:\n                      type: datetime-local\n                      min: start_date\n                      required: true\n                    relation:\n                      cardinality: \"0..1\"\n                      condition: end_type is on-a-date\n              relation:\n                cardinality: \"0..1\"\n                condition: start_type is recurring\n        relation:\n          cardinality: \"1\"";
    ds:anatomyClassic "https://www.figma.com/design/I4WpvwMuQI6v1qhgUl63Sx/Landscape-Pragma-components?node-id=25-82&t=iG2ObZ6Q1XG2A2MB-4\n\nTable 46\n\n";
    ds:usage "### When to use\n\n**Calendar-based recurrence**\n\nUse when the owning Formik model already matches `ScheduleBlockFormProps` and the backend contract supports one-time execution or daily/weekly/monthly/yearly recurrence.\n\n**Guided schedule creation**\n\nUse when users benefit from constrained controls rather than authoring cron or RRULE syntax directly.\n\n### When not to use\n\n**Cron-level expressiveness**\n\nA backend API or user workflow that requires cron or RRULE syntax, allowing lists, ranges, or step values across multiple fields.\n\n**Incorrect pattern**: Trying to use Recurring Schedule to express “every 3rd weekday” or “the 1st and 15th of each month” when the component’s domain model is simpler.\n\n**Remediation strategy**: Use a dedicated cron or RRULE editor component. Cron Schedule or a raw syntax editor may be more appropriate. The shared component supports only simple daily/weekly/monthly/yearly cadences.\n\n**Simple preset cadence**\n\nA workflow where only two or three fixed choices—such as “Daily”, “Weekly”, or “Once”—satisfy user needs.\n\n**Incorrect pattern**: Rendering the full Recurring Schedule form when the real requirement is to choose from a small set of predefined frequencies.\n\n**Remediation strategy**: Use a simpler radio-button or preset-menu control that offers only the supported cadences. Avoid full-featured form complexity when the choice set is fixed and small.\n\n**Standalone date validation**\n\nA use case where the input validation and timezone semantics are critical but must come from a different system (e.g., the API layer).\n\n**Incorrect pattern**: Relying on the rendered `min` attributes and Formik error display as the complete validation story for date ordering and timezone conversion.\n\n**Remediation strategy**: Implement comprehensive validation in the owning Formik schema and on the server. The shared component displays errors but does not enforce complex backend semantics or timezone logic.\n\n**Timezone-explicit scheduling**\n\nA workflow where the timezone context—whether local, UTC, or explicitly selected—and daylight-saving behavior must be explicit and configurable.\n\n**Incorrect pattern**: Using Recurring Schedule without a clear product decision about timezone handling, then discovering at runtime that `datetime-local` does not capture or convert timezones.\n\n**Remediation strategy**: Document the timezone semantics in the owning workflow. Add an explicit timezone selector if needed. The shared component does not state or convert timezones; it uses browser-native `datetime-local` input only.";
    ds:guidelines "### Accessibility\n\n- Source labels every rendered control, but both interval controls use the same visible text “Repeat every”; verify their accessible names are distinguishable in the target Canonical component version.\n- Conditional controls are inserted in DOM order without focus movement or announcements. Mode/unit changes leave focus on the triggering select.\n- Error association is delegated to Canonical `Input`, `MultiSelectField`, and `getFormikError`; local tests verify visible fields and updates, not computed ARIA relationships.\n- The hidden placeholder option is not a substitute for a validation error when `start_type` is empty at runtime.\n\n### Content and correctness\n\n- State the timezone and daylight-saving semantics in the owning workflow. `datetime-local` contains no timezone.\n- Unit copy uses a simple `every == 1` singular check; all other values receive plural labels. There is no cadence summary.\n- English weekday/month labels, ordinal suffixes, “First” through “Last”, and `en-US` weekday formatting are hardcoded with no localization props.\n- Validate required fields, positive/integer intervals, minimum daily interval, selections, date ordering, and backend recurrence semantics in the consumer and server.\n\n### State and async behavior\n\n- The component owns no React state, effects, query, mutation, loading state, submit handler, or reset behavior.\n- All values are controlled by the supplied Formik context. Hidden branch values remain in Formik unless the consumer clears them.\n- Weekly/yearly multi-select updates call `setFieldValue` from an async callback; errors from that promise are not handled locally.\n- `currentDate` is computed on each render, not advanced by a timer while the component remains idle.\n\n### Keyboard and device\n\n- Native Select/Input keyboard behavior and date entry are dependency/browser-owned. Weekly/yearly keyboard behavior is delegated to `MultiSelectField`.\n- Repeat controls always use a Canonical Row with two size-6 columns. There is no local breakpoint, stacking branch, or responsive style in this component.\n- The indented branch always retains its border and `$sph--large` left padding; verify available width in narrow side panels.\n- Local tests cover rendering and pointer-based multi-select updates, not keyboard traversal, focus retention, mobile date pickers, or small viewports.";
    ds:tier ds:apps_landscape;
    ds:documentationStage ds:tag.specialadoption-docs;
    ds:hasProperty [
        a ds:Property;
        ds:name "`formik`";
        ds:summary "Supplies values, field bindings, touched/errors state, and `setFieldValue`. ";
        ds:propertyType "object";
        ds:defaultValue "—";
        ds:constraints "TypeScript: `FormikContextType<T>` where `T extends ScheduleBlockFormProps`. Multi-select updates call async `setFieldValue`; the component does not handle errors from that promise. "
    ].
