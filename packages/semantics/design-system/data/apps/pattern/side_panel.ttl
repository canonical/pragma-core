        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.border.highlighted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 3;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.highlighted.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.size";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.size.fontSize.300
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
