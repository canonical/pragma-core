@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps.pattern.side_panel a ds:Pattern;
    ds:name "SidePanel";
    ds:summary "A side panel is a non-modal surface that overlaps the main area without changing its size, docked to the edge of the viewport, for work that accompanies the current view rather than interrupting it. The view behind stays visible, clickable and tabbable; there is no backdrop, no focus trap and no aria-modal, and focus moves into the panel on open but is never trapped.";
    ds:anatomyDsl "\n# Authored 2026-09-17 from @canonical/react-ds-app\n# src/lib/SidePanel/styles.css on .ds.side-panel, which IS the <dialog> element.\n# A NON-MODAL dialog (show(), not showModal()): the top layer supplies nothing,\n# so there is no ::backdrop edge (a backdrop is only painted for modal dialogs,\n# and the application behind must stay interactive) and the panel carries its\n# own positioning, stacking and separation.\nnode:\n  uri: apps.pattern.side_panel\n  styles:\n    # Declared only on [open], because a closed <dialog> is display: none by\n    # user-agent rule and an unconditional display would leave it visible.\n    layout.type: flex\n    layout.direction: column\n    # A non-modal dialog is not in the top layer, so docking is ours:\n    # inset-block: 0 and inset-inline-end: 0 against the viewport's inline-end.\n    layout.position: fixed\n    layout.offset.block.start: 0\n    layout.offset.block.end: 0\n    layout.offset.inline.end: 0\n    # The UA stylesheet sets position: absolute, margin: auto (which would\n    # centre the panel), a ~3px border and 1em of padding — each reset\n    # explicitly rather than left undeclared.\n    spacing.external.block.start: 0\n    spacing.external.block.end: 0\n    spacing.external.inline.start: 0\n    spacing.external.inline.end: 0\n    spacing.internal.block.start: 0\n    spacing.internal.block.end: 0\n    appearance.border.style: none\n    # The inline padding lives here, not on the header, content and footer, so\n    # all three sit inside one text column. The implementation reads\n    # --dimension-300 through a component-local custom property; the roster's\n    # spacing.* keys admit spacing. symbols only, so this is the literal value.\n    spacing.internal.inline.start: 0.75rem\n    spacing.internal.inline.end: 0.75rem\n    # The UA's max-size caps are explicitly lifted (max-inline-size: none,\n    # max-block-size: none) and its fit-content height reverted to auto so\n    # inset-block spans the full viewport — nothing to bind.\n    #\n    # inline-size is min(--side-panel-inline-size, 100vw) with the component\n    # token a 33.5rem literal: size.inline takes a token only and\n    # design-tokens ships no size token, so it is not bound.\n    #\n    # Stacking is ours to manage (no top layer); matches the demo's Drawer.\n    layout.stack: 1000\n    appearance.radius: dimension.radius.medium\n    # box-shadow: 0 0 32px 0 rgba(0,0,0,.2) — design-tokens has no shadow token\n    # and no roster key takes one, so it is not bound. Unlike a modal, where the\n    # backdrop separates, the shadow is what separates the panel from the live\n    # page, so it cannot be dropped.\n    #\n    # The surface channels are read on the element itself, not at :root — a\n    # custom property substitutes where it is declared, and at :root the\n    # channels are unset.\n    appearance.background: [surface.color.background, color.background]\n    typography.color: [surface.color.text, color.text]\n    # The dialog itself is the scroller, not the content pane — the scrollbar\n    # sits at the panel's edge, inside the padding; the header and footer stay\n    # visible by sticking to this scrollport.\n    layout.overflow.block: auto\n    layout.overflow.inline: hidden\n    # Don't hand the scroll to the page behind once the panel bottoms out.\n    layout.overscroll: contain\n    # transform carries the slide-in/out; display is transitioned discretely so\n    # the slide-out is seen before the dialog hides. No overlay in the list: it\n    # only applies to top-layer elements. The translate itself is motion state,\n    # not bound.\n    motion.property: \"transform, display\"\n    motion.duration: motion.duration.medium\n    # The base rule ships the exit easing and [open] swaps to the enter one\n    # (motion-easing-accelerate / motion-easing-decelerate); the roster has one\n    # easing key, so the base is bound and the pair noted.\n    motion.easing: motion.easing.accelerate\n    # outline: none on :focus suppresses the container's focus ring for pointer\n    # focus only (:focus-visible keeps it) — state-scoped, left unbound.\n  edges:\n    - node:\n        uri: apps.subcomponent.side_panel-header\n      relation:\n        cardinality: \"1\"      \n        slotName: header\n    - node:\n        uri: apps.subcomponent.side_panel-content\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        uri: apps.subcomponent.side_panel-footer\n      relation:\n        cardinality: \"0..1\"\n        slotName: footer";
    ds:anatomyClassic "";
    ds:usage "**When to use**\n\n- When showing details of a selected entity.\n- When there is work that accompanies the current view — inspecting or editing an item while the list/app behind stays visible and usable.  \n- When the user needs to fill a form in applications (per Modal guidance: websites → modals,  apps → side panels or full pages). Use side panels when there are multi-step flows that need layer/nesting.\n- Viewing an item's associated entities when the main listing page can't be filtered to just those.\n\n\n\n**When not to use:**\n\n- Interruptive moments needing an explicit decision — for confirmations, destructive actions, warnings, unsaved-changes alerts  use Modal.\n- Anything requiring the page behind to be inert: the panel has no backdrop, no focus trap, no aria-modal; the application stays clickable and tabbable by design.\n- Opening from inside a modal — a side panel can trigger a modal, never the reverse.\n- When there is Information the user must acknowledge before continuing.";
    ds:guidelines "";
    ds:tier ds:apps;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasSubcomponent ds:apps.subcomponent.side_panel-footer, ds:apps.subcomponent.side_panel-header, ds:apps.subcomponent.side_panel-content;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "motion.duration";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:motion.duration.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.pattern.side_panel;
        ds:node "$root";
        anatomy:styleKey "motion.easing";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:motion.easing.accelerate
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-header;
        ds:node "$root/title";
        anatomy:styleKey "typography.size";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.size.fontSize.500
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-header;
        ds:node "$root/title";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.light
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-header;
        ds:node "$root/title";
        anatomy:styleKey "typography.fontFamily";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.fontFamily.default
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-header;
        ds:node "$root/title";
        anatomy:styleKey "typography.letterSpacing";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.letterSpacing.default
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.foreground.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.foreground.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.primary.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "active";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.primary.active
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.primary.disabled
    ], [
