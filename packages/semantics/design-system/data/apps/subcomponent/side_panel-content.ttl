@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps.subcomponent.side_panel-content a ds:Subcomponent;
    ds:name "SidePanel.Content";
    ds:summary "";
    ds:anatomyDsl "", "---\n\n# Authored 2026-09-17 from @canonical/react-ds-app\n\n# src/lib/SidePanel/common/Content/styles.css on .ds.side-panel-content.\n\nnode:\n\n  uri: apps.subcomponent.side_panel-content\n\n  styles:\n\n    # Takes the space the header and footer leave, so a short panel still fills.\n\n    layout.flex.grow: 1\n\n    layout.flex.shrink: 1\n\n    # No scroller here: overflow spills to the panel, which scrolls — that is\n\n    # what keeps the scrollbar at the panel's edge rather than inside the text\n\n    # column. Padding reads a component-local custom property over\n\n    # --dimension-200; spacing.* keys admit spacing. symbols only, so literals.\n\n    spacing.internal.block.start: 0.5rem\n\n    spacing.internal.block.end: 0.5rem\n\n  edges:\n\n    - node:\n\n        role: content\n\n      relation:\n\n        cardinality: \"1\"\n\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:apps;
    ds:documentationStage ds:tag.needsdefinition;
    ds:parentComponent ds:apps.pattern.side_panel.
