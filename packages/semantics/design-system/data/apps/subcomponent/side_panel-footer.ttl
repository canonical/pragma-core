ds:apps.subcomponent.side_panel-footer a ds:Subcomponent;
    ds:name "SidePanel.Footer";
    ds:summary "";
    ds:anatomyDsl "", "---  \nnode:  \n  uri: apps.subcomponent.side_panel-footer  \n  styles:  \n    layout.type: flow  \n    layout.direction: horizontal  \n    layout.justify: end  \n    layout.align: center  \n    spacing.gap: spacing/small                       # --dimension-200  \n    spacing.internal.block: spacing/small            # --dimension-200  \n    appearance.border.top: border/style/divider  \n    # Sticky to the panel's bottom: actions stay reachable while content scrolls  \n  edges:  \n    - node:  \n        uri: global.component.button  \n      relation:  \n        cardinality: \"0..*\"  \n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
