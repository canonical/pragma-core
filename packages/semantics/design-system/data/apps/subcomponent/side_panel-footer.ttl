@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps.subcomponent.side_panel-footer a ds:Subcomponent;
    ds:name "SidePanel.Footer";
    ds:summary "";
    ds:anatomyDsl "", "---\n\n# Authored 2026-09-17 from @canonical/react-ds-app\n\n# src/lib/SidePanel/common/Footer/styles.css on .ds.side-panel-footer.\n\nnode:\n\n  uri: apps.subcomponent.side_panel-footer\n\n  styles:\n\n    # Never shrinks, and stays visible: the panel scrolls beneath it.\n\n    layout.flex.grow: 0\n\n    layout.flex.shrink: 0\n\n    layout.position: sticky\n\n    layout.offset.block.end: 0\n\n    # Above the in-flow content, whatever it contains.\n\n    layout.stack: 1\n\n    # Opaque, so scrolling content passes behind rather than through; `inherit`\n\n    # resolves whatever surface colour the panel painted.\n\n    appearance.background: inherit\n\n    layout.type: flex\n\n    layout.justify: end\n\n    layout.align: center\n\n    layout.wrap: wrap\n\n    spacing.gap: 0.5rem\n\n    spacing.internal.block.start: 0.5rem\n\n    spacing.internal.block.end: 0.5rem\n\n    # Closes the scroll region. It lives here rather than on the content pane\n\n    # because the panel is the scroller: a border on the content would scroll\n\n    # away, whereas this one is pinned by the sticky footer. The colour is the\n\n    # muted border (--color-border-muted), a divider, not a boundary. The\n\n    # roster measures border widths on the top key and colours on the\n\n    # block-start key; the shorthand's `solid` goes through the box-wide style\n\n    # key.\n\n    appearance.border.top.width: dimension.stroke.thickness.medium\n\n    appearance.border.block.start.color: color.border.muted\n\n    appearance.border.style: solid\n\n  edges:\n\n    - node:\n\n        uri: global.component.button\n\n      relation:\n\n        cardinality: \"0..*\"\n\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:apps;
    ds:documentationStage ds:tag.needsdefinition;
    ds:parentComponent ds:apps.pattern.side_panel;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-footer;
        ds:node "$root";
        anatomy:styleKey "appearance.border.top.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-footer;
        ds:node "$root";
        anatomy:styleKey "appearance.border.block.start.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
