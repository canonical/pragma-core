@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps.subcomponent.side_panel-header a ds:Subcomponent;
    ds:name "SidePanel.Header";
    ds:summary "";
    ds:anatomyDsl "", "---\n\n# Authored 2026-09-17 from @canonical/react-ds-app\n\n# src/lib/SidePanel/common/Header/styles.css on .ds.side-panel-header.\n\nnode:\n\n  uri: apps.subcomponent.side_panel-header\n\n  styles:\n\n    # Never scrolls: sticky to the panel's scrollport while content passes\n\n    # beneath it.\n\n    layout.flex.grow: 0\n\n    layout.flex.shrink: 0\n\n    layout.position: sticky\n\n    layout.offset.block.start: 0\n\n    # Above the in-flow content, whatever it contains.\n\n    layout.stack: 1\n\n    # Opaque, so scrolling content passes behind rather than through. `inherit`\n\n    # picks up whichever surface colour the panel resolved, so the two cannot\n\n    # drift apart; written as it stands.\n\n    appearance.background: inherit\n\n    layout.type: flex\n\n    layout.align: center\n\n    # The gap and block padding read component-local custom properties over\n\n    # --dimension-200; the roster's spacing.* keys admit spacing. symbols only,\n\n    # so these are literal values.\n\n    spacing.gap: 0.5rem\n\n    spacing.internal.block.start: 0.5rem\n\n    spacing.internal.block.end: 0.5rem\n\n  edges:\n\n    - node:\n\n        role: title\n\n        styles:\n\n          # The heading-4 scale (--typography-heading-4-*), which retunes per\n\n          # breakpoint. line-height reads\n\n          # --typography-heading-4-line-height-dimension (--dimension-400); the\n\n          # roster's typography.lineHeight admits typography. symbols only, so\n\n          # it is not bound.\n\n          typography.size: dimension.size.fontSize.500\n\n          typography.weight: typography.weight.light\n\n          typography.fontFamily: typography.fontFamily.default\n\n          typography.letterSpacing: dimension.letterSpacing.default\n\n          layout.flex.grow: 1\n\n          layout.flex.shrink: 1\n\n      relation:\n\n        cardinality: \"1\"\n\n        slotName: default\n\n    - node:\n\n        uri: global.component.button\n\n        props:\n\n          icon: close\n\n          importance: tertiary\n\n      relation:\n\n        cardinality: \"0..1\"      # omitted when the panel is undismissible\n\n        slotName: dismiss";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:apps;
    ds:documentationStage ds:tag.needsdefinition;
    ds:parentComponent ds:apps.pattern.side_panel;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-header;
        ds:node "$root/title";
        anatomy:styleKey "typography.size";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.size.fontSize.500
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:apps.subcomponent.side_panel-header;
        ds:node "$root/title";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.light
    ], [
