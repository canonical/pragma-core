@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:apps.component.side_navigation a ds:Component;
    ds:name "SideNavigation";
    ds:summary "Spec reference: [https://docs.google.com/document/d/1AeX_4NtUHxXDJgKqrZEpTXPJBIU9pyXxp0HJGcitX5g/edit?tab=t.0#heading=h.yij8xaij9lcy](https://docs.google.com/document/d/1AeX_4NtUHxXDJgKqrZEpTXPJBIU9pyXxp0HJGcitX5g/edit?tab=t.0#heading=h.yij8xaij9lcy)\n\nThe application side navigation provides users with a way to navigate through various sections, features, or pages of an application. It appears as a vertical panel on the left side of the screen. The navigation can have two levels: primary and secondary. The primary navigation is always visible, while the secondary navigation can be used as needed to display a second level of navigation.";
    ds:anatomyDsl "Side navigation\n├── Primary navigation\n│   ├── Header (sticky)\n│   │   ├── Logo\n│   │   └── Collapse/expand button\n│   ├── Content\n│   │   ├── Context switcher (optional)\n│   │   └── Nav\n│   │       └── Navigation item group (repeatable)\n│   │           ├── Divider (shown before every group except the first)\n│   │           ├── Group header (optional)\n│   │           └── Navigation item (repeatable)\n│   └── Footer (sticky)\n│       └── Navigation item (repeatable, optional)\n│\n└── Secondary navigation (optional)\n    ├── Header (sticky)\n    │   └── Title\n    └── Content\n        └── Nav\n            └── Navigation item group (repeatable)\n                ├── Divider (shown before every group except the first)\n                ├── Group header (optional)\n                └── Navigation item (repeatable)\n```\n\n```yaml\n---\n# SideNavigation — the apps-tier navigation rail.\n#\n# Authored 2026-10-16 from the supplied planning tree ALONE. No\n# implementation was read, so this anatomy carries STRUCTURE ONLY: the tree\n# states parts, nesting, optionality and repetition, and states nothing\n# about colour, spacing or layout. Styles are therefore absent rather than\n# invented, and are added when a stylesheet exists to transcribe.\n#\n# Reading of the tree's own vocabulary, applied consistently across all five\n# files: \"optional\" is 0..1, \"repeatable\" is 1..*, and \"repeatable,\n# optional\" is 0..*. Anything unmarked is exactly 1.\n#\n# The tree names \"Header\" in both panes. They are taken to be the SAME block,\n# which means its own anatomy has to accommodate both child sets the tree\n# shows — Logo plus Collapse/expand button in the primary pane, Title in the\n# secondary. Those children live in the Header block's anatomy, which this\n# spec does not author.\n#\n# \"Sticky\" is positional and belongs to Header's and Footer's own anatomies.\nnode:\n  uri: apps.component.side_navigation\n  edges:\n    - node:\n        role: primary navigation\n        edges:\n          # Sticky. Holds the logo and the collapse/expand button.\n          - node:\n              uri: apps.subcomponent.side_navigation-header\n            relation:\n              cardinality: \"1\"\n              slotName: header\n          - node:\n              uri: apps.subcomponent.side_navigation-content\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          # Sticky. Its navigation items are repeatable and optional; that\n          # cardinality lives in the Footer block's own anatomy.\n          - node:\n              uri: apps.subcomponent.side_navigation-footer\n            relation:\n              cardinality: \"1\"\n              slotName: footer\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        role: secondary navigation\n        edges:\n          # Sticky. Holds a title where the primary pane's header holds the\n          # logo and the collapse/expand button.\n          - node:\n              uri: apps.subcomponent.side_navigation-header\n            relation:\n              cardinality: \"1\"\n              slotName: header\n          # The same Content block, filled without a context switcher.\n          - node:\n              uri: apps.subcomponent.side_navigation-content\n            relation:\n              cardinality: \"1\"\n              slotName: default\n      relation:\n        cardinality: \"0..1\"\n        slotName: secondary";
    ds:anatomyClassic "Primary and secondary navigation anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10062-7892&t=jKfhm8OeWic0xeTh-1\n\nPrimary and secondary navigation styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=9135-3160&t=cvso6VLbvdw3Jfys-1\n\nMobile navigation — Closed state anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=11028-12154&t=kljb9kz81nAn2N2G-1\n\nMobile navigation — Closed state styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=11028-16236&t=kljb9kz81nAn2N2G-1\n\nMobile navigation — Open state anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=11030-17171&t=kljb9kz81nAn2N2G-1\n\nMobile navigation — Open state styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=11030-17517&t=kljb9kz81nAn2N2G-1\n\nMobile navigation — Child navigation open anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=11030-18532&t=kljb9kz81nAn2N2G-1\n\nMobile navigation — Child navigation open styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=11030-19051&t=kljb9kz81nAn2N2G-1\n\nPrimary navigation header anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10062-9692&t=cvso6VLbvdw3Jfys-1\n\nPrimary navigation header styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10064-18511&t=cvso6VLbvdw3Jfys-1\n\nSecondary navigation header anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10062-11491&t=cvso6VLbvdw3Jfys-1\n\nSecondary navigation header styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10064-22043&t=cvso6VLbvdw3Jfys-1\n\nPrimary navigation footer anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10062-11650&t=cvso6VLbvdw3Jfys-1\n\nPrimary navigation footer styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=10064-25117&t=cvso6VLbvdw3Jfys-1";
    ds:usage "## When to use\n\nUse side navigation as the primary navigation for applications.\n\nUse secondary navigation when there are many (5 or more) second-level items that cannot comfortably fit within an expandable navigation item. A common use case is settings.\n\n## When not to use\n\nAvoid using side navigation for anything other than application tiers.\n\nAvoid secondary navigation when second-level items can comfortably fit within an expandable navigation item.";
    ds:guidelines "## Content specification\n\n### Primary navigation (expanded)\n\nThe primary navigation is always displayed in a Canonical application, except when the user is not logged in.\n\n**Header**\n\n- The header is always displayed.\n- The expand/collapse functionality of the primary navigation cannot be disabled.\n\n**Content**\n\nThe navigation content is defined by the designer and can include the following sub-components:\n\n- Context switcher (optional, primary navigation only)\n- Navigation item group\n  - Divider\n  - Group header (optional)\n  - Navigation items\n\nThe designer can arrange the sub-components in this section as needed, following these guidelines:\n\n- The context switcher, when used, is always positioned at the top.\n- The primary navigation can be divided into groups.\n- Within each group, navigation items should either all have icons or none should.\n- Each group can have an optional group header.\n- Each group, except the first, should have a divider at the top to separate it from the previous group.\n\n**Footer**\n\nThe footer is reserved for user-related content and may contain account settings, notifications, and logout. All footer items are optional.\n\nIf the application supports certificate users (like LXD), the certificate icon is used instead of the profile icon, and the logout option is hidden.\n\n### Primary navigation (collapsed)\n\nThe collapsed state of the side navigation does not display navigation items for the following reasons:\n\n- To display navigation items in the collapsed state, they would need to have icons. However, we cannot guarantee that every navigation item will have an icon. Items without icons would either cause navigation items to jump when the navigation expands or collapses, or create large gaps between items.\n- Navigation with a context switcher would not be able to display it properly in the collapsed state, potentially causing navigation items to jump.\n- The behaviour of expandable/collapsible navigation items is undefined when the side navigation collapses. Should expanded items collapse as well (causing items to jump) or remain expanded (creating large gaps)?\n- The expand button needs to move down in the collapsed state, causing navigation items to jump.\n\n### Secondary navigation\n\nThe secondary navigation can be used as a second level of navigation, as designers see fit.\n\nThe secondary navigation cannot be collapsed.\n\n**Title**\n\nThe title reflects the name of the expanded primary navigation item. However, this is not always the case. For example, a primary navigation item displaying the user's username may expand a secondary navigation titled \"Account settings\". In this case, the title reflects the nature of the navigation content and not the original label.\n\n**Content**\n\nThe navigation content is defined by the designer and can include the following sub-components:\n\n- Navigation item group\n  - Divider\n  - Group header (optional)\n  - Navigation items\n\nThe designer can arrange the sub-components in this section as needed, following these guidelines:\n\n- Navigation items cannot be expandable.\n- Navigation items cannot have icons.\n- Each group can have an optional group header.\n- Each group, except the first, should have a divider at the top to separate it from the previous group.\n\n### Text overflow\n\nDesigners should choose labels that do not overflow. If there is insufficient space, text in the secondary navigation title is truncated to a single line.\n\nWhen the text is truncated, a tooltip displaying the full text appears after an 800 ms hover delay.\n\n## Responsive behaviour\n\n### Desktop\n\nAbove the small breakpoint (620px), the standard desktop side navigation is used.\n\n### Mobile navigation\n\nAt the small breakpoint (620px) and below, a customised version of the side navigation is used, optimised for mobile.\n\nThe collapse/expand button is replaced by a button labelled “Menu”. On mobile, the header is always shown, while the content and footer are hidden.\n\nWhen the user clicks the Menu button, the navigation opens in full screen, displaying its content and footer. The button label changes to “Close menu”.\n\nThe styling of the navigation stays largely the same as on desktop, including spacing, overflow lines, and the sticky footer.\n\n### Context switcher\n\nThe context switcher appears in the same position as on desktop. When the user opens the dropdown, the context list is displayed on top of the navigation content.\n\nWhen the context is switched, the mobile navigation closes. The current page remains open if it exists in the newly selected context. Otherwise, the default page of the new context is opened.\n\n### Items with children and secondary navigation\n\nWhen an item has children, this is indicated by a chevron pointing to the right, regardless of whether the item is expandable or opens secondary navigation on desktop. When the user clicks on this item, its children are displayed on a new page within the navigation. Both types of navigation items behave in the same way on mobile.\n\nWhen the user clicks on one of these items, a back button with a chevron pointing to the left is displayed at the top of the navigation.\n\n## Interaction\n\n### Primary navigation\n\n**Logo**\n\nOn hover, the cursor changes to a pointer to indicate that the logo is clickable.\n\nOn click, the user is directed to the page specified in the `logo-target` property. By default, this is the first navigation item that links to a page. We recommend using a page that offers the most general view of the application or its most frequently used section.\n\n**Collapse/expand button**\n\nOn hover, the button’s background colour changes and the cursor changes to a pointer. After a 1-second delay, a tooltip appears to the right of the button, displaying “Collapse” or “Expand” depending on the navigation state. The hover transition is not animated.\n\nOn click, the button toggles the `is-open` state of the primary navigation, expanding or collapsing it. The button’s background colour also changes.\n\n**Footer**\n\nClicking the account settings item opens the application’s account settings page. Clicking notifications opens the notifications page, and clicking logout logs the user out.\n\nWhen the primary navigation is collapsed, footer items display their labels in tooltips after an 800 ms hover delay.\n\n### Secondary navigation\n\nClicking a primary navigation item configured to display its children in secondary navigation opens the secondary navigation.\n\nThe secondary navigation is hidden when the user clicks a primary navigation item that does not display its children in secondary navigation.\n\n## Accessibility\n\n### Keyboard navigation\n\n**Focus order**\n\nThe \"Skip to main content\" link should be first in the page's tab order, before the side navigation.\n\nWithin the side navigation, the focus order should follow a coherent sequence. Here is the recommended order:\n\n1. Logo\n2. Expand/collapse button\n3. Navigation content (following a top-to-bottom order for all interactive elements)\n4. Footer content (also in a top-to-bottom sequence for all interactive elements)\n\nWhen secondary navigation is displayed, its interactive elements should also follow a logical focus order.\n\n**Collapse/expand button**\n\nWhen the expand/collapse button has focus, pressing the `Enter` or `Space` key should toggle the expansion or collapse of the primary navigation.\n\n**Collapse/expand shortcut**\n\nPressing `Ctrl + E` toggles the primary navigation between expanded and collapsed states.\n\n**Skip to main content**\n\nWhen using the side navigation, make sure to have a \"Skip to main content\" link at the top of the page to allow keyboard and screen-reader users to bypass the navigation and go straight to the main content if they wish.\n\n### Screen reader\n\n**Navigation labels**\n\nUse `aria-label` to provide the name \"Main navigation\" for the primary navigation. When secondary navigation is present, it should have a distinct accessible name.\n\n**Logo**\n\nIf the logo text is an SVG and cannot be read by a screen reader, alternative text with the same text that is visible on the screen should be provided.\n\n**Collapse/expand button**\n\nThe button should be announced with the action opposite to its current state. For example, if the navigation is expanded, it should read \"Collapse navigation\".\n\nThe button should also expose its current expanded or collapsed state to screen readers.\n\n**Footer**\n\nThe footer items should be read as any other navigation group, with accessible names that describe their purpose.\n\n### Icon-only navigation\n\nIcon-only navigation items can be difficult to understand, especially when icons are ambiguous or abstract. The collapsed state would not be able to properly display labels for navigation items.\n\n### Tooltips\n\nTooltips for the collapse/expand button and footer items in the collapsed state must appear on both hover and keyboard focus. These controls must also have accessible names that do not rely on tooltips alone.\n\n### Reduced motion\n\nFor users with a preference for reduced motion, all animations within the side navigation should be disabled. This ensures a more comfortable experience for individuals sensitive to motion.";
    ds:tier ds:apps;
    ds:documentationStage ds:tag.docscomplete;
    ds:hasProperty [
        a ds:Property;
        ds:name "logo";
        ds:summary "Defines the product logo displayed at the top of the primary navigation.";
        ds:propertyType "choice";
        ds:optional "false";
        ds:defaultValue "Canonical"
    ], [
        a ds:Property;
        ds:name "logo-target";
        ds:summary "Specifies the page opened when the user clicks the logo.";
        ds:propertyType "url";
        ds:optional "true";
        ds:defaultValue "First navigation item that links to a page";
        ds:constraints "Only internal application URLs are allowed."
    ], [
        a ds:Property;
        ds:name "is-open";
        ds:summary "Controls whether the primary navigation is expanded or collapsed.";
        ds:propertyType "boolean";
        ds:optional "true";
        ds:defaultValue "`true`"
    ], [
        a ds:Property;
        ds:name "footer-items";
        ds:summary "Defines which items are displayed in the primary navigation footer.";
        ds:propertyType "list of text";
        ds:optional "false";
        ds:constraints "If no items are selected, the footer is hidden."
    ], [
        a ds:Property;
        ds:name "title";
        ds:summary "Defines the title displayed at the top of the secondary navigation.";
        ds:propertyType "text";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "content";
        ds:summary "Defines the content of the primary or secondary navigation.";
        ds:propertyType "list of nodes";
        ds:optional "false";
        ds:constraints "Primary: accepts a context switcher and navigation item groups. Secondary: accepts navigation item groups only."
    ];
    ds:hasSubcomponent ds:apps.subcomponent.side_navigation-item, ds:apps.subcomponent.side_navigation-item_group, ds:apps.subcomponent.side_navigation-context_switcher, ds:apps.subcomponent.side_navigation-content.
