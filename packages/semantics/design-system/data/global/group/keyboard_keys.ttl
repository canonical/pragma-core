@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.group.keyboard_keys a ds:Group;
    ds:name "KeyboardKeys";
    ds:summary "KeyboardKeys groups two or more KeyboardKey components into a single inline unit with consistent spacing. Use it to represent multi-key shortcuts (e.g., Ctrl + C) or key sets (e.g., arrow keys) as a visually cohesive group. It accepts arbitrary children, including separator text, alongside KeyboardKey instances.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global\n# src/lib/group/KeyboardKeys/styles.css on .ds.keyboard-keys.\nnode:\n  uri: global.group.keyboard_keys\n  styles:\n    layout.type: inline-flex\n    layout.align: center\n    # The two sizes are distinct and neither matches a spacing role in every\n    # context, so each key binds the dimension the CSS reads.\n    spacing.gap: dimension.025                      # --keyboard-keys-gap, 2px between adjacent keys in a chord\n    spacing.external.inline.start: dimension.050    # --keyboard-keys-margin-inline\n    spacing.external.inline.end: dimension.050      # --keyboard-keys-margin-inline\n  edges:\n    - node:\n        uri: global.component.keyboard_key\n      relation:\n        cardinality: \"2..*\"     # a chord needs at least two keys\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "KeyboardKeys are used to present multiple keys as a single conceptual unit, like a shortcut or a related key group.\n\n\n\n**When to use**\n\n- To compose modifier and actions keys with a “+” separator between them, e.g. Ctrl + C\n- Group keys that belong together, such as the four arrow keys, without separators.\n\n\n\n**When not to use**\n\n- When showing only one key, the grouping wrapper adds no value\n- When grouped items are not keyboard keys";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdocumentation;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.group.keyboard_keys;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.025
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.group.keyboard_keys;
        ds:node "$root";
        anatomy:styleKey "spacing.external.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.050
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.group.keyboard_keys;
        ds:node "$root";
        anatomy:styleKey "spacing.external.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.050
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.050
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.050
    ].
