@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.date_field a ds:Component;
    ds:name "DateField";
    ds:summary "A form control for collecting a single calendar date from the user, such as a start day, deadline, or date of birth. It frames the entry with a label, optional guidance, and validation, lets the user pick a day from a calendar metaphor, and can confine the selection to an allowed range of dates.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# The field is the Wrapper's chrome: a subgrid whose label row sits above a\n# payload row carrying the description, the control and any error. The control\n# is date input — src/lib/subcomponent/DateInput/styles.css on `.ds.input.date` — and its own styles\n# live in its own anatomy, not copied here.\nnode:\n  uri: global.component.date_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns, the component-local track placement a caller\n    # overrides to put the field in part of the form grid.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # The block gap from the label row down to the payload row reads\n    # --form-field-label-gap, which resolves through --space-100 to\n    # --dimension-100; this is the spacing semantic that resolves to it. When a\n    # description LEADS the payload the gap tightens to\n    # --form-field-label-description-gap (--dimension-050), for which no\n    # spacing semantic resolves, so that conditional is not carried.\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          # reads --form-label-columns.\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          # reads --form-payload-columns.\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              uri: global.subcomponent.date_input\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "A labelled calendar-date entry within a form.\n\n### When to use\n- Collecting one specific calendar day (start date, deadline, date of birth, appointment day).\n- The date is an absolute point that benefits from a calendar metaphor rather than free typing.\n- The allowable dates form a continuous range that can be bounded by an earliest and latest day.\n\n### When not to use\n- A time of day with no calendar day attached — use **Time**.\n- A calendar day together with a time of day — use **DateTime**.\n- A day drawn from a small, named set rather than the open calendar — use **Select** or **Choices**.\n- A span between two days rather than a single point — use a date-range field.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.date_field;
        ds:node "$root";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.regular
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/required marker";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/optional hint";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.date_field;
        ds:node "$root/payload";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-description;
        ds:node "$root";
        anatomy:styleKey "typography.color";
