@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.file_upload_field a ds:Component;
    ds:name "FileUploadField";
    ds:summary "A form field for attaching one or more files. It wraps the upload control in the standard field frame: a label, a helper text with the file limits, the control itself, and a validation message when a file is rejected. It is the component to use when a form needs a file from the user.";
    ds:anatomyDsl "Initial Anatomy DSL\n\n```yaml\n---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# The field is the Wrapper's chrome: a subgrid whose label row sits above a\n# payload row carrying the description, the control and any error. The control\n# is file upload input — src/lib/subcomponent/FileUploadInput/styles.css on `.ds.input.file-upload` — and its own styles\n# live in its own anatomy, not copied here.\nnode:\n  uri: global.component.file_upload_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns, the component-local track placement a caller\n    # overrides to put the field in part of the form grid.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # The block gap from the label row down to the payload row reads\n    # --form-field-label-gap, which resolves through --space-100 to\n    # --dimension-100; this is the spacing semantic that resolves to it. When a\n    # description LEADS the payload the gap tightens to\n    # --form-field-label-description-gap (--dimension-050), for which no\n    # spacing semantic resolves, so that conditional is not carried.\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          # reads --form-label-columns.\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          # reads --form-payload-columns.\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              uri: global.subcomponent.file_upload_input\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"\n```\n\nRegenerated Anatomy DSL\n\n```yaml\n---\n# The field frames the file upload input with a label, an optional description\n# and a field-level error. The input's own parts live in its own anatomy.\nnode:\n  uri: global.component.file_upload_field\n  styles:\n    layout.type: flex\n    layout.direction: column\n    # 16px between the text wrapper and the input; no spacing semantic resolves\n    # to it, so the dimension is bound directly.\n    spacing.gap.block: dimension.200\n  edges:\n    - node:\n        # Groups the label with its description so the pair sits closer\n        # together than the rest of the field.\n        role: text wrapper\n        styles:\n          layout.type: flex\n          layout.direction: column\n          spacing.gap.block: dimension.050\n        edges:\n          - node:\n              uri: global.subcomponent.field-label\n              styles:\n                # The disabled state belongs to the field; the label dims with it.\n                typography.color@disabled: color.text.disabled\n            relation:\n              cardinality: \"1\"\n              slotName: label\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                typography.color@disabled: color.text.muted.disabled\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n      relation:\n        cardinality: \"1\"\n    - node:\n        uri: global.subcomponent.file_upload_input\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        uri: global.subcomponent.field-error\n      relation:\n        cardinality: \"0..1\"\n        slotName: error\n```";
    ds:anatomyClassic "";
    ds:usage "A form field for attaching one or more files. It combines a label, helper text with the file limits, the upload control and validation messages.\n\n## **When to use**\n\n- Users need to attach one or more files as part of a form submission.\n- Users should see the files they've added, follow their upload progress, and remove or retry a file before submitting.\n\n## **When not to use**\n\n- The value is a short, free-form entry: use **TextField**.\n- The value is a link or reference to a file hosted elsewhere, not the file itself: use **TextField** and ask for the URL.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdesign.
