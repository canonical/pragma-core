@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.file_upload_field a ds:Component;
    ds:name "FileUploadField";
    ds:summary "A form field for attaching one or more files. It wraps the upload control ([FileUploadInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-ueHBQBbs9M)) in the standard field frame: a label, a description with the file limits, and the control itself, which shows the validation messages when a file is rejected. It is the component to use when a form needs a file from the user.";
    ds:anatomyDsl "---\n# The field frames the file upload input with a label and an optional\n# description. The input's own parts, including the field-level validation\n# message, live in its own anatomy.\nnode:\n  uri: global.component.file_upload_field\n  styles:\n    layout.type: flex\n    layout.direction: column\n    # 16px between the text wrapper and the input; no spacing semantic resolves\n    # to it, so the dimension is bound directly.\n    spacing.gap.block: dimension.200\n  edges:\n    - node:\n        # Groups the label with its description so the pair sits closer\n        # together than the rest of the field.\n        role: text wrapper\n        styles:\n          layout.type: flex\n          layout.direction: column\n          spacing.gap.block: dimension.050\n        edges:\n          - node:\n              uri: global.subcomponent.field-label\n              styles:\n                # The disabled state belongs to the field; the label dims with it.\n                typography.color@disabled: color.text.disabled\n            relation:\n              cardinality: \"1\"\n              slotName: label\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                typography.color@disabled: color.text.muted.disabled\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n      relation:\n        cardinality: \"1\"\n    - node:\n        uri: global.subcomponent.file_upload_input\n      relation:\n        cardinality: \"1\"\n        slotName: default";
    ds:anatomyClassic "**Anatomy**\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=13355-8568&t=cEAarkbWU6qDCTl8-1\n\n**Styling / Layout and spacing**\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=13355-8580&t=cEAarkbWU6qDCTl8-1\n\n**Styling / Colors**\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=13355-8590&t=cEAarkbWU6qDCTl8-1\n\n**Styling / Typography**\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=13355-8608&t=cEAarkbWU6qDCTl8-1\n\n**Styling / Overflow**\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=13355-8615&t=cEAarkbWU6qDCTl8-1";
    ds:usage "A form field for attaching one or more files. It combines a label, a description with the file limits, and the upload control, which shows the validation messages.\n\n## **When to use**\n\n- Users need to attach one or more files as part of a form submission.\n- Users should see the files they've added, and remove or retry a file before submitting.\n\n## **When not to use**\n\n- The value is a short, free-form entry – use [TextField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-QAuX4qtecx).\n- The value is a link or reference to a file hosted elsewhere, not the file itself – use [TextField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-QAuX4qtecx) and ask for the URL.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.designin-progress;
    ds:changeLog [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-11-22T17:00:00.000+01:00";
        ds:changeType "change"
    ], [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-11-25T13:00:00.000+01:00";
        ds:changeType "decision"
    ];
