@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.rich_choices_field a ds:Component;
    ds:name "RichChoicesField";
    ds:summary "A form control for selecting one or several options from a set whose choices can carry rich labels (text, icon, or richer content). It frames the set with a label, optional guidance, and validation, and supports either single-choice or multiple-choice selection.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# and src/lib/component/RichChoicesField/styles.css on .ds.form-rich-choices\n# The field chrome is the shared Wrapper's; the payload holds a grid of\n# options. In a rich option the native input is visually hidden and the LABEL\n# is the visible card surface, so the input chrome — border, radius,\n# background, and the hover / focus / selected / disabled recolours — sits on\n# the label rather than on the control. The previous notation's `role: control`\n# is kept as the hidden input it is.\nnode:\n  uri: global.component.rich_choices_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # reads --form-field-label-gap (--space-100 -> --dimension-100).\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              role: rich choices group\n              styles:\n                layout.type: grid\n                layout.grid.columns: subgrid\n                layout.grid.column: \"1 / -1\"\n                appearance.border.style: none\n                spacing.internal.block.start: 0\n                spacing.internal.block.end: 0\n                spacing.internal.inline.start: 0\n                spacing.internal.inline.end: 0\n                spacing.external.block.start: 0\n                spacing.external.block.end: 0\n                spacing.external.inline.start: 0\n                spacing.external.inline.end: 0\n                # reads --form-group-gap (--dimension-100).\n                spacing.gap.block: spacing.gap.field.block\n              edges:\n                - node:\n                    role: option\n                    styles:\n                      layout.position: relative\n                      layout.type: flex\n                      # reads --rich-choices-span, a component-local track span.\n                      layout.grid.column: auto\n                    edges:\n                      - node:\n                          role: control\n                          styles:\n                            # Visually hidden: the label is the control's\n                            # visible surface.\n                            layout.position: absolute\n                            size.width: 1px\n                            size.height: 1px\n                            layout.overflow: hidden\n                            typography.whiteSpace: nowrap\n                            appearance.border.width: 0\n                        relation:\n                          cardinality: \"1\"\n                      - node:\n                          role: rich label\n                          styles:\n                            layout.type: flex\n                            layout.direction: column\n                            layout.flex.grow: 1\n                            layout.boxSizing: border-box\n                            # reads --form-group-gap (--dimension-100).\n                            spacing.gap.block: spacing.gap.field.block\n                            appearance.border.width: dimension.stroke.thickness.medium\n                            appearance.border.style: solid\n                            appearance.border.color: color.border\n                            appearance.radius: dimension.radius.small\n                            appearance.background: color.foreground.input\n                            typography.color: color.text\n                            interaction.cursor: pointer\n                            interaction.select: none\n                            # reads --hover--color-foreground-input first, a\n                            # computed state variable no symbol declares.\n                            appearance.background@hover: color.foreground.input.hover\n                            appearance.background@selected: color.foreground.input.hover\n                            appearance.border.color@focus: color.focusRing\n                            appearance.border.color@selected: color.focusRing\n                            # A disabled option shows no border by design.\n                            appearance.border.color@disabled: transparent\n                            appearance.background@disabled: color.foreground.input.disabled\n                            interaction.cursor@disabled: not-allowed\n                            # The disabled text colour reads\n                            # --disabled--color-text, a computed state variable\n                            # no symbol declares and with no literal fallback,\n                            # so that binding is dropped.\n                            motion.property: \"border-color, background-color, box-shadow\"\n                            # The card's own inline padding reads\n                            # --form-input-padding-inline (16px) and its block\n                            # padding --form-input-padding-block (8px), both\n                            # through --dimension-* symbols.\n                            spacing.internal.inline.start: dimension.200\n                            spacing.internal.inline.end: dimension.200\n                            spacing.internal.block.start: dimension.100\n                            spacing.internal.block.end: dimension.100\n                            # The focus and selected rings are box-shadows,\n                            # which the roster has no key for.\n                        relation:\n                          cardinality: \"1\"\n                          slotName: default\n                  relation:\n                    cardinality: \"2..*\"\n                    slotName: default\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "A labelled set of selectable options, single- or multiple-choice, with richly-labelled choices.\n\n\n\n### When to use\n\n- Choosing one or several options from a small, visible set where the choices benefit from rich labels.\n\n\n\n### When not to use\n\n- A long list better searched than scanned — use [ComboboxField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-kfEQ25cX4a) .\n\n- A single binary decision — use [CheckboxField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-vwBCoHgXoG) .\n\n- Text-only options where layout control matters more than rich labels — use [ChoicesField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-IFk-NNRL3C) .";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.regular
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/required marker";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/optional hint";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-description;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "selected";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "selected";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "spacing.internal.block.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.rich_choices_field;
        ds:node "$root/payload/rich choices group/option/rich label";
        anatomy:styleKey "spacing.internal.block.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text.error
    ].
