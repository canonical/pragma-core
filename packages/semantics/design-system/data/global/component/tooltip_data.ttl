@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.tooltip_data a ds:Component;
    ds:name "TooltipData";
    ds:summary "The data tooltip is a tooltip designed specifically for data visualisation. Its primary purpose is to reveal values when users interact with charts, graphs, maps, or other data-driven elements.  It is used for displaying metrics on hover, clarifying data points that cannot be fully shown in the visual itself. \n\nThis variant helps users interpret information accurately without cluttering the interface with labels that are always visible.\n\nRelated to [Tooltip](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-ONb9LwkGvW) and [TooltipWrapper](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-69TNyYt7M9).";
    ds:anatomyDsl "---\nnode:\n  uri: global.component.data_tooltip\n  edges:\n    - node:\n        role: surface\n        styles:\n          appearance.background: color.background\n          appearance.border.color: color.border.muted\n          appearance.border.style: solid\n          appearance.border.width: dimension.stroke.thickness.medium\n          layout.type: flex\n          layout.direction: column\n          layout.align: start\n          spacing.internal.block.start: dimension.100\n          spacing.internal.block.end: dimension.100\n          spacing.internal.inline.start: dimension.100\n          spacing.internal.inline.end: dimension.100\n        edges:\n          # No block names the heading, so it is an anonymous node.\n          - node:\n              role: heading\n              styles:\n                typography.font: typography.text.secondary.bold\n            relation:\n              cardinality: \"0..1\"\n              slotName: heading\n          - node:\n              uri: global.subcomponent.chart_legend\n            relation:\n              cardinality: \"1\"\n              slotName: default\n      relation:\n        cardinality: \"1\"\n        slotName: default";
    ds:anatomyClassic "## Anatomy\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=13993-2770&t=pA5l7Omuxa3ATwVS-1\n\n1. **Container**\n\nSurface that follows the pointer. No arrow.\n\n1. **Chart legend**\n\nDisplays the data label and value. One row per series: marker, label and value. Add or remove rows in the Items slot.\n\n1. **Heading (optional)**\n\nTitles the legend.\n\n## Styling\n\n";
    ds:usage "## When to use\n\n- When inspecting individual data points in charts or visualisations\n- When users move quickly between adjacent data points\n- When content is structured as short label–value pairs (e.g. “OS: Ubuntu 24.04”, “CPU usage: 72%”), optionally with colour indicators to match visual elements such as charts\n\n## When not to use\n\n- When used outside of data visualisation contexts\n  - Incorrect: A data tooltip is used to explain a form field\n  - Remediation: Use a [Standard tooltip](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20chnVyhaz/_rui-Y9PpN4FiwA)\n- When explaining UI controls or icons\n  - Incorrect: A data tooltip is attached to a settings icon\n  - Remediation: Use a [Standard tooltip](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20chnVyhaz/_rui-Y9PpN4FiwA) \n- When information must persist beyond hover\n  - Incorrect: A data tooltip contains important information users must reference continuously\n  - Remediation: Use a persistent component such as [Popover](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-i-62pvfoOF) or inline content\n- When the element is already clearly labelled or self-explanatory.\n\n**In essence:**\n\nWhen in doubt, start with standard [Tooltip](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-ONb9LwkGvW). Move to its [Tooltip+Dense](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-PFE_wK_bWT) variant for space constraints; [TooltipWrapper](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-69TNyYt7M9) for structured content and complex hierarchies; [TooltipData](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Y1ha3zI_b_) for data visualization.";
    ds:guidelines "### Animation\n\n- Show with a 400 ms delay after hover or focus\n- Hide with a 400 ms delay after the pointer leaves\n- Cancel display if the pointer exits before the show delay completes\n- If the pointer moves directly from one tooltip trigger to another, show the new tooltip immediately and skip the previous tooltip’s exit animation\n\n### Transition\n\n- **Type**: spring\n- **Duration**: 0.4 s\n- **Bounce**: 0.2\n- **Delay**: 0 s\n\n### Specific for data tooltip:\n\n- Cursor-follow behaviour; follows the cursor while open.\n- Cursor-follow placement direction: **Right**\n- Horizontal offset from cursor: **16 px**\n- Vertical offset from cursor: **8 px**\n\n### Motion feel\n\n- Preset: **Snappy**\n- Bounce profile: **No-bounce**\n- Spring: stiffness **500**, damping **60**, mass **1**, no overshoot\n\n### Reduced motion\n\n- Snaps to the pointer position instead of easing. Same 400 ms open and close delays.\n\n### CSS fallback\n\n- Cursor-follow: 140 to 180 ms, cubic-bezier(0.16, 1, 0.3, 1), no overshoot.\n- Enter and exit: opacity 0 to 1 and scale 0.96 to 1 over 400 ms, cubic-bezier(0.22, 1, 0.36, 1).\n\n### Hovered series\n\n- The series under the pointer shows as highlighted in the legend (bold label and value), so it's clear which row the pointer refers to. Other rows stay in the default state.\n\n### Interactions and accessibility\n\n- Only one tooltip is open at a time. It contains no interactive content and never takes focus.\n- Escape closes it.\n- The tooltip element has role=\"tooltip\". Data shown only on hover should also be available another way, for example a data table, for keyboard, screen reader and touch users.\n- Values use tabular figures in code.";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsfulldocumentation;
    ds:hasProperty [
        a ds:Property;
        ds:name "***Data tooltip***";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "Show header";
        ds:summary "Shows legend header";
        ds:optional "true";
        ds:propertyType "boolean"
    ], [
        a ds:Property;
        ds:name "Indicator";
        ds:summary "Shows colour marker matching chart encoding";
        ds:optional "true";
        ds:propertyType "boolean"
    ], [
        a ds:Property;
        ds:name "Show cursor";
        ds:summary "Tooltip follows cursor instead of anchoring to trigger";
        ds:optional "false";
        ds:propertyType "boolean"
    ], [
        a ds:Property;
        ds:name "*Cursor animation* *(framer)*";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "cursorFollow.position";
        ds:summary "Cursor-follow placement direction";
        ds:optional "false";
        ds:propertyType "choice"
    ], [
        a ds:Property;
        ds:name "cursorFollow.offsetX";
        ds:summary "Horizontal offset from cursor";
        ds:optional "false";
        ds:propertyType "number"
    ], [
        a ds:Property;
        ds:name "cursorFollow.offsetY";
        ds:summary "Vertical offset from cursor";
        ds:optional "false";
        ds:propertyType "number"
    ], [
        a ds:Property;
        ds:name "Motion feel";
        ds:summary "High-level motion tuning preset";
        ds:optional "true";
        ds:propertyType "choice"
    ], [
        a ds:Property;
        ds:name "***All variants***";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "Type";
        ds:summary "Selects the tooltip variant";
        ds:optional "false";
        ds:propertyType "choice"
    ], [
        a ds:Property;
        ds:name "Surrounding UI theme";
        ds:summary "Sets tooltip theme based on surrounding UI context";
        ds:optional "false";
        ds:propertyType "choice"
    ];
    ds:hasSubcomponent ds:global.subcomponent.chart_legend, ds:global.subcomponent.chart_legend_item;
    ds:inheritsFrom ds:global.component.tooltip;
    ds:changeLog [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-04-22T00:00:00.000+02:00"
    ];
    ds:hasTokenBinding [
