@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.checkbox_field a ds:Component;
    ds:name "CheckboxField";
    ds:summary "A form control for a single yes/no decision, pairing a binary choice with its label, optional guidance, and validation. Use it when a user must accept, enable, or opt in to one independent thing as part of a form.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/ToggleWrapper.css on .ds.field.field-toggle\n# The toggle field chrome, top to bottom: an optional heading, a control row\n# where the control sits inline with its own label, then the description and\n# any error. Spacing belongs to the FIELD — the row's column gap separates\n# control from label, the field's row gap separates the row from the\n# description and error — so neither label nor control carries padding or\n# margin. The control is checkbox input (src/lib/subcomponent/CheckboxInput/styles.css on `.ds.form-checkbox`)\n# and its own styles live in its own anatomy, not copied here. The label\n# follows the control by default.\nnode:\n  uri: global.component.checkbox_field\n  styles:\n    layout.type: flex\n    layout.direction: column\n    # reads --form-group-gap, which resolves through --space-100 to\n    # --dimension-100; this is the spacing semantic that resolves to it.\n    spacing.gap.block: spacing.gap.field.block\n    # From the shared .ds.field rule, which the toggle variant does not\n    # override: reads --form-field-columns.\n    layout.grid.column: \"1 / -1\"\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          # The heading is a mock label (a <legend>); the fieldset default is\n          # reset so it flows like the other block children.\n          spacing.internal.block.start: 0\n          spacing.internal.block.end: 0\n          spacing.internal.inline.start: 0\n          spacing.internal.inline.end: 0\n      relation:\n        cardinality: \"0..1\"\n        slotName: heading\n    - node:\n        role: control row\n        styles:\n          layout.type: flex\n          layout.direction: row\n          layout.align: center\n          # --form-field-inline-gap resolves through --container-gap-default and\n          # --space-200 to --dimension-200 (16px).\n          spacing.gap.inline: dimension.200\n        edges:\n          - node:\n              uri: global.subcomponent.checkbox_input\n              styles:\n                # The control is a fixed 16px box (--dimension-200); the row's\n                # centring does the alignment, so it carries no offset.\n                size.inline: dimension.200\n                size.block: dimension.200\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-label\n              styles:\n                # Often a full clickable sentence, so it reads as regular body\n                # prose rather than the field label's heading weight, and it\n                # takes the remaining width so it wraps beside the control.\n                layout.flex.grow: 1\n                size.min.width: 0\n                typography.weight: typography.weight.regular\n                typography.align: start\n                interaction.cursor: pointer\n                spacing.internal.block.start: 0\n                spacing.internal.block.end: 0\n                spacing.internal.inline.start: 0\n                spacing.internal.inline.end: 0\n                # A disabled control makes the row stop signalling clickable\n                # and turns the label to the disabled text token; the\n                # reference reads --form-label-color-disabled first, which no\n                # symbol declares.\n                typography.color@disabled: color.text.disabled\n                interaction.cursor@disabled: not-allowed\n            relation:\n              cardinality: \"1\"\n              slotName: label\n      relation:\n        cardinality: \"1\"\n    - node:\n        uri: global.subcomponent.field-description\n      relation:\n        cardinality: \"0..1\"\n        slotName: description\n    - node:\n        uri: global.subcomponent.field-error\n      relation:\n        cardinality: \"0..1\"\n        slotName: error";
    ds:anatomyClassic "";
    ds:usage "A labelled binary choice within a form.\n\n\n\n### When to use\n\n- A single opt-in or acceptance (e.g. agree to terms).\n\n- Toggling one independent option whose value is committed with the form.\n\n\n\n### When not to use\n\n- Several related, mutually-exclusive options — use [RichChoicesField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-OE7Ygmz_vT)  or [ChoicesField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-IFk-NNRL3C) .\n\n- A setting that takes effect immediately on toggle — use [SwitchField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-vZovGhu5_P) .";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
