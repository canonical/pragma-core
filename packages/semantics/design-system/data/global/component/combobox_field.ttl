@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.combobox_field a ds:Component;
    ds:name "ComboboxField";
    ds:summary "A form control for choosing one or several values from a large set by typing to filter, then selecting from the narrowed list. It frames the entry with a label, optional guidance, and validation, and suits sets too long to scan comfortably.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# The field is the Wrapper's chrome: a subgrid whose label row sits above a\n# payload row carrying the description, the control and any error. The control\n# is combobox input — src/lib/subcomponent/ComboboxInput/styles.css on `.ds.form-combobox` — and its own styles\n# live in its own anatomy, not copied here.\nnode:\n  uri: global.component.combobox_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns, the component-local track placement a caller\n    # overrides to put the field in part of the form grid.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # The block gap from the label row down to the payload row reads\n    # --form-field-label-gap, which resolves through --space-100 to\n    # --dimension-100; this is the spacing semantic that resolves to it. When a\n    # description LEADS the payload the gap tightens to\n    # --form-field-label-description-gap (--dimension-050), for which no\n    # spacing semantic resolves, so that conditional is not carried.\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          # reads --form-label-columns.\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          # reads --form-payload-columns.\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              uri: global.subcomponent.combobox_input\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "Lets the user pick one or more values from a long set, narrowing the visible options by typing to filter.\n\n### When to use\n- The set of options is large enough that scanning all of them at once is impractical.\n- Filtering as the user types meaningfully speeds up finding the intended value.\n- Either a single selection or multiple selections from the same long set is needed.\n\n### When not to use\n- The set is short and can be shown in full — use **Choices**, **SimpleChoices**, or **Select**.\n- The value is open-ended and not drawn from a predefined set — use **Text**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
