@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.time_field a ds:Component;
    ds:name "TimeField";
    ds:summary "A form control for collecting a time of day from the user, such as an appointment slot, opening hour, or reminder time. It frames the entry with a label, optional guidance, and validation, lets the user set a time using a clock metaphor, and can confine the selection to an allowed range and to set increments.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# The field is the Wrapper's chrome: a subgrid whose label row sits above a\n# payload row carrying the description, the control and any error. The control\n# is time input — src/lib/subcomponent/TimeInput/styles.css on `.ds.input.time` — and its own styles\n# live in its own anatomy, not copied here.\nnode:\n  uri: global.component.time_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns, the component-local track placement a caller\n    # overrides to put the field in part of the form grid.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # The block gap from the label row down to the payload row reads\n    # --form-field-label-gap, which resolves through --space-100 to\n    # --dimension-100; this is the spacing semantic that resolves to it. When a\n    # description LEADS the payload the gap tightens to\n    # --form-field-label-description-gap (--dimension-050), for which no\n    # spacing semantic resolves, so that conditional is not carried.\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          # reads --form-label-columns.\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          # reads --form-payload-columns.\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              uri: global.subcomponent.time_input\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "A labelled time-of-day entry within a form.\n\n\n\n### When to use\n\n- Collecting one specific time of day (appointment slot, opening hour, reminder time).\n\n- The time is an absolute point in the day that benefits from a clock metaphor rather than free typing.\n\n- The allowable times form a continuous range that can be bounded by an earliest and latest time, optionally snapped to set increments.\n\n\n\n### When not to use\n\n- A calendar day with no time attached — use [DateField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Btd18SrL7F) .\n\n- A calendar day together with a time of day — use [DateTimeField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-iMMaj5QewN) .\n\n- A time drawn from a small, named set rather than the open clock — use [SelectField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-u5dH7O-tHI)  or [RichChoicesField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-OE7Ygmz_vT) .\n\n- A length of time rather than a point in the day — use a duration field.\n\n";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.time_field;
        ds:node "$root";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.regular
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/required marker";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/optional hint";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.time_field;
        ds:node "$root/payload";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-description;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "invalid";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.error
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.time_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text.error
    ].
