@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.range_field a ds:Component;
    ds:name "RangeField";
    ds:summary "A form control for choosing a number within a fixed minimum and maximum by sliding, with the current value shown as it changes. It frames the choice with a label and optional guidance and suits approximate selection within a bounded scale.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# and src/lib/component/RangeField/common/RangeControl/styles.css on .ds.range-control\n# The field chrome is the shared Wrapper's; the payload holds a control row of\n# two controls for one value. The CANONICAL control is the number input — it\n# carries the field name and id and is the target of the real <label for> — and\n# the slider is a mirror appended on hydration. The number input stays FIRST in\n# the DOM and is moved to the inline end with `order`, so it follows the\n# writing direction. Each control's own styles live in its own anatomy.\nnode:\n  uri: global.component.range_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # reads --form-field-label-gap (--space-100 -> --dimension-100).\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              role: range control row\n              styles:\n                layout.type: flex\n                layout.direction: row\n                layout.align: center\n                layout.grid.column: \"1 / -1\"\n                # reads --form-group-gap (--dimension-100) as the inline gap\n                # between the slider and the number input.\n                spacing.gap: spacing.gap.field.block\n              edges:\n                - node:\n                    uri: global.subcomponent.number_input\n                    styles:\n                      # Ordered last so it paints at the inline end, at a\n                      # fixed non-flexing width; reads\n                      # --form-range-number-width, a component-local size\n                      # whose chain ends in its own 5rem literal.\n                      layout.order: 1\n                      layout.flex.grow: 0\n                      layout.flex.shrink: 0\n                      layout.flex.basis: 5rem\n                      size.width: 5rem\n                  relation:\n                    cardinality: \"1\"\n                    slotName: default\n                - node:\n                    uri: global.subcomponent.range_input\n                    styles:\n                      # The slider flexes to fill whatever the number input\n                      # leaves.\n                      layout.flex.grow: 1\n                      layout.flex.shrink: 1\n                      layout.flex.basis: auto\n                      size.min.width: 0\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: slider\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "https://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=3749-4947&t=yaXCR1Fr1yOsAxs6-1";
    ds:usage "A labelled control for choosing a number within a fixed minimum and maximum by sliding.\n\n\n\n### When to use\n\n- An approximate number is chosen within a known, bounded scale, with the current value shown as it changes.\n\n- Sliding along a continuous track communicates the choice more naturally than typing an exact figure.\n\n\n\n### When not to use\n\n- A precise or open-ended number is required rather than an approximate one within bounds — use [TextInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-csRvI-VTpO) .";
    ds:guidelines "## Accessibility (draft)  \n\n\nHow to ensure accessibility requirements are met:\n\n1. Group the slider and the input into a fieldset.\n2. Add a legend to the fieldset.\n3. Programatically: keep the `<label>`s; or use the `title` attribute to replace the `<label>`.\n4. Visually: hide the labels .\n5. Visually: make sure the slider and the input are clearly a group associated with the legend.  \nSee spec: [https://docs.google.com/document/d/19k-5YOuQc6B82mYPEwvmlJpui3Oex4o8ACwKBbo-d44/edit?tab=t.0](https://docs.google.com/document/d/19k-5YOuQc6B82mYPEwvmlJpui3Oex4o8ACwKBbo-d44/edit?tab=t.0)\n\n*Future work: revisit the styling in the future so that it's clearly a group*\n\n";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.range_field;
        ds:node "$root";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.regular
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/required marker";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/optional hint";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.range_field;
        ds:node "$root/payload";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-description;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.range_field;
        ds:node "$root/payload/range control row";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.track
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.track.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "size.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.progress
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.progress.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/value readout";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text.error
    ].
