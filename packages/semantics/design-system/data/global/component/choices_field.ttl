@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.choices_field a ds:Component;
    ds:name "ChoicesField";
    ds:summary "A form control for selecting one or several options from a set of text-labelled choices, with control over whether the options sit inline or stacked. It frames the set with a label, optional guidance, and validation.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/styles.css on .ds.field\n# and src/lib/component/ChoicesField/styles.css on .ds.form-choices\n# The field chrome is the shared Wrapper's; the payload holds one fieldset of\n# options, each a control beside its own label. The control is a radio or a\n# checkbox depending on the `type` prop — a genuine prop switch — and each\n# control's own styles live in its own anatomy. The three layouts the fieldset\n# offers (inline wrapping by default, `.stacked` one per line, `.columns` a\n# grid of --choices-columns equal columns) change layout only, never the tree,\n# so the default is what is bound here.\nnode:\n  uri: global.component.choices_field\n  styles:\n    layout.type: grid\n    layout.grid.columns: subgrid\n    # reads --form-field-columns.\n    layout.grid.column: \"1 / -1\"\n    layout.align: baseline\n    # reads --form-field-label-gap (--space-100 -> --dimension-100).\n    spacing.gap.block: spacing.gap.field.block\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          layout.grid.column: \"1 / -1\"\n      relation:\n        cardinality: \"1\"\n        slotName: label\n    - node:\n        role: payload\n        styles:\n          layout.type: grid\n          layout.grid.columns: subgrid\n          layout.grid.column: \"1 / -1\"\n          # reads --form-group-gap (--space-100 -> --dimension-100).\n          spacing.gap.block: spacing.gap.field.block\n        edges:\n          - node:\n              uri: global.subcomponent.field-description\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: description\n          - node:\n              role: choices group\n              styles:\n                layout.type: flex\n                layout.wrap: wrap\n                layout.grid.column: \"1 / -1\"\n                appearance.border.style: none\n                spacing.internal.block.start: 0\n                spacing.internal.block.end: 0\n                spacing.external.block.start: 0\n                spacing.external.block.end: 0\n                spacing.external.inline.start: 0\n                spacing.external.inline.end: 0\n                # The fieldset's own inline padding reads\n                # --form-input-padding-inline (--component-padding-inline ->\n                # --space-200 -> --dimension-200, 16px).\n                spacing.internal.inline.start: dimension.200\n                spacing.internal.inline.end: dimension.200\n                # The row gap between wrapped options reads --form-group-gap,\n                # the block gap between fields; the column gap reads\n                # --container-gap-loose (--space-300 -> --dimension-300, 24px),\n                # which no spacing role states.\n                spacing.gap.block: spacing.gap.field.block\n                spacing.gap.inline: dimension.300\n              edges:\n                - node:\n                    role: option\n                    styles:\n                      layout.type: flex\n                      layout.align: center\n                      # reads --space-100 (-> --dimension-100): the gap between\n                      # the mark and its label.\n                      spacing.gap: spacing.gap.mark.inline\n                      interaction.cursor: pointer\n                      interaction.cursor@disabled: not-allowed\n                    edges:\n                      - switch:\n                          on: props\n                          cases:\n                            - uri: global.subcomponent.radio_input\n                            - uri: global.subcomponent.checkbox_input\n                        relation:\n                          cardinality: \"1\"\n                          slotName: default\n                      - node:\n                          role: option label\n                          styles:\n                            spacing.internal.block.start: 0\n                            spacing.internal.block.end: 0\n                            spacing.internal.inline.start: 0\n                            spacing.internal.inline.end: 0\n                            # The reference reads\n                            # --form-label-color-disabled first, which no\n                            # symbol declares.\n                            typography.color@disabled: color.text.disabled\n                        relation:\n                          cardinality: \"1\"\n                          slotName: label\n                  relation:\n                    cardinality: \"2..*\"\n                    slotName: default\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-error\n              styles:\n                layout.grid.column: \"1 / -1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: error\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "Presents a small, fully visible set of options as text-only labels, where the arrangement (inline or stacked) carries meaning.\n\n\n\n### When to use\n\n- The full set of options is short enough to show at once without scrolling or filtering.\n\n- Each option is described well by a plain text label, with no supporting imagery or secondary detail.\n\n- The way options are laid out — side by side or stacked — is part of how the choice reads.\n\n\n\n### When not to use\n\n- Options need rich labels with supporting detail or imagery — use [RichChoicesField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-OE7Ygmz_vT) .\n\n- The list is long enough that filtering would help find an option — use [ComboboxField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-kfEQ25cX4a) \n\n- The choice is a single yes/no decision — use [CheckboxField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-vwBCoHgXoG) .";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
