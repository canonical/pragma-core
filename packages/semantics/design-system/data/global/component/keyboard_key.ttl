@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.keyboard_key a ds:Component;
    ds:name "KeyboardKey";
    ds:summary "The KeyboardKey component renders a single keyboard key as a styled kbd element. It maps a key identifier (letters, digits, modifiers, function keys, navigation keys, and action keys) to its display label and presents it as a compact, inline visual indicator. Use it to represent keyboard shortcuts, key bindings, or individual keys within instructional or reference content. It is non-interactive and purely informational.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global src/lib/component/KeyboardKey/styles.css on .ds.keyboard-key\n# The monospace typography tier (font-family, size, weight, line-height) comes\n# from the shared `.code` baseline utility and is deliberately NOT redeclared\n# by the component, so this anatomy binds none of it. The key establishes its\n# own `.surface`, so the colour reads are on the element and step with nesting.\nnode:\n  uri: global.component.keyboard_key\n  styles:\n    layout.type: inline-block\n    appearance.background: [surface.color.background, color.background]\n    typography.color: [surface.color.text, color.text]\n    appearance.border.style: solid\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.color: color.border.muted\n    # Figma asks for 2px; no 2px radius token exists, so the reference stays on\n    # radius-small (currently 0) and so does this.\n    appearance.radius: dimension.radius.small\n    spacing.internal.inline.start: dimension.050   # --keyboard-key-padding-inline\n    spacing.internal.inline.end: dimension.050     # --keyboard-key-padding-inline";
    ds:anatomyClassic "";
    ds:usage "When to use\n\n- Embed key representations in help articles, changelogs, or feature announcements to give consistent visual treatment to every key reference.\n\n\n\nWhen not to use\n\n- The content is not a keyboard key. Status labels, tags or category badges have their own components.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdocumentation;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.050
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.keyboard_key;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.050
    ].
