@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.tile a ds:Component;
    ds:name "Tile";
    ds:summary "The tile component is a flexible container for information or actions that are meant to be grouped together but do not repeat the same structure. It acts as a container that creates a clear boundary between different pieces of content, making complex layouts easier to scan and organize. It is often used for dashboards, “Bento box” layout, and rich media layouts.\n\nFor information that is broken down into pieces that all share the same structure and belongs in a series, use [Card](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Gm_-gu8fGD)s instead. \n\n";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global src/lib/component/Tile/styles.css on .ds.tile\n# The Tile always provides a surface — it adds `.surface`, so the channel is\n# established on this element and steps when tiles nest — and paints that\n# background so it stands out on the page. It shares the Card radius, has no\n# border of its own, and is a static container: no cursor, hover or focus\n# affordance, so the previous notation's `interaction.cursor: pointer` is\n# dropped as contradicted by the reference.\nnode:\n  uri: global.component.tile\n  styles:\n    layout.type: flex\n    layout.direction: column\n    appearance.background: [surface.color.background, color.background]\n    appearance.radius: dimension.radius.medium\n    # Clips section corners (full-bleed content) to the tile radius.\n    layout.overflow: hidden\n  edges:\n    - node:\n        uri: global.subcomponent.tile-header\n      relation:\n        cardinality: \"0..1\"\n        slotName: header\n    - node:\n        uri: global.subcomponent.tile-content\n      relation:\n        cardinality: \"1\"\n        slotName: default";
    ds:anatomyClassic "https://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=3141-13818&t=ZeOhPBVqjN81UglM-1\n\nStyling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=2146-3117&t=ch8BFFPUe9gCvMdg-1\n\n";
    ds:usage "The tile is a container designed to wrap unique or variable data sets. Tiles should be used to create clear visual separation without over-complicating the interface with too many layers.\n\n### When to use\n\n- When you have a collection of items that differ in their structure but logically fit together (i.e. a dashboard), use multiple tiles. \n- When one or more items (image, title, description, price) need to be artificially perceived as a unit.\n\n### When not to use\n\n- When you are presenting a simple document or long-form article that should flow naturally.\n  - Incorrect: Wrapping every paragraph of a blog post in its own individual tile or breaking up an article by changing the style of the presented data.\n  - Remediation: Use standard typography components and vertical spacing to separate paragraphs.\n- When a tile is placed inside another tile without a clear functional reason, creating \"nested box\" fatigue.\n  - Incorrect: A large tile containing a list of items where every single list item is also in its own tile.\n  - Remediation: Use a [List](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-fi4xttt9mh) or a [Table](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Olq5LYSopF)  inside the main tile to display the child items.\n- When the container is used solely to house a single item like a button or a link.\n  - Incorrect: Placing a single \"Submit\" button inside a tile with no other content.\n  - Remediation: Place the component directly on the page surface.\n- When the items you are displaying have the same properties.\n  - Incorrect: Using tiles to display all instances running.\n  - Remediation: Use the [Card](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Gm_-gu8fGD) components, which allow for more strict object mappings to content types.\n\n";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdocumentation;
    ds:hasProperty [
        a ds:Property;
        ds:name "children";
        ds:propertyType "element";
        ds:optional "false"
    ];
    ds:hasSubcomponent ds:global.subcomponent.tile-content, ds:global.subcomponent.tile-header;
    ds:changeLog [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-04-17T00:00:00.000+02:00";
        ds:change "comments have been addressed and documentation has been updated";
        ds:changeType "change"
    ], [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-04-17T00:00:00.000+02:00";
        ds:change "The tile can have an optional header.";
        ds:changeType "decision"
    ], [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-04-24T00:00:00.000+02:00";
        ds:change "updated the summary deflection ant the usage description";
        ds:changeType "change"
    ];
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.tile;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.tile;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.background
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.tile;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-header;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-header;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-header;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-header;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-header;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-content;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.tile-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ].
