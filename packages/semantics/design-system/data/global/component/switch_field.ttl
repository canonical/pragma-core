@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.switch_field a ds:Component;
    ds:name "SwitchField";
    ds:summary "A form control for a single on/off setting presented as a toggle, framed with a label and optional guidance. It expresses a binary state the user flips directly; in form use the value is committed with the form.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form src/lib/common/Wrapper/ToggleWrapper.css on .ds.field.field-toggle\n# The toggle field chrome, top to bottom: an optional heading, a control row\n# where the control sits inline with its own label, then the description and\n# any error. Spacing belongs to the FIELD — the row's column gap separates\n# control from label, the field's row gap separates the row from the\n# description and error — so neither label nor control carries padding or\n# margin. The control is switch input (src/lib/subcomponent/SwitchInput/styles.css on `.ds.form-switch`)\n# and its own styles live in its own anatomy, not copied here.\n# The label LEADS the control by default (labelPosition: \"before\" — a label\n# before a switch names its purpose), which the reference achieves with\n# row-reverse on the control row while the DOM stays control-then-label.\nnode:\n  uri: global.component.switch_field\n  styles:\n    layout.type: flex\n    layout.direction: column\n    # reads --form-group-gap, which resolves through --space-100 to\n    # --dimension-100; this is the spacing semantic that resolves to it.\n    spacing.gap.block: spacing.gap.field.block\n    # From the shared .ds.field rule, which the toggle variant does not\n    # override: reads --form-field-columns.\n    layout.grid.column: \"1 / -1\"\n  edges:\n    - node:\n        uri: global.subcomponent.field-label\n        styles:\n          # The heading is a mock label (a <legend>); the fieldset default is\n          # reset so it flows like the other block children.\n          spacing.internal.block.start: 0\n          spacing.internal.block.end: 0\n          spacing.internal.inline.start: 0\n          spacing.internal.inline.end: 0\n      relation:\n        cardinality: \"0..1\"\n        slotName: heading\n    - node:\n        role: control row\n        styles:\n          layout.type: flex\n          layout.direction: row\n          layout.align: center\n          # --form-field-inline-gap resolves through --container-gap-default and\n          # --space-200 to --dimension-200 (16px).\n          spacing.gap.inline: dimension.200\n        edges:\n          - node:\n              uri: global.subcomponent.switch_input\n              styles:\n                # The control is a fixed 16px box (--dimension-200); the row's\n                # centring does the alignment, so it carries no offset.\n                size.inline: dimension.200\n                size.block: dimension.200\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              uri: global.subcomponent.field-label\n              styles:\n                # Often a full clickable sentence, so it reads as regular body\n                # prose rather than the field label's heading weight, and it\n                # takes the remaining width so it wraps beside the control.\n                layout.flex.grow: 1\n                size.min.width: 0\n                typography.weight: typography.weight.regular\n                typography.align: start\n                interaction.cursor: pointer\n                spacing.internal.block.start: 0\n                spacing.internal.block.end: 0\n                spacing.internal.inline.start: 0\n                spacing.internal.inline.end: 0\n                # A disabled control makes the row stop signalling clickable\n                # and turns the label to the disabled text token; the\n                # reference reads --form-label-color-disabled first, which no\n                # symbol declares.\n                typography.color@disabled: color.text.disabled\n                interaction.cursor@disabled: not-allowed\n            relation:\n              cardinality: \"1\"\n              slotName: label\n      relation:\n        cardinality: \"1\"\n    - node:\n        uri: global.subcomponent.field-description\n      relation:\n        cardinality: \"0..1\"\n        slotName: description\n    - node:\n        uri: global.subcomponent.field-error\n      relation:\n        cardinality: \"0..1\"\n        slotName: error";
    ds:anatomyClassic "";
    ds:usage "Captures a single binary on/off setting where a toggle metaphor communicates the state more naturally than a checkmark.\n\n### When to use\n- The setting has exactly two states, on and off, with an immediate sense of being enabled or disabled.\n- A toggle reads more naturally than a tick, such as turning a feature or preference on or off.\n\n### When not to use\n- The user is agreeing to terms or opting in as part of submitting a form — use **Checkbox**.\n- The user must pick among several distinct options rather than flip one setting — use **Choices**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.switch_field;
        ds:node "$root";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.field.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.regular
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/required marker";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-label;
        ds:node "$root/optional hint";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.switch_field;
        ds:node "$root/control row";
        anatomy:styleKey "spacing.gap.inline";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.switch_field;
        ds:node "$root/control row/global.subcomponent.switch_input";
        anatomy:styleKey "size.inline";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.switch_field;
        ds:node "$root/control row/global.subcomponent.switch_input";
        anatomy:styleKey "size.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "size.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.400
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.full
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.unselected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "selected";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.selected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.unselected.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.full
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.foreground.switch.knob
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.foreground.switch.knob
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.knob.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.switch_field;
        ds:node "$root/control row/global.subcomponent.field-label";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.regular
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.switch_field;
        ds:node "$root/control row/global.subcomponent.field-label";
        anatomy:styleKey "typography.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-description;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.field-error;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text.error
    ].
