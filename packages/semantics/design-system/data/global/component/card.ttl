@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.component.card a ds:Component;
    ds:name "Card";
    ds:summary "The card is a container that is designed to represent data objects that share the same structure. Unlike the more flexible [Tile](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-eThhoLZg3Y), a card is designed to have multiple units displayed beside one another. Because of this, the card has a predictable structure that allows the user to compare attributes across data objects.\n\n";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global src/lib/component/Card/styles.css on .ds.card\n# The Card is not a surface: it sets no background, so it reads flush on\n# whatever surface it sits on and stays delimited by its border, its radius and\n# the dividers between its sections. It is always a grid participant and a ROW\n# SUBGRID over four fixed section tracks — image, header, content, footer.\nnode:\n  uri: global.component.card\n  styles:\n    layout.type: grid\n    layout.grid.rows: subgrid\n    layout.grid.columns: \"minmax(0, 1fr)\"\n    # Spans --card-span parent columns (a component-local count, default 1) and\n    # its own four section rows.\n    layout.grid.column: \"span 1\"\n    layout.grid.row: \"span 4\"\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    appearance.border.color: color.border.muted\n    appearance.radius: dimension.radius.medium\n    # Clips section corners (a full-bleed image) to the card radius.\n    layout.overflow: hidden\n  edges:\n    # Each section sits on its fixed row track and spans the card's single\n    # column. An absent section leaves its track empty for this card only.\n    # Image, content and footer draw a divider on their block-end edge when\n    # they are not the last section; the header draws none, so title and\n    # content read as one region.\n    - node:\n        uri: global.subcomponent.card-image\n        styles:\n          layout.grid.row: \"1\"\n          layout.grid.column: \"1 / -1\"\n          appearance.border.bottom.color: color.border.muted\n      relation:\n        cardinality: \"0..1\"\n        slotName: media\n    - node:\n        uri: global.subcomponent.card-header\n        styles:\n          layout.grid.row: \"2\"\n          layout.grid.column: \"1 / -1\"\n          # Collapsed to raw 0 when a content section follows, to close the\n          # header/content seam — unthemeable by design.\n          spacing.internal.block.end: 0\n      relation:\n        cardinality: \"0..1\"\n        slotName: header\n    - node:\n        uri: global.subcomponent.card-content\n        styles:\n          layout.grid.row: \"3\"\n          layout.grid.column: \"1 / -1\"\n          appearance.border.bottom.color: color.border.muted\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        uri: global.subcomponent.card-footer\n        styles:\n          layout.grid.row: \"4\"\n          layout.grid.column: \"1 / -1\"\n          appearance.border.bottom.color: color.border.muted\n      relation:\n        cardinality: \"0..1\"\n        slotName: footer";
    ds:anatomyClassic "https://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=3104-11741&t=ZeOhPBVqjN81UglM-1\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=2124-397&t=2fO23I8WsyT0YVJ1-4";
    ds:usage "Cards are intended for use in \"collection-based\" views. They are suitable for grids and galleries where multiple data objects of the same type are displayed next to each other. \n\n### When to use\n\n- When you have a repeating data structure with a uniform set of attributes that requires high legibility across many instances.\n- When the container itself acts as a toggle or a checkbox for selecting an item from a group. (radio card) // should be linking to forms\n- When the user behavior is focused on exploration of options, rather than searching for an already identified item of the group. Cards facilitate consuming the information of an individual data object, in contrast with a table where the emphasis is on comparison and ability to scan. \n- When building a responsive table, on small viewports, the designer can choose between horizontal scroll, or converting table rows into cards. \n\n### When not to use\n\n- When a single piece of information is being highlighted on a page without any \"peers\".\n  - Incorrect: A single card floating in the middle of a dashboard to show \"Total users\".\n  - Remediation: Use a [Tile](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-eThhoLZg3Y) component designed for individual metric display.\n- When the user needs to perform deep data analysis or multi-column sorting on regular size pages.\n  - Incorrect: Forcing 50 columns of data into a small card format.\n  - Remediation: Use a [Table](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Olq5LYSopF) to allow for better horizontal scanning and sorting of specific values.";
    ds:guidelines "Styling\n\nhttps://www.figma.com/design/WGHcOmGMEUF9hMAEoRafL8/%F0%9F%93%95-Pragma---documentation-visuals?node-id=2124-397&t=ch8BFFPUe9gCvMdg-1";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdocumentation;
    ds:hasProperty [
        a ds:Property;
        ds:optional "false"
    ];
    ds:hasSubcomponent ds:global.subcomponent.card-footer, ds:global.subcomponent.card-thumbnail, ds:global.subcomponent.card-content, ds:global.subcomponent.card-image, ds:global.subcomponent.card-header;
    ds:changeLog [
        a ds:ChangeLogEntry;
        ds:timestamp "2025-12-05T00:00:00.000+01:00";
        ds:change "testing the structure";
        ds:changeType "change"
    ], [
        a ds:ChangeLogEntry;
        ds:timestamp "2025-12-08T00:00:00.000+01:00";
        ds:change "Another test";
        ds:changeType "change"
    ], [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-04-06T00:00:00.000+02:00";
        ds:change "open question: in vanilla we had the responsive behavior of tables converting into cards when appropriate. we should have this behavior also for pragma. There should be a linkage between table and data table and cards. Adrian: Would recommend against it for now as it adds complexity (Which tables get turned into cards ? How should responsiveness be enforced ?)\n→ I would recommend adding to the decision log as defered; Diana: This was the design decision - it should be an opt-in responsive behaviour. we can link to “table” and “data table” for more info";
        ds:changeType "decision"
    ], [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-04-06T00:00:00.000+02:00";
        ds:change "This usage guideline stays in the  general card, until radio cards get separated into their own components: When the container itself acts as a toggle or a checkbox for selecting an item from a group. (radio card) // should be linking to form ";
        ds:changeType "change"
    ];
    ds:specializedBy ds:apps_workplaceengineering.pattern.travel_provider_card;
