@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.kvpitem_base a ds:Subcomponent;
    ds:name "KVPItem (base)";
    ds:summary "";
    ds:anatomyDsl "---\n# TODO implementation: no reference in @canonical/react-ds-global or react-ds-global-form\n# Notation-only migration. The root uri was `ds:global.subcomponent:KVPItem` in\n# the retired colon spelling.\n#\n# The notation carried FOUR trees in one cell — a base item, an `.Inline`\n# variant, a `.Stacked` variant and a `.Meta` variant — under uris\n# (`…:KVPItem.Inline`, `.Stacked`, `.Meta`) that name no ds: subject. One block\n# is one anatomy, so the base tree is the anatomy here, the Meta variant's two\n# extra parts are folded in as optional edges above the pair, and the rest is\n# recorded:\n#   Inline   — the same row, with layout.align: center rather than flex-start.\n#   Stacked  — a column rather than a row, layout.align: flex-start.\n#   Meta     — a heading and a meta-value above, and then the base item repeated\n#              1..* beneath them. That self-reference is left out rather than\n#              encoded as recursion, so the heading and the meta-value here sit\n#              above ONE key/value pair.\n# Either the variants earn their own blocks or they become a switch once someone\n# rules on it; nothing here invents the uris.\nnode:\n  uri: global.subcomponent.kvpitem_base\n  styles:\n    layout.type: flex\n    layout.direction: row\n    layout.align: flex-start\n  edges:\n    - node:\n        role: heading\n        styles:\n          # From the Meta variant. `text/secondary/bold` migrates to the\n          # composite it names; the size key admits dimension.* alone, so\n          # typography.font carries the tier.\n          typography.font: typography.text.secondary.bold\n          typography.color: color.text\n      relation:\n        cardinality: \"0..1\"\n        slotName: header\n    - node:\n        role: meta-value\n        styles:\n          # From the Meta variant.\n          typography.font: typography.text.secondary\n          typography.color: color.text\n      relation:\n        cardinality: \"0..1\"\n        slotName: headerValue\n    - node:\n        role: key\n        styles:\n          typography.font: typography.text.secondary\n          typography.color: color.text.muted\n      relation:\n        cardinality: \"1\"\n        slotName: key\n    - node:\n        role: value\n        styles:\n          typography.font: typography.text.secondary\n          typography.color: color.text\n      relation:\n        cardinality: \"1\"\n        slotName: value";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:global;
    ds:parentComponent ds:global.component.tooltip_wrapper;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/heading";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary.bold
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/heading";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/meta-value";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/meta-value";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/key";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/key";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/value";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/value";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ].
