@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.modal-footer a ds:Subcomponent;
    ds:name "Modal.Footer";
    ds:summary "";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global\n# src/lib/pattern/Modal/common/Footer/styles.css on .ds.modal-footer and its\n# ::before rule.\nnode:\n  uri: global.subcomponent.modal-footer\n  styles:\n    layout.type: flex\n    layout.direction: row\n    layout.align: center\n    layout.justify: flex-end\n    # Never shrink: only the content pane gives way.\n    layout.flex.grow: 0\n    layout.flex.shrink: 0\n    layout.flex.basis: auto\n    # Positions the inset rule below.\n    layout.position: relative\n    # The inline padding --modal-padding-inline is shared with the header and\n    # the content, so the three sections align.\n    spacing.gap: dimension.100                    # --modal-footer-gap, the inline gap between actions\n    spacing.internal.block.start: dimension.200   # --modal-footer-padding-block, a surface inset\n    spacing.internal.block.end: dimension.200     # --modal-footer-padding-block, a surface inset\n    spacing.internal.inline.start: dimension.300  # --modal-padding-inline, a surface inset\n    spacing.internal.inline.end: dimension.300    # --modal-padding-inline, a surface inset\n  edges:\n    - node:\n        uri: global.component.button\n      relation:\n        cardinality: \"0..*\"\n        slotName: default\n    - node:\n        role: divider rule\n        styles:\n          layout.position: absolute\n          # Inset to the footer's own inline padding so it aligns with the\n          # actions and the content. inset-block-start is a raw 0, which the\n          # block-axis offset keys take a token only for.\n          layout.offset.inline.start: dimension.300\n          size.block: dimension.stroke.thickness.medium\n          appearance.background: color.border.muted\n          # The second of the two rules bounding the content. Drawn as ::before\n          # rather than a border so it can be inset to the footer's inline\n          # padding and align with the actions and the content.\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:parentComponent ds:global.pattern.modal;
