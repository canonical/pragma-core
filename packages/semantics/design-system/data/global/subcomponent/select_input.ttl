@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.select_input a ds:Subcomponent;
    ds:name "SelectInput";
    ds:summary "The single-choice dropdown part a host field places in context: a collapsed control that reveals a list of mutually-exclusive options. Consumed by controls such as SelectField.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/SelectInput/styles.css on .ds.input.select, together with\n# the shared `.ds.input.chrome` rule in src/index.css, which the component's own\n# class list (`ds input select chrome`) puts on this same element. A native\n# <select>: the element itself is the text-bearing leaf and the options are its\n# own children.\nnode:\n  uri: global.subcomponent.select_input\n  styles:\n    layout.type: block\n    layout.boxSizing: border-box\n    size.width: 100%\n    appearance.native: none\n    # The chevron is DRAWN, not masked: a <select> is a replaced element with no\n    # ::before to mask, and a background-image SVG cannot be recoloured, so two\n    # diagonally-striped linear-gradients butted together form the chevron\n    # stroke, coloured by --select-caret-color (color.icon, then currentColor)\n    # and sized by --select-caret-half (0.4em per half). The roster minted these\n    # three primitive keys for exactly this case, so the literals are\n    # transcribed; the two component-local variables stay in them, because that\n    # is what the implementation writes.\n    appearance.background.image: \"linear-gradient(45deg, transparent 42%, var(--select-caret-color) 42%, var(--select-caret-color) 58%, transparent 58%), linear-gradient(135deg, transparent 42%, var(--select-caret-color) 42%, var(--select-caret-color) 58%, transparent 58%)\"\n    appearance.background.position: \"right calc(var(--form-input-padding-inline) + var(--select-caret-half)) center, right var(--form-input-padding-inline) center\"\n    appearance.background.repeat: no-repeat\n    appearance.background.size: var(--select-caret-half) var(--select-caret-half)\n    # The element carries the inline padding itself (the chrome supplies only the\n    # block padding): the start side reads --form-input-padding-inline, then\n    # --component-padding-inline, neither declared, and the end side is a calc()\n    # over it leaving room for the chevron.\n    # ── the shared input chrome (src/index.css, `.ds.input.chrome`) ──────────\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    # The base theme is bottom-border-only: `border-color` is set from\n    # --form-input-border-color, and then the top, right and left colours are\n    # overridden to `transparent` (--form-input-border-color-{top,right,left}),\n    # so only the bottom edge paints. The four-side key therefore takes the\n    # literal the three overridden sides end at, and the bottom key the token\n    # the fourth falls through to.\n    appearance.border.color: transparent\n    appearance.border.bottom.color: color.border\n    # A `.danger` field — a failed validation — repaints the bottom border alone,\n    # through --form-input-border-color-bottom.\n    appearance.border.bottom.color@invalid: color.border.error\n    appearance.radius: dimension.radius.small\n    appearance.background: color.foreground.input\n    typography.color: color.text\n    # The font-family, font-size and line-height facets of the text-primary\n    # composite are read (--typography-text-primary-font-family, and its\n    # font-size and line-height through --form-input-font-size and\n    # --form-input-line-height), so the composite is bound once: typography.size\n    # admits dimension.* alone.\n    typography.font: typography.text.primary\n    motion.property: border-color, box-shadow\n    # The hover fill reads --hover--color-foreground-input first, a computed state\n    # variable that no stratum declares as a symbol.\n    appearance.background@hover: color.foreground.input.hover\n    # Focus lights all four edges and drops the user-agent outline for a ring of\n    # its own.\n    appearance.border.color@focus: color.focusRing\n    appearance.outline.style@focus: none\n    # A disabled control keeps its border BOX so its height still matches an\n    # enabled one, and drops only the paint.\n    appearance.background@disabled: color.foreground.input.disabled\n    appearance.border.color@disabled: transparent\n    interaction.cursor@disabled: not-allowed\n    # Not bound, and why:\n    # - height reads --form-input-height, a calc() over --space-baseline, which\n    #   no stratum declares;\n    # - padding-block reads --form-input-padding-block, then\n    #   --component-padding-block, neither of which is declared. A density scope\n    #   re-derives the INLINE padding (--form-input-padding-inline, from\n    #   --density-padding-inline then --space-200) and never padding-block;\n    # - the focus ring and the disabled text colour are a box-shadow at\n    #   --form-focus-ring-color and a read of --disabled--color-text: no roster\n    #   key takes a box-shadow, and the computed state variable is not a symbol;\n    # - the transition duration reads --motion-duration-fast, undeclared;\n    # - a `.danger` field lights the focus ring at color.focusRing.error, which\n    #   needs the compound of invalid and focus that this version of the\n    #   notation reserves. Its bottom border is bound above.\n  edges:\n    - node:\n        role: option\n        # The <option> children carry no rule of their own in the stylesheet.\n      relation:\n        cardinality: \"1..*\"\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "The condensed single-choice entry part a host places in context to pick one option from a list revealed on demand.\n\n### When to use\n- A host offers a moderate set of options that should stay collapsed until needed.\n- Conserving space matters and all options need not be shown at once.\n\n### When not to use\n- The set is short and choosing benefits from full visibility — compose **RadioInput**.\n- The set is large enough to need typing to filter — compose **ComboboxInput**.\n- Several options may be selected together — compose **CheckboxInput**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "invalid";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.error
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.select_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.disabled
    ].
