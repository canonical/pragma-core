@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.checkbox_input a ds:Subcomponent;
    ds:name "CheckboxInput";
    ds:summary "The atomic checked/unchecked part a host places in context. It carries the binary state and the user's direct toggle, and is consumed by components such as [CheckboxField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-vwBCoHgXoG), a filter, or a multi-select choices group, which supply its label, validation, and surrounding meaning.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/CheckboxInput/styles.css on .ds.form-checkbox and its\n# ::before glyph. A native <input type=\"checkbox\"> with the design-system\n# selection chrome; it carries no label — the host supplies it.\nnode:\n  uri: global.subcomponent.checkbox_input\n  styles:\n    appearance.native: none\n    layout.boxSizing: border-box\n    # Positioning context for the masked checkmark/minus glyph.\n    layout.position: relative\n    # margin-inline reads --form-label-padding-inline, which no stratum declares,\n    # falling back to 0: the control aligns to the field edge, not to the input's\n    # inner padding.\n    spacing.external.inline.start: 0\n    spacing.external.inline.end: 0\n    # A 16px control: a fixed element size, deliberately NOT a baseline multiple.\n    size.width: dimension.200\n    size.height: dimension.200\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    appearance.border.color: color.border\n    appearance.radius: dimension.radius.small\n    # The unselected fill reads the surface channel so the control adapts to\n    # OnSurface stepping, then the flat token.\n    appearance.background: [surface.color.foreground.checkbox.unselected, color.foreground.checkbox.unselected]\n    appearance.background@hover: color.foreground.checkbox.unselected.hover\n    # The selected fill and border read --surface-color-foreground-checkbox-selected\n    # first, which no stratum declares (the surface family mints channels for the\n    # checkmark and the unselected fill only), so the flat token is written.\n    appearance.background@selected: color.foreground.checkbox.selected\n    appearance.border.color@selected: color.foreground.checkbox.selected\n    # A mixed box paints exactly as a selected one; only the glyph differs.\n    appearance.background@indeterminate: color.foreground.checkbox.selected\n    appearance.border.color@indeterminate: color.foreground.checkbox.selected\n    appearance.border.color@focus: color.focusRing\n    appearance.outline.style@focus: none\n    appearance.border.color@disabled: color.border.disabled\n    appearance.background@disabled: color.foreground.checkbox.unselected.disabled\n    interaction.cursor: pointer\n    interaction.cursor@disabled: not-allowed\n    motion.property: background-color, border-color\n    # Not bound, and why:\n    # - the transition duration reads --motion-duration-fast, undeclared;\n    # - the focus ring is a box-shadow at color.focusRing, which no roster key\n    #   takes;\n    # - the compound faces the stylesheet paints — a hovered selected box\n    #   (--hover--color-foreground-checkbox-selected, a computed state variable\n    #   that is not a symbol) and a disabled selected box\n    #   (color.foreground.checkbox.selected.disabled) — need a compound state,\n    #   which this version of the notation reserves.\n  edges:\n    - node:\n        # drawn as ::before\n        role: selection glyph\n        styles:\n          layout.position: absolute\n          # `inset: 0` stretches the glyph over the whole box.\n          layout.offset.top: 0\n          layout.offset.right: 0\n          layout.offset.bottom: 0\n          layout.offset.left: 0\n          # One pseudo-element draws both marks: `:checked` masks\n          # checkmark.svg onto this box and `:indeterminate` masks minus.svg\n          # onto it, which is why the node is the selection glyph rather than\n          # the check mark alone. Both faces take the same paint; only the mask\n          # differs, and no roster key takes a mask.\n          # The mark is a mask with `background-color` behind it, because a\n          # background-image SVG cannot be recoloured and would ignore the\n          # theme. No roster key takes a mask. Deliberately, the paint arrives\n          # only WITH the mask: an unmasked background-color would fill the whole\n          # box in the unselected state.\n          appearance.background@selected: [surface.color.foreground.checkbox.checkmark, color.foreground.checkbox.checkmark]\n          appearance.background@indeterminate: [surface.color.foreground.checkbox.checkmark, color.foreground.checkbox.checkmark]\n          appearance.background@disabled: color.foreground.checkbox.checkmark.disabled\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "The independent on/off entry part a host places in context for a single, self-contained choice.\n\n\n\n### When to use\n\n- A host needs one or more choices that each toggle independently, where any combination may be selected.\n\n- A choice represents a discrete opt-in or opt-out that carries meaning on its own.\n\n- A group of related choices may all be active at once.\n\n\n\n### When not to use\n\n- Choices are mutually exclusive and exactly one must win — compose [RadioInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-x_sKubP8Qh) .\n\n- A single setting flips an immediate, system-like state — compose [SwitchInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-rCfe2Hk8yE) .\n\n- The host offers many choices better presented as a condensed list — compose [SelectInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-EVwqNhd3WH) .\n\n";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
