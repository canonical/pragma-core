        ds:viaBlock ds:global.subcomponent.checkbox_input;
        ds:node "$root";
        anatomy:styleKey "size.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.checkbox_input;
