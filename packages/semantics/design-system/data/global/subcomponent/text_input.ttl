@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.text_input a ds:Subcomponent;
    ds:name "TextInput";
    ds:summary "The single-line text-entry part a host field places in context. It accepts the user's typed text and can present a leading or trailing affix (such as a unit or symbol) beside the value; it is consumed by controls such as [TextField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-QAuX4qtecx)  and is not used on its own.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/TextInput/styles.css on .ds.input.text and its child\n# selectors (> input, > .prefix, > .suffix), together with the shared\n# `.ds.input.chrome` rule in src/index.css, which the component's own class list\n# (`ds input text chrome`) puts on this same element.\nnode:\n  uri: global.subcomponent.text_input\n  styles:\n    # The composite wrapper overrides the chrome's `display: block` and resets its\n    # padding: the inner <input> is the text-bearing leaf and carries the inline\n    # padding, so the wrapper must not inset the text twice.\n    layout.type: flex\n    layout.align: stretch\n    layout.position: relative\n    layout.boxSizing: border-box\n    typography.direction: inherit\n    size.width: 100%\n    spacing.internal.block.start: 0\n    spacing.internal.block.end: 0\n    spacing.internal.inline.start: 0\n    spacing.internal.inline.end: 0\n    # ── the shared input chrome (src/index.css, `.ds.input.chrome`) ──────────\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    # The base theme is bottom-border-only: `border-color` is set from\n    # --form-input-border-color, and then the top, right and left colours are\n    # overridden to `transparent` (--form-input-border-color-{top,right,left}),\n    # so only the bottom edge paints. The four-side key therefore takes the\n    # literal the three overridden sides end at, and the bottom key the token\n    # the fourth falls through to.\n    appearance.border.color: transparent\n    appearance.border.bottom.color: color.border\n    # A `.danger` field — a failed validation — repaints the bottom border alone,\n    # through --form-input-border-color-bottom.\n    appearance.border.bottom.color@invalid: color.border.error\n    appearance.radius: dimension.radius.small\n    appearance.background: color.foreground.input\n    typography.color: color.text\n    # The font-family, font-size and line-height facets of the text-primary\n    # composite are read (--typography-text-primary-font-family, and its\n    # font-size and line-height through --form-input-font-size and\n    # --form-input-line-height), so the composite is bound once: typography.size\n    # admits dimension.* alone.\n    typography.font: typography.text.primary\n    motion.property: border-color, box-shadow\n    # The hover fill reads --hover--color-foreground-input first, a computed state\n    # variable that no stratum declares as a symbol.\n    appearance.background@hover: color.foreground.input.hover\n    # Focus lights all four edges and drops the user-agent outline for a ring of\n    # its own.\n    appearance.border.color@focus: color.focusRing\n    appearance.outline.style@focus: none\n    # A disabled control keeps its border BOX so its height still matches an\n    # enabled one, and drops only the paint.\n    appearance.background@disabled: color.foreground.input.disabled\n    appearance.border.color@disabled: transparent\n    interaction.cursor@disabled: not-allowed\n    # Not bound, and why:\n    # - height reads --form-input-height, a calc() over --space-baseline, which\n    #   no stratum declares;\n    # - padding-block reads --form-input-padding-block, then\n    #   --component-padding-block, neither of which is declared. A density scope\n    #   re-derives the INLINE padding (--form-input-padding-inline, from\n    #   --density-padding-inline then --space-200) and never padding-block;\n    # - the focus ring and the disabled text colour are a box-shadow at\n    #   --form-focus-ring-color and a read of --disabled--color-text: no roster\n    #   key takes a box-shadow, and the computed state variable is not a symbol;\n    # - the transition duration reads --motion-duration-fast, undeclared;\n    # - a `.danger` field lights the focus ring at color.focusRing.error, which\n    #   needs the compound of invalid and focus that this version of the\n    #   notation reserves. Its bottom border is bound above.\n  edges:\n    - node:\n        role: prefix\n        styles:\n          layout.type: flex\n          layout.align: center\n          typography.color: color.text.muted\n          typography.whiteSpace: nowrap\n          interaction.select: none\n          # padding-inline reads --form-field-inline-gap, then\n          # --container-gap-default: neither is declared.\n      relation:\n        cardinality: \"0..1\"\n        slotName: prefix\n    - node:\n        role: value\n        styles:\n          layout.flex.grow: 1\n          layout.flex.shrink: 1\n          layout.flex.basis: 0%\n          size.min.width: 0\n          appearance.border.style: none\n          appearance.background: transparent\n          typography.color: inherit\n          typography.fontFamily: inherit\n          appearance.outline.style: none\n          # The text-bearing leaf carries the inline padding, which reads\n          # --form-input-padding-inline then --component-padding-inline: neither\n          # is declared. Font-size, line-height and the baseline nudges come from\n          # the `.p` class, not from this rule.\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        role: suffix\n        styles:\n          layout.type: flex\n          layout.align: center\n          typography.color: color.text.muted\n          typography.whiteSpace: nowrap\n          interaction.select: none\n      relation:\n        cardinality: \"0..1\"\n        slotName: suffix";
    ds:anatomyClassic "";
    ds:usage "The single-line free-text entry part a host places in context for short, open-ended written values.\n\n\n\n### When to use\n\n- A host collects a brief line of text such as a name or label.\n\n- The value is open prose with no fixed option set and fits on one line.\n\n\n\n### When not to use\n\n- The value runs to several lines — compose [TextareaInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-AhD9dYg2Q9) .\n\n- The value is a sensitive secret — compose [PasswordInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-56yPjE3O1S) , or a phone number — [PhoneInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-TOwhvjdQ8a) .\n\n- The value is a choice from a known set — compose [SelectInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-EVwqNhd3WH) .";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "invalid";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.error
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root/prefix";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.text_input;
        ds:node "$root/suffix";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ].
