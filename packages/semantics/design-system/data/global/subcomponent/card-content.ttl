@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.card-content a ds:Subcomponent;
    ds:name "Card.Content";
    ds:summary "The card content is the primary body area of the component used to house the main information of the [Card](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-Gm_-gu8fGD). It can include body text, data points, or interactive elements like buttons and links. Its purpose is to serve as the flexible space where the detailed story or task of the card is communicated to the user. Because cards are used for comparison, this section is structured to show the same types of information across all instances in a set.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global\n# src/lib/component/Card/common/Content/styles.css on .ds.card-content, with the\n# parent's own child rules in src/lib/component/Card/styles.css\n# (.ds.card > .card-content, and the divider on a non-last section).\nnode:\n  uri: global.subcomponent.card-content\n  styles:\n    layout.type: flex\n    layout.direction: column\n    layout.grid.row: 3\n    layout.grid.column: \"1 / -1\"\n    # --card-content-* are declared in :root. The block padding is deliberately\n    # asymmetric (one baseline above, two below), which no single spacing role\n    # can say.\n    spacing.gap: dimension.100                    # --card-content-gap, the block gap between fields\n    spacing.internal.block.start: dimension.100   # --card-content-padding-block-start\n    spacing.internal.block.end: dimension.200     # --card-content-padding-block-end\n    spacing.internal.inline.start: dimension.200  # --card-content-padding-inline, a surface inset\n    spacing.internal.inline.end: dimension.200    # --card-content-padding-inline, a surface inset\n    # A content section that is not the card's last draws the divider to the\n    # section below. The roster has no block-end colour key, so the bottom key\n    # carries it; the matching width, dimension.stroke.thickness.medium via\n    # --card-border-width, has no one-edge key at all.\n    appearance.border.bottom.color: color.border.muted\n    appearance.border.style: solid";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdocumentation;
    ds:hasProperty [
        a ds:Property;
        ds:name "children";
        ds:propertyType "node";
        ds:optional "false"
    ];
    ds:parentComponent ds:global.component.card;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.card-content;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.card-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.card-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.card-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.card-content;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.card-content;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.muted
    ].
