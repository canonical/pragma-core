@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.combobox_input a ds:Subcomponent;
    ds:name "ComboboxInput";
    ds:summary "The type-to-filter selection part a host field places in context: a query entry paired with a results list the user filters and picks from, optionally showing chosen values as removable tokens. It is consumed by controls such as ComboboxField and is not used on its own.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/ComboboxInput/styles.css on .ds.form-combobox and its\n# child selectors, with src/lib/subcomponent/ComboboxInput/common/List/styles.css\n# (.ds.combobox-list) and common/ResetButton/styles.css\n# (.ds.combobox-reset-button). The stylesheet corrects the tree: the query entry\n# is a wrapper carrying the shared input chrome, the clear control sits inside\n# it, and the selected tokens live in their own container above it.\nnode:\n  uri: global.subcomponent.combobox_input\n  styles:\n    layout.type: grid\n    layout.grid.columns: 1fr auto\n    layout.grid.rows: auto\n  edges:\n    - node:\n        role: selected items\n        styles:\n          layout.grid.column: \"1 / -1\"\n          layout.type: flex\n          layout.wrap: wrap\n          # The gap and the block-end margin read --space-050, which no stratum\n          # declares, and the container is `display: none` while empty — a\n          # display value the roster has no key for, since layout.type carries\n          # the display the element has when it is shown.\n        edges:\n          - node:\n              role: selected token\n              styles:\n                layout.type: inline-flex\n                layout.align: center\n                appearance.background: color.foreground.secondary\n                appearance.background@hover: color.foreground.secondary.hover\n                appearance.border.width: dimension.stroke.thickness.medium\n                appearance.border.style: solid\n                appearance.border.color: color.border.muted\n                appearance.radius: [dimension.radius.full, 9999px]\n                typography.color: color.text\n                interaction.cursor: pointer\n                motion.property: background-color\n                # Only the composite's font-size facet is read\n                # (--typography-text-secondary-font-size); typography.size admits\n                # dimension.* alone, so the composite carries it.\n                typography.font: typography.text.secondary\n                # The chip's own gap (0.25rem) and padding (0.125rem 0.5rem) are\n                # literals the stylesheet writes; the spacing keys admit either,\n                # so they are written as the implementation has them.\n                spacing.gap: 0.25rem\n                spacing.internal.block.start: 0.125rem\n                spacing.internal.block.end: 0.125rem\n                spacing.internal.inline.start: 0.5rem\n                spacing.internal.inline.end: 0.5rem\n              edges:\n                - node:\n                    role: remove icon\n                    styles:\n                      typography.size: 0.75em\n                      typography.lineHeight: 1\n                  relation:\n                    cardinality: \"1\"\n            relation:\n              cardinality: \"0..*\"\n      relation:\n        cardinality: \"0..1\"\n    - node:\n        role: query entry\n        styles:\n          layout.grid.column: \"1 / -1\"\n          layout.grid.row: 2\n          # A composite wrapper: it overrides the chrome's `display: block` and\n          # resets its padding, because the inner <input> is the text-bearing\n          # leaf. It also declares `anchor-name: --combobox-input`, which the\n          # results list positions against; no roster key takes an anchor name.\n          layout.type: flex\n          layout.align: stretch\n          layout.boxSizing: border-box\n          size.width: 100%\n          spacing.internal.block.start: 0\n          spacing.internal.block.end: 0\n          spacing.internal.inline.start: 0\n          spacing.internal.inline.end: 0\n          # ── the shared input chrome (src/index.css, `.ds.input.chrome`) ──────────\n          appearance.border.width: dimension.stroke.thickness.medium\n          appearance.border.style: solid\n          # The base theme is bottom-border-only: `border-color` is set from\n          # --form-input-border-color, and then the top, right and left colours are\n          # overridden to `transparent` (--form-input-border-color-{top,right,left}),\n          # so only the bottom edge paints. The four-side key therefore takes the\n          # literal the three overridden sides end at, and the bottom key the token\n          # the fourth falls through to.\n          appearance.border.color: transparent\n          appearance.border.bottom.color: color.border\n          # A `.danger` field — a failed validation — repaints the bottom border\n          # alone, through --form-input-border-color-bottom.\n          appearance.border.bottom.color@invalid: color.border.error\n          appearance.radius: dimension.radius.small\n          appearance.background: color.foreground.input\n          typography.color: color.text\n          # The font-family, font-size and line-height facets of the text-primary\n          # composite are read (--typography-text-primary-font-family, and its\n          # font-size and line-height through --form-input-font-size and\n          # --form-input-line-height), so the composite is bound once: typography.size\n          # admits dimension.* alone.\n          typography.font: typography.text.primary\n          motion.property: border-color, box-shadow\n          # The hover fill reads --hover--color-foreground-input first, a computed state\n          # variable that no stratum declares as a symbol.\n          appearance.background@hover: color.foreground.input.hover\n          # Focus lights all four edges and drops the user-agent outline for a ring of\n          # its own.\n          appearance.border.color@focus: color.focusRing\n          appearance.outline.style@focus: none\n          # A disabled control keeps its border BOX so its height still matches an\n          # enabled one, and drops only the paint.\n          appearance.background@disabled: color.foreground.input.disabled\n          appearance.border.color@disabled: transparent\n          interaction.cursor@disabled: not-allowed\n          # Not bound, and why:\n          # - height reads --form-input-height, a calc() over --space-baseline, which\n          #   no stratum declares;\n          # - padding-block reads --form-input-padding-block, then\n          #   --component-padding-block, neither of which is declared. A density scope\n          #   re-derives the INLINE padding (--form-input-padding-inline, from\n          #   --density-padding-inline then --space-200) and never padding-block;\n          # - the focus ring and the disabled text colour are a box-shadow at\n          #   --form-focus-ring-color and a read of --disabled--color-text: no roster\n          #   key takes a box-shadow, and the computed state variable is not a symbol;\n          # - the transition duration reads --motion-duration-fast, undeclared;\n          # - a `.danger` field lights the focus ring at color.focusRing.error,\n          #   which needs the compound of invalid and focus that this version of\n          #   the notation reserves. Its bottom border is bound above.\n        edges:\n          - node:\n              role: value\n              styles:\n                layout.flex.grow: 1\n                layout.flex.shrink: 1\n                layout.flex.basis: 0%\n                size.min.width: 0\n                appearance.border.style: none\n                appearance.background: transparent\n                appearance.outline.style: none\n                typography.color: inherit\n                typography.fontFamily: inherit\n                # The leaf carries the inline padding, which reads\n                # --form-input-padding-inline then --component-padding-inline:\n                # neither is declared.\n            relation:\n              cardinality: \"1\"\n              slotName: default\n          - node:\n              # The reset control IS the design-system Button: ResetButton.tsx\n              # renders <Button> from @canonical/react-ds-global with the\n              # `ds combobox-reset-button` class on it, so this is a named child\n              # with the contextual overrides that class applies. It is rendered\n              # unconditionally by both the single and the multiple combobox.\n              uri: global.component.button\n              styles:\n                layout.flex.shrink: 0\n                layout.type: flex\n                layout.align: center\n                layout.justify: center\n                typography.color: color.text.muted\n                typography.color@hover: color.text\n                typography.size: 1rem\n                typography.lineHeight: 1\n                interaction.cursor: pointer\n                appearance.outline.style@focus: none\n                appearance.radius@focus: dimension.radius.small\n                # The class opens with `all: unset`, which strips every one of\n                # Button's own declarations before these are applied.\n                # padding-inline reads --component-padding-inline, which no\n                # stratum declares, and the focus ring is a box-shadow at\n                # color.focusRing, which no roster key takes.\n            relation:\n              cardinality: \"1\"\n      relation:\n        cardinality: \"1\"\n    - node:\n        role: results list\n        styles:\n          layout.grid.column: \"1 / -1\"\n          layout.listStyle: none\n          layout.overflow.block: auto\n          size.max.height: 15rem\n          appearance.background: color.background\n          appearance.border.width: dimension.stroke.thickness.medium\n          appearance.border.style: solid\n          appearance.border.color: color.border\n          appearance.radius: dimension.radius.small\n          spacing.internal.block.start: 0\n          spacing.internal.block.end: 0\n          spacing.internal.inline.start: 0\n          spacing.internal.inline.end: 0\n          spacing.external.block.start: 2px\n          # `margin: 0` zeroes the other three sides before the block-start\n          # nudge is applied.\n          spacing.external.block.end: 0\n          spacing.external.inline.start: 0\n          spacing.external.inline.end: 0\n          # A native popover positioned with CSS anchor positioning\n          # (position-anchor: --combobox-input, position-area, width:\n          # anchor-size(inline)) and lifted by a box-shadow: no roster key takes\n          # an anchor, a position-area or a shadow.\n        edges:\n          - node:\n              role: option\n              styles:\n                interaction.cursor: pointer\n                motion.property: background-color\n                appearance.background@hover: color.foreground.ghost.hover\n                typography.weight@selected: bold\n                # Two faces, and they are different elements of state: `.selected`\n                # is the CHOSEN option (List.tsx sets it from isSelected) and takes\n                # the bold weight, while `.highlighted` — the keyboard cursor —\n                # takes the same fill as a hovered option, which the hover binding\n                # above already carries.\n                # padding reads --component-padding-block and\n                # --component-padding-inline, neither declared.\n            relation:\n              cardinality: \"0..*\"\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "The filterable single-choice entry part a host places in context when the option set is large or searchable.\n\n### When to use\n- A host presents many options and the person narrows them by typing before choosing one.\n- The option set is long enough that scanning alone is slow.\n- A free-text query should surface and match against a known set of choices.\n\n### When not to use\n- The option set is short and scannable without filtering — compose **SelectInput**.\n- Choices are few and benefit from being shown all at once — compose **RadioInput**.\n- The entry is open prose with no fixed option set — compose **TextInput**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
