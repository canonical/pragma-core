@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.chart_legend_item a ds:Subcomponent;
    ds:name "ChartLegendItem";
    ds:summary "";
    ds:anatomyDsl "---\n# TODO implementation: no reference in @canonical/react-ds-global or react-ds-global-form\n# Notation-only migration. The root uri was `ds:global.subcomponent:ChartLegendItem`\n# in the retired colon spelling; the notation's markdown fence and title line are\n# dropped.\nnode:\n  uri: global.subcomponent.chart_legend_item\n  styles:\n    layout.type: flex\n    layout.direction: row\n    layout.align: center\n    # `spacing.internal.vertical` is not a roster key: it becomes the two block\n    # sides. Both it and the gap carry dimension.100, which the spacing keys now\n    # admit; no spacing symbol resolves to 8px in every context, so the dimension\n    # is bound and the role it plays is named on the line.\n    spacing.internal.block.start: dimension.100   # a surface inset\n    spacing.internal.block.end: dimension.100     # a surface inset\n    spacing.gap: dimension.100                    # the inline gap between marks\n  edges:\n    - node:\n        role: marker\n        styles:\n          appearance.background: color.text\n      relation:\n        cardinality: \"1\"\n        slotName: icon\n    - node:\n        role: label\n        styles:\n          # `text/secondary/root` migrates to the composite it names; the size\n          # key admits dimension.* alone, so typography.font carries the tier.\n          typography.font: typography.text.secondary\n          typography.color: color.text\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        role: value\n        styles:\n          typography.font: typography.text.secondary\n          typography.color: color.text\n      relation:\n        cardinality: \"0..1\"\n        slotName: value\n    - node:\n        role: divider\n        styles:\n          appearance.background: color.palette.gray.180\n      relation:\n        cardinality: \"0..1\"\n        slotName: separator";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:global;
    ds:parentComponent ds:global.component.data_tooltip;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root/marker";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root/label";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root/label";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root/value";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root/value";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.chart_legend_item;
        ds:node "$root/divider";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.palette.gray.180
    ].
