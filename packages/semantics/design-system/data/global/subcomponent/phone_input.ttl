@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.phone_input a ds:Subcomponent;
    ds:name "PhoneInput";
    ds:summary "The composite phone-entry part a host field places in context: a country selector paired with a number-entry area. It is consumed by controls such as PhoneField and is not used on its own.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/PhoneInput/styles.css on .ds.input.phone and its child\n# selectors (> .country-select, > .number-input), together with the shared\n# `.ds.input.chrome` rule in src/index.css, which the component's own class list\n# (`ds input phone chrome`) puts on this same element.\nnode:\n  uri: global.subcomponent.phone_input\n  styles:\n    # A composite wrapper: two controls share one visual box, so it overrides the\n    # chrome's `display: block` and resets its padding.\n    layout.type: flex\n    layout.align: stretch\n    layout.boxSizing: border-box\n    size.width: 100%\n    spacing.internal.block.start: 0\n    spacing.internal.block.end: 0\n    spacing.internal.inline.start: 0\n    spacing.internal.inline.end: 0\n    # ── the shared input chrome (src/index.css, `.ds.input.chrome`) ──────────\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    # The base theme is bottom-border-only: `border-color` is set from\n    # --form-input-border-color, and then the top, right and left colours are\n    # overridden to `transparent` (--form-input-border-color-{top,right,left}),\n    # so only the bottom edge paints. The four-side key therefore takes the\n    # literal the three overridden sides end at, and the bottom key the token\n    # the fourth falls through to.\n    appearance.border.color: transparent\n    appearance.border.bottom.color: color.border\n    # A `.danger` field — a failed validation — repaints the bottom border alone,\n    # through --form-input-border-color-bottom.\n    appearance.border.bottom.color@invalid: color.border.error\n    appearance.radius: dimension.radius.small\n    appearance.background: color.foreground.input\n    typography.color: color.text\n    # The font-family, font-size and line-height facets of the text-primary\n    # composite are read (--typography-text-primary-font-family, and its\n    # font-size and line-height through --form-input-font-size and\n    # --form-input-line-height), so the composite is bound once: typography.size\n    # admits dimension.* alone.\n    typography.font: typography.text.primary\n    motion.property: border-color, box-shadow\n    # The hover fill reads --hover--color-foreground-input first, a computed state\n    # variable that no stratum declares as a symbol.\n    appearance.background@hover: color.foreground.input.hover\n    # Focus lights all four edges and drops the user-agent outline for a ring of\n    # its own.\n    appearance.border.color@focus: color.focusRing\n    appearance.outline.style@focus: none\n    # A disabled control keeps its border BOX so its height still matches an\n    # enabled one, and drops only the paint.\n    appearance.background@disabled: color.foreground.input.disabled\n    appearance.border.color@disabled: transparent\n    interaction.cursor@disabled: not-allowed\n    # Not bound, and why:\n    # - height reads --form-input-height, a calc() over --space-baseline, which\n    #   no stratum declares;\n    # - padding-block reads --form-input-padding-block, then\n    #   --component-padding-block, neither of which is declared. A density scope\n    #   re-derives the INLINE padding (--form-input-padding-inline, from\n    #   --density-padding-inline then --space-200) and never padding-block;\n    # - the focus ring and the disabled text colour are a box-shadow at\n    #   --form-focus-ring-color and a read of --disabled--color-text: no roster\n    #   key takes a box-shadow, and the computed state variable is not a symbol;\n    # - the transition duration reads --motion-duration-fast, undeclared;\n    # - a `.danger` field lights the focus ring at color.focusRing.error, which\n    #   needs the compound of invalid and focus that this version of the\n    #   notation reserves. Its bottom border is bound above.\n  edges:\n    - node:\n        role: country selector\n        styles:\n          appearance.native: none\n          appearance.border.style: none\n          appearance.background: transparent\n          typography.color: inherit\n          typography.fontFamily: inherit\n          typography.whiteSpace: nowrap\n          interaction.cursor: pointer\n          size.min.width: 5.5rem\n          # The separator between the two controls: a border-inline-end at\n          # --form-input-border-width. The roster has an inline-end colour key\n          # but no inline-end width key, so only the colour is bound.\n          appearance.border.inline.end.color: color.border\n          # Focus tints the selector with the input hover fill; its first rank,\n          # --hover--color-foreground-input, is a computed state variable that no\n          # stratum declares as a symbol.\n          appearance.background@focus: color.foreground.input.hover\n          appearance.outline.style@focus: none\n          interaction.cursor@disabled: not-allowed\n          # Not bound: padding-inline and padding-inline-end read\n          # --form-input-padding-inline / --form-field-inline-gap, then\n          # --component-padding-inline / --container-gap-default, none declared;\n          # the disabled text colour reads --form-input-color-disabled, i.e. the\n          # computed --disabled--color-text; and the disabled separator colour is\n          # `transparent`, which the inline-end colour key (token only) cannot\n          # take. The `.p` class supplies font-size, line-height and the\n          # baseline nudges.\n      relation:\n        cardinality: \"1\"\n    - node:\n        role: number entry\n        styles:\n          layout.flex.grow: 1\n          layout.flex.shrink: 1\n          layout.flex.basis: 0%\n          size.min.width: 0\n          appearance.border.style: none\n          appearance.background: transparent\n          appearance.outline.style: none\n          typography.color: inherit\n          typography.fontFamily: inherit\n          interaction.cursor@disabled: not-allowed\n          # The leaf carries the inline padding (--form-input-padding-inline,\n          # then --component-padding-inline: undeclared), and its disabled text\n          # colour reads the computed --disabled--color-text.\n      relation:\n        cardinality: \"1\"\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "The telephone-number entry part a host places in context when the value follows dialling conventions.\n\n\n\n### When to use\n\n- A host collects a phone number that benefits from regional formatting and validation.\n\n- The value should be guided toward a recognised dialling pattern.\n\n\n\n### When not to use\n\n- The value is free-form text with no number conventions — compose [TextInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-csRvI-VTpO) .\n\n- The value is a general numeric quantity within a range — compose [RangeInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-UoMsaXBhOs) .";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "invalid";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.error
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root/country selector";
        anatomy:styleKey "appearance.border.inline.end.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.phone_input;
        ds:node "$root/country selector";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ].
