@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.range_input a ds:Subcomponent;
    ds:name "RangeInput";
    ds:summary "The slider part a host field places in context: a track the user drags to set a value within bounds, paired with a live readout of the current value. Consumed by controls such as RangeField; not used on its own.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/RangeInput/styles.css on .ds.range (with its\n# ::-webkit-slider-runnable-track / ::-moz-range-track and\n# ::-webkit-slider-thumb / ::-moz-range-thumb) and on .ds.range-output. The\n# component renders a FRAGMENT — the slider and its live <output> readout are\n# siblings, with no wrapper element between them — so the root of this anatomy\n# is the subcomponent itself and carries no styles: `@implements` sits on the\n# component, and the .ds.range declarations belong to the slider child below.\nnode:\n  uri: global.subcomponent.range_input\n  edges:\n    - node:\n        role: track\n        styles:\n          appearance.native: none\n          size.width: 100%\n          # The element box is as tall as the THUMB, so neither the thumb nor its\n          # focus ring is ever clipped in a flex row; the visible bar is painted\n          # by the track pseudo-elements and centred within this box.\n          size.height: dimension.200\n          appearance.background: transparent\n          appearance.border.style: none\n          appearance.outline.style: none\n          interaction.cursor: pointer\n          interaction.cursor@disabled: not-allowed\n        edges:\n          - node:\n              role: bar\n              styles:\n                # The vendor track pseudo-element keeps a user-agent border even\n                # after `appearance: none`, so the flat bar is painted here, 8px\n                # tall, in both the WebKit and the Firefox spelling.\n                size.height: dimension.100\n                appearance.background: color.foreground.slider.track\n                appearance.background@disabled: color.foreground.slider.track.disabled\n                appearance.border.style: none\n                appearance.radius: dimension.radius.small\n            relation:\n              cardinality: \"1\"\n          - node:\n              role: thumb\n              styles:\n                size.width: dimension.200\n                size.height: dimension.200\n                appearance.radius: 50%\n                appearance.background: color.foreground.slider.progress\n                appearance.background@disabled: color.foreground.slider.progress.disabled\n                appearance.border.style: none\n                interaction.cursor: pointer\n                # margin-top re-centres the 16px thumb on the 8px bar as a calc()\n                # over the two dimension tokens, and the focus ring is a\n                # box-shadow at color.focusRing: neither has a roster key.\n            relation:\n              cardinality: \"1\"\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        role: value readout\n        styles:\n          layout.type: block\n          typography.align: center\n          typography.color: color.text.muted\n          # Font-size, line-height and the baseline nudges come from the `.p`\n          # class on the <output>, not from this rule.\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "The bounded-quantity entry part a host places in context when a value is selected along a continuous span.\n\n\n\n### When to use\n\n- A host collects a numeric value between a known minimum and maximum.\n\n- Approximate, relative selection along a scale matters more than an exact figure.\n\n\n\n### When not to use\n\n- A precise number or arbitrary text is needed — compose [TextInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-csRvI-VTpO) .\n\n- The value is one option from a labelled set — compose [SelectInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-EVwqNhd3WH)  or [RadioInput](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-x_sKubP8Qh) .";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.track
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.track.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/bar";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "size.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.progress
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/track/thumb";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.slider.progress.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.range_input;
        ds:node "$root/value readout";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ].
