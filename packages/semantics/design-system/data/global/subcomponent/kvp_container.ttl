@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.kvp_container a ds:Subcomponent;
    ds:name "KVP (container)";
    ds:summary "";
    ds:anatomyDsl "---\n# TODO implementation: no reference in @canonical/react-ds-global or react-ds-global-form\n# Notation-only migration. Two repairs: the root uri was\n# `ds:global.component:KeyValuePair` — the wrong type segment, the wrong block\n# and the retired colon spelling; and the item reference is spelled as the\n# subject that does exist, global.subcomponent.kvpitem_base. The notation's\n# markdown fence and title line are dropped.\nnode:\n  uri: global.subcomponent.kvp_container\n  styles:\n    layout.type: flex\n    layout.direction: column\n    layout.align: flex-start\n    spacing.gap: dimension.100   # the block gap between fields\n  edges:\n    - node:\n        uri: global.subcomponent.kvpitem_base\n      relation:\n        cardinality: \"1..*\"\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:global;
    ds:parentComponent ds:global.component.tooltip_wrapper;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvp_container;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/heading";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary.bold
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/heading";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/meta-value";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/meta-value";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/key";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/key";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.muted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/value";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.kvpitem_base;
        ds:node "$root/value";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ].
