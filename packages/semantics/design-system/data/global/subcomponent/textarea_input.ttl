@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.textarea_input a ds:Subcomponent;
    ds:name "TextareaInput";
    ds:summary "The multi-line text-entry part a host field places in context; it accepts extended text the user can write and revise over several lines, and is consumed by controls such as [TextareaField](https://docs.superhuman.com/d/_dNyzE_TLZDh#_tugrid-20dWwIHYhx/_rui-1BX4RBEZu6) .";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/TextareaInput/styles.css on .ds.input.textarea, together\n# with the shared `.ds.input.chrome` rule in src/index.css, which the component's\n# own class list (`ds input textarea chrome`) puts on this same element. A native\n# <textarea>: the element itself is the text-bearing leaf, so the notation's\n# `value` child is dropped — the stylesheet has no child selector and the value\n# is the element's own text content.\nnode:\n  uri: global.subcomponent.textarea_input\n  styles:\n    layout.type: block\n    layout.boxSizing: border-box\n    size.width: 100%\n    interaction.resize: vertical\n    # The element carries the inline padding itself (the chrome supplies only the\n    # block padding); both read --form-input-padding-inline /\n    # --form-input-padding-block, then --component-padding-inline /\n    # --component-padding-block, none of which is declared. `min-height` is a\n    # calc() over 5lh and that block padding, and size.min.height takes a token\n    # only. The baseline seating of the first line comes from density.css.\n    # ── the shared input chrome (src/index.css, `.ds.input.chrome`) ──────────\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    # The base theme is bottom-border-only: `border-color` is set from\n    # --form-input-border-color, and then the top, right and left colours are\n    # overridden to `transparent` (--form-input-border-color-{top,right,left}),\n    # so only the bottom edge paints. The four-side key therefore takes the\n    # literal the three overridden sides end at, and the bottom key the token\n    # the fourth falls through to.\n    appearance.border.color: transparent\n    appearance.border.bottom.color: color.border\n    # A `.danger` field — a failed validation — repaints the bottom border alone,\n    # through --form-input-border-color-bottom.\n    appearance.border.bottom.color@invalid: color.border.error\n    appearance.radius: dimension.radius.small\n    appearance.background: color.foreground.input\n    typography.color: color.text\n    # The font-family, font-size and line-height facets of the text-primary\n    # composite are read (--typography-text-primary-font-family, and its\n    # font-size and line-height through --form-input-font-size and\n    # --form-input-line-height), so the composite is bound once: typography.size\n    # admits dimension.* alone.\n    typography.font: typography.text.primary\n    motion.property: border-color, box-shadow\n    # The hover fill reads --hover--color-foreground-input first, a computed state\n    # variable that no stratum declares as a symbol.\n    appearance.background@hover: color.foreground.input.hover\n    # Focus lights all four edges and drops the user-agent outline for a ring of\n    # its own.\n    appearance.border.color@focus: color.focusRing\n    appearance.outline.style@focus: none\n    # A disabled control keeps its border BOX so its height still matches an\n    # enabled one, and drops only the paint.\n    appearance.background@disabled: color.foreground.input.disabled\n    appearance.border.color@disabled: transparent\n    interaction.cursor@disabled: not-allowed\n    # Not bound, and why:\n    # - height reads --form-input-height, a calc() over --space-baseline, which\n    #   no stratum declares;\n    # - padding-block reads --form-input-padding-block, then\n    #   --component-padding-block, neither of which is declared. A density scope\n    #   re-derives the INLINE padding (--form-input-padding-inline, from\n    #   --density-padding-inline then --space-200) and never padding-block;\n    # - the focus ring and the disabled text colour are a box-shadow at\n    #   --form-focus-ring-color and a read of --disabled--color-text: no roster\n    #   key takes a box-shadow, and the computed state variable is not a symbol;\n    # - the transition duration reads --motion-duration-fast, undeclared;\n    # - a `.danger` field lights the focus ring at color.focusRing.error, which\n    #   needs the compound of invalid and focus that this version of the\n    #   notation reserves. Its bottom border is bound above.";
    ds:anatomyClassic "";
    ds:usage "The multi-line free-text entry part a host places in context for longer written passages.\n\n### When to use\n- A host collects open prose that spans multiple lines, such as comments or descriptions.\n- The person needs room to compose and review extended text.\n\n### When not to use\n- The value is a single short line — compose **TextInput**.\n- The value is a choice from a fixed set — compose **SelectInput**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasProperty [
        a ds:Property;
        ds:name "value";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "placeholder";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "disabled";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "rows";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "maxRows";
        ds:summary "(Cc [Goulin Khoge](mailto:goulin.khoge@canonical.com) ‘s suggestion)";
        ds:optional "false"
    ];
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.bottom.color";
        anatomy:styleState "invalid";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.error
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.small
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.textarea_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.input.disabled
    ].
