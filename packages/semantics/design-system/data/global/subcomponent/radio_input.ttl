@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.radio_input a ds:Subcomponent;
    ds:name "RadioInput";
    ds:summary "The atomic single-select option part a host places in context: one selectable choice within a mutually-exclusive set. It is consumed by a choices group (e.g. single-select Choices/SimpleChoices) which supplies the set, labelling, and validation; it is not used on its own.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/RadioInput/styles.css on .ds.form-radio. The atomic radio\n# control: a circular native input with the design-system selection chrome,\n# carrying no label — the host supplies it.\nnode:\n  uri: global.subcomponent.radio_input\n  styles:\n    appearance.native: none\n    layout.boxSizing: border-box\n    # margin-inline reads --form-input-padding-inline, then\n    # --component-padding-inline: neither is declared.\n    # A 16px control: a fixed element size, deliberately NOT a baseline multiple.\n    size.width: dimension.200\n    size.height: dimension.200\n    appearance.border.width: dimension.stroke.thickness.medium\n    appearance.border.style: solid\n    appearance.border.color: color.border\n    appearance.radius: 50%\n    # The unselected fill reads the surface channel so the control adapts to\n    # OnSurface stepping, then the flat token.\n    appearance.background: [surface.color.foreground.radio.unselected, color.foreground.radio.unselected]\n    appearance.background@hover: color.foreground.radio.unselected.hover\n    # Selected, the ring border takes the selected token; the dot itself is a\n    # radial-gradient (selected at 40%, unselected from 41%), which no roster key\n    # takes. Its first rank, --surface-color-foreground-radio-selected, is not\n    # declared: the surface family mints channels for the checkmark and the\n    # unselected fill only.\n    appearance.border.color@selected: color.foreground.radio.selected\n    appearance.border.color@focus: color.focusRing\n    appearance.outline.style@focus: none\n    appearance.border.color@disabled: color.border.disabled\n    appearance.background@disabled: color.foreground.radio.unselected.disabled\n    interaction.cursor: pointer\n    interaction.cursor@disabled: not-allowed\n    motion.property: background-color, border-color\n    # Not bound: the transition duration reads --motion-duration-fast; the focus\n    # ring is a box-shadow at color.focusRing; and a hovered selected radio\n    # repaints the gradient from --hover--color-foreground-radio-selected, a\n    # computed state variable that is not a symbol and would need a compound\n    # state in any case.";
    ds:anatomyClassic "";
    ds:usage "The mutually-exclusive single-choice entry part a host places in context when exactly one option must win from a small set.\n\n### When to use\n- A host presents a short, fully visible set of options where only one may be chosen.\n- Seeing all options side by side aids the decision.\n\n### When not to use\n- Several choices may be active at once — compose **CheckboxInput**.\n- The option set is long or searchable — compose **SelectInput** or **ComboboxInput**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "size.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.foreground.radio.unselected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.foreground.radio.unselected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.radio.unselected.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "selected";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.radio.selected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.radio_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.radio.unselected.disabled
    ].
