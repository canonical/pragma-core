@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.switch_input a ds:Subcomponent;
    ds:name "SwitchInput";
    ds:summary "The atomic on/off toggle part a host places in context, carrying the binary state and the user's flip interaction; consumed by components such as SwitchField. Not used on its own.";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global-form\n# src/lib/subcomponent/SwitchInput/styles.css on .ds.form-switch and its ::before\n# knob. A checkbox with role=\"switch\" styled as a sliding pill: the track is the\n# <input> box, the knob is a pseudo-element that slides from one end to the\n# other.\nnode:\n  uri: global.subcomponent.switch_input\n  styles:\n    appearance.native: none\n    layout.boxSizing: border-box\n    layout.position: relative\n    # margin-inline reads --form-label-padding-inline, undeclared, falling back\n    # to 0: the control aligns to the field edge like the label.\n    spacing.external.inline.start: 0\n    spacing.external.inline.end: 0\n    # A 32x16 track: fixed element sizes, deliberately NOT baseline multiples.\n    # The track carries no border, so width and height are the exact track box\n    # and the absolutely-positioned knob is measured against the same box.\n    size.width: dimension.400\n    size.height: dimension.200\n    appearance.radius: dimension.radius.full\n    # The unselected track prefers --surface-color-foreground-switch-unselected,\n    # which no stratum declares (the surface family mints the switch knob channel\n    # alone), so only the flat token is written.\n    appearance.background: color.foreground.switch.unselected\n    # Selected, the track reads --surface-color-foreground-switch-selected first,\n    # which no stratum declares (the surface family mints the knob channel only).\n    appearance.background@selected: color.foreground.switch.selected\n    appearance.background@disabled: color.foreground.switch.unselected.disabled\n    appearance.outline.style@focus: none\n    interaction.cursor: pointer\n    interaction.cursor@disabled: not-allowed\n    motion.property: background-color\n    # Not bound, and why:\n    # - the transition duration reads --motion-duration-fast, undeclared;\n    # - the focus ring is a box-shadow at color.focusRing, which no roster key\n    #   takes;\n    # - hover shifts only the track, from --hover--color-foreground-switch-\n    #   unselected / -selected: computed state variables that are not symbols,\n    #   and nothing in either chain resolves;\n    # - a disabled selected track takes color.foreground.switch.selected.disabled,\n    #   which needs a compound state.\n  edges:\n    - node:\n        # drawn as ::before\n        role: knob\n        styles:\n          layout.position: absolute\n          # Inset 1px from the track edges (--switch-knob-inset, a literal the\n          # component writes). The knob's own size is a calc() over the track\n          # height and that inset, so it is not bound.\n          # The start inset is written logically (inset-inline-start); the roster's\n          # logical offset key takes a token only, so the literal goes on the\n          # physical key.\n          layout.offset.top: 1px\n          layout.offset.bottom: 1px\n          layout.offset.left: 1px\n          appearance.radius: dimension.radius.full\n          appearance.background: [surface.color.foreground.switch.knob, color.foreground.switch.knob]\n          appearance.background@disabled: color.foreground.switch.knob.disabled\n          # Selected, the knob translates to the far edge by the space left over\n          # after the knob and both insets — a calc(), and `translate` has no\n          # value key of its own.\n          motion.property: translate\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "The instant on/off entry part a host places in context for a single setting that takes effect immediately.\n\n### When to use\n- A host toggles one binary setting whose change applies at once, like enabling a mode.\n- The choice reads as turning something on or off rather than ticking a list.\n\n### When not to use\n- The choice is one of several that may each be selected — compose **CheckboxInput**.\n- Exactly one option must win from a set — compose **RadioInput**.";
    ds:guidelines "";
    ds:tier ds:global;
    ds:documentationStage ds:tag.needsdefinition;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "size.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.400
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "size.height";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.full
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.unselected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "selected";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.selected
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.unselected.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.radius";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.radius.full
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:surface.color.foreground.switch.knob
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.foreground.switch.knob
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.subcomponent.switch_input;
        ds:node "$root/knob";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.switch.knob.disabled
    ].
