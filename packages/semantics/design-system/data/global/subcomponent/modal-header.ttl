@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global.subcomponent.modal-header a ds:Subcomponent;
    ds:name "Modal.Header";
    ds:summary "";
    ds:anatomyDsl "---\n# Authored 2026-09-13 from @canonical/react-ds-global\n# src/lib/pattern/Modal/common/Header/styles.css on .ds.modal-header and its\n# child selectors (::after, > .title, > .close).\nnode:\n  uri: global.subcomponent.modal-header\n  styles:\n    layout.type: flex\n    layout.direction: row\n    layout.align: center\n    layout.justify: space-between\n    # Never shrink: only the content pane gives way.\n    layout.flex.grow: 0\n    layout.flex.shrink: 0\n    layout.flex.basis: auto\n    # Positions the inset rule below.\n    layout.position: relative\n    # The inline padding --modal-padding-inline is shared with the content and\n    # the footer, so title, rules, content and actions align on the same two\n    # edges.\n    spacing.gap: dimension.200                    # --modal-header-gap, the inline gap between title and dismiss\n    spacing.internal.block.start: dimension.200   # --modal-header-padding-block, a surface inset\n    spacing.internal.block.end: dimension.200     # --modal-header-padding-block, a surface inset\n    spacing.internal.inline.start: dimension.300  # --modal-padding-inline, a surface inset\n    spacing.internal.inline.end: dimension.300    # --modal-padding-inline, a surface inset\n  edges:\n    - node:\n        role: title\n        styles:\n          layout.flex.grow: 1\n          layout.flex.shrink: 1\n          layout.flex.basis: 0%\n          # Only the composite's font-size facet is read\n          # (--typography-text-primary-font-size); typography.size admits\n          # dimension.* alone, so the composite carries it here.\n          typography.font: typography.text.primary\n          typography.weight: typography.weight.semiBold\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        uri: global.component.button\n        props:\n          icon: close\n        styles:\n          layout.flex.grow: 0\n          layout.flex.shrink: 0\n          layout.flex.basis: auto\n          # The dismiss control equalises Button's own inline padding through the\n          # component's custom-property API — --button-padding-inline-start and\n          # -end both to dimension.100 — because Button tightens the start side\n          # when it carries an icon and an icon-only button then reads lopsided.\n          # The dimension is what the override writes, and writing the action\n          # inset role instead would assert the very padding it exists to change.\n          spacing.internal.inline.start: dimension.100  # --button-padding-inline-start\n          spacing.internal.inline.end: dimension.100    # --button-padding-inline-end\n          # The implementation also sets importance=\"tertiary\" on this Button.\n          # That is not pinned: `importance` is a modifier family Button\n          # consumes (ds:hasModifierFamily), not one of its ds:hasProperty\n          # names, and a pin asserts a prop value.\n      relation:\n        cardinality: \"0..1\"\n    - node:\n        role: divider rule\n        styles:\n          layout.position: absolute\n          # Inset to the header's own inline padding so it aligns with the\n          # title, the content and the actions. inset-block-end is a raw 0,\n          # which the block-axis offset keys take a token only for.\n          layout.offset.inline.start: dimension.300\n          size.block: dimension.stroke.thickness.medium\n          appearance.background: color.border.muted\n          # The first of the two rules bounding the content. Drawn as ::after\n          # rather than a border so it can be inset to the header's inline\n          # padding and align with the title, the content and the actions.\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
