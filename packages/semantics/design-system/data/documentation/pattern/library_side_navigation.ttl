@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:documentation.pattern.library_side_navigation a ds:Pattern;
    ds:name "LibrarySideNavigation";
    ds:summary "This component is the side navigation (SN) implemented for the [Canonical Reference Library](library.canonical.com). The way this component works it shows a side navigation tree that starts in a single root and it should show folders and files on each of their respective level.  The SN should start with all folder close showing just a single level, but when extended it should be able to show up to 6 levels of depth. The side navigation should let the user navigate using the arrows without loading a new page until the user click a specific tittle. The SN should be able to render an infinite level of depth, they way this works with the max 6 level rendering is that if there is a 7th level, the first level is hidden showing only from 2-7. On the folder component you can group files and folders underneath, you can have a custom sorting or an alphabetical sorting and can implement soft roots (When an specific folder is selected it hides the rest of the navigation and focus only on that folder and the children)\n\nMain functionalities:\n\n- show navigation tree \n- It need to render at the most 6 level of depth \n- infinite level of depth → implies if a seventh level is shown you hide the first\n- Grouping per folders\n- Sorting (custom and alphabetically) \n- Soft roots: When an specific folder is selected it hides the rest of the navigation and focus only on that folder and the children \n\nUse case:\n\n- The [canonical reference library](library.canonical.com)\n\n";
    ds:anatomyDsl "";
    ds:anatomyClassic "{\"Name\":\"24.10 Reference library - Miscellaneous - Document\",\"Image\":{\"type\":\"imageurlref\",\"url\":\"https://figma-alpha-api.s3.us-west-2.amazonaws.com/images/7dc64e31-73ed-4145-9907-db5e80192b48\",\"outline\":true},\"Url\":{\"type\":\"urlref\",\"url\":\"https://www.figma.com/design/ALPF8OuP9WEOzG6sSgs9PW/24.10-Reference-library---Miscellaneous?node-id=275-7841&t=fRR4OHksermBG2BN-0\",\"name\":\"\"},\"Modified\":{\"type\":\"dt\",\"input\":\"9/1/2025 10:47:41 AM\",\"epoch\":1756716461,\"formatted\":\"9/1/2025\"},\"ModifiedBy\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Figma\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b41ea5bb2cbd89cf1620699952746936?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_f_v2.png\",\"outline\":true}}},\"Comments\":{\"type\":\"arr\",\"value\":[{\"type\":\"obj\",\"value\":{\"Message\":\"20 per page\",\"Id\":\"1398774587\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"8/26/2025 5:21:17 PM\",\"epoch\":1756221677.304,\"formatted\":\"8/26/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"add filters\",\"Id\":\"1398774360\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"8/26/2025 5:21:11 PM\",\"epoch\":1756221671.11,\"formatted\":\"8/26/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"fantasy buttons\",\"Id\":\"1340064023\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"diana.stanciulescu\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/931c9153-7226-4d71-8017-a9f08186ded9\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/15/2025 1:20:00 PM\",\"epoch\":1752578400.121,\"formatted\":\"7/15/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"this feels weird\",\"Id\":\"1340049846\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"diana.stanciulescu\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/931c9153-7226-4d71-8017-a9f08186ded9\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/15/2025 1:12:10 PM\",\"epoch\":1752577930.821,\"formatted\":\"7/15/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"I have kept pagination similar to the current standard [here](https://vanillaframework.io/docs/patterns/pagination) and aligned it to the right\",\"Id\":\"1338708135\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/14/2025 6:21:18 PM\",\"epoch\":1752510078.17,\"formatted\":\"7/14/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"I have preserved this url from the docs results pages. These would help the user identify where in the hierarchy the page sits.\",\"Id\":\"1338706585\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/14/2025 6:20:10 PM\",\"epoch\":1752510010.763,\"formatted\":\"7/14/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"This link is to the original google doc, so that anyone with permissions can add a description to the metadata of the file.\",\"Id\":\"1338705612\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/14/2025 6:19:26 PM\",\"epoch\":1752509966.479,\"formatted\":\"7/14/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"@diana.stanciulescu I have added these tags to follow the example of search results in support portal. Do you think this is the correct spacing?\",\"Id\":\"1338704776\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/14/2025 6:18:51 PM\",\"epoch\":1752509931.282,\"formatted\":\"7/14/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"tag, last reviewed date and make the title a link too\",\"Id\":\"1337877236\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/14/2025 10:40:07 AM\",\"epoch\":1752482407.571,\"formatted\":\"7/14/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"proposed scale: font size increases +rhythm of regular/bold at 3 font-sizes\",\"Id\":\"1310271403\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/23/2025 7:08:15 PM\",\"epoch\":1750698495.792,\"formatted\":\"6/23/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"From the meeting:\\n* bold and italics at the body font size reserved for inline emphasis\\n* small caps/uppercase not an option due to the fact case alters meaning in code.\",\"Id\":\"1310271023\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/23/2025 7:07:57 PM\",\"epoch\":1750698477.397,\"formatted\":\"6/23/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"possible compromise\",\"Id\":\"1310209293\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/23/2025 6:22:53 PM\",\"epoch\":1750695773.68,\"formatted\":\"6/23/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"indentation not liked - paragraph spacing prefered\",\"Id\":\"1310209105\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/23/2025 6:22:45 PM\",\"epoch\":1750695765.711,\"formatted\":\"6/23/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"case is not an option - as it matters for code so we can;'t use it\",\"Id\":\"1310208621\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/23/2025 6:22:24 PM\",\"epoch\":1750695744.953,\"formatted\":\"6/23/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"The spacing between the line and the text is too tight\",\"Id\":\"1087417318\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"1/10/2025 2:52:17 PM\",\"epoch\":1736517137.198,\"formatted\":\"1/10/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"The vertical line goes only until the top of \\\"On this page\\\"\",\"Id\":\"1087416905\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"1/10/2025 2:52:00 PM\",\"epoch\":1736517120.491,\"formatted\":\"1/10/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"This should be aligned to the left and is missing a yellow line on the left border\",\"Id\":\"1087416353\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"1/10/2025 2:51:38 PM\",\"epoch\":1736517098.598,\"formatted\":\"1/10/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"This tag should go under the title and the breadcrumb is missing\",\"Id\":\"1087415759\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"1/10/2025 2:51:13 PM\",\"epoch\":1736517073.595,\"formatted\":\"1/10/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"This search bar doesn't look like the vanilla component\",\"Id\":\"1087415275\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"1/10/2025 2:50:54 PM\",\"epoch\":1736517054.479,\"formatted\":\"1/10/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"The font is too small on the side nav. Should be 1rem @Nicolas Bello\",\"Id\":\"1087414878\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"1/10/2025 2:50:38 PM\",\"epoch\":1736517038.397,\"formatted\":\"1/10/2025\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"@Lyubomir Popov do you reckon the search is too close to the top? feels incredibly tight.\",\"Id\":\"880667702\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Daniel Mutis\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5178a688-28d4-4278-b488-8cc31f0f544b\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/19/2024 10:37:13 AM\",\"epoch\":1721378233.937,\"formatted\":\"7/19/2024\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"Can search go below the side nav button?\"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"It will likely need to be in the same container as breadcrumbs/title.\"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"876084349\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Bartek\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/3143c7995b1f1283f9b73c186f707f96?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_b_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/16/2024 3:27:47 PM\",\"epoch\":1721136467.154,\"formatted\":\"7/16/2024\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"@Bartek this is meant to be fixed position at the bottom\",\"Id\":\"875966446\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/16/2024 2:21:13 PM\",\"epoch\":1721132473.231,\"formatted\":\"7/16/2024\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"@Daniel Mutis, @Bartek something like this?\",\"Id\":\"875908651\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Lyubomir Popov\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/b1343048a74133b44f6662c5b0582b6f?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_l_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/16/2024 1:43:59 PM\",\"epoch\":1721130239.187,\"formatted\":\"7/16/2024\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"Does search need to span across the width of 2 columns?\"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"Current documentation layout doesn't support that. We have 3 columns: left for side nav, main for content, right for table of contents. \"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"Search was initially planned to be above main content only - not span across. This changes the layout in a significant way.\"}],\"id\":\"cl-2\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"875888840\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Bartek\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/3143c7995b1f1283f9b73c186f707f96?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_b_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/16/2024 1:30:35 PM\",\"epoch\":1721129435.511,\"formatted\":\"7/16/2024\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"Why are chevrons moved to the left?\"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"If the side navigation is expandable \\\"documentation style\\\", the expand buttons are on the right per current component.\"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"We have chevrons on the left in accordion navigation, but this is not what they initially wanted (because it only supports expanding, not navigating).\"}],\"id\":\"cl-2\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"Is this expandable, or accordion nav?\"}],\"id\":\"cl-3\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"875881542\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Bartek\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/3143c7995b1f1283f9b73c186f707f96?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_b_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/16/2024 1:25:45 PM\",\"epoch\":1721129145.558,\"formatted\":\"7/16/2024\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"This is so different from current full width documentation layout, that it looks like a new layout completely TBH.\",\"Id\":\"875879835\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Bartek\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://www.gravatar.com/avatar/3143c7995b1f1283f9b73c186f707f96?size=240&default=https%3A%2F%2Fs3-alpha.figma.com%2Fstatic%2Fuser_b_v2.png\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"7/16/2024 1:24:34 PM\",\"e