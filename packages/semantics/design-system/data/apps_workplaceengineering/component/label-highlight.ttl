    ds:hasSubcomponent ds:apps_workplaceengineering.component.label-highlight, ds:apps_workplaceengineering.component.complex_multi_select;
    ds:changeLog [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-02-19T00:00:00.000+01:00";
