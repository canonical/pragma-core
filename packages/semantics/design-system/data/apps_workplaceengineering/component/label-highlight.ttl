    ds:anatomyClassic "Anatomy is WIP, current look: \n\n  \nFigma file reference (WIP as of 19 feb 2026): [link](https://www.figma.com/design/PWvbBHNoPeCIyhWWvJ6uvN/26.04-Promotion-tool---Historical-applications?node-id=12738-8830&t=SUMGjIyfz79K6FOQ-1)";
    ds:usage "Usage example (WIP UI as per 19 feb 2026): \n\n\n\n\n\n";
    ds:guidelines "";
