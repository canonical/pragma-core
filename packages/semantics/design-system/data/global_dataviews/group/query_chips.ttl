@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global_dataviews.group.query_chips a ds:Group;
    ds:name "QueryChips";
    ds:summary "QueryChips is the set of clauses that narrow a collection, each shown as one query chip. It lays the chips out in a wrapping row and gives the set one accessible name. It serves the filters and search of a query bar, the conditions of a saved view and the matchers of a rule. It holds query chips and nothing else.";
    ds:anatomyDsl "---\n# TODO implementation: no reference in @canonical/react-ds-global or react-ds-global-form\n# A Group is a set of sibling blocks whose collection carries its own identity. This one\n# holds query chips and nothing else: a query bar's entry and its other controls are\n# siblings of the group, not members.\nnode:\n  uri: global_dataviews.group.query_chips\n  styles:\n    layout.type: flex\n    layout.wrap: wrap\n    layout.align: center\n    # A <ul role=\"list\">: the explicit role keeps the list's semantics where a list\n    # without bullets would lose them.\n    layout.listStyle: none\n    # 8 px between chips, so a focused chip's ring, which reaches 5 px past it, never draws\n    # over its neighbour.\n    spacing.gap: dimension.100\n    spacing.internal.block.start: 0\n    spacing.internal.block.end: 0\n    spacing.internal.inline.start: 0\n    spacing.internal.inline.end: 0\n    spacing.external.block.start: 0\n    spacing.external.block.end: 0\n  edges:\n    - node:\n        uri: global_dataviews.component.query_chip\n      relation:\n        cardinality: \"1..*\"\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "### When to use\n\n- Several clauses apply together, and each must stay readable and editable on its own.\n\n### When not to use\n\n- One clause only, read-only: use **Tag**.\n- Dismissible values picked from one set, such as the values of a multi-select: use  \n**ComboboxInput**’s selected values or **Chip**.\n- Applied filters that are only summarised and removed, never edited: **Chip** with a dismiss  \ncontrol is enough.";
    ds:guidelines "### Accessibility\n\n- The group is a list: a `<ul role=\"list\">` with one `<li>` per chip. The explicit role keeps  \nthe list’s semantics in browsers that drop them from a list without bullets.\n- Exactly one of `label` and `aria-labelledby` names the list.\n- The container that hosts the group decides the keyboard model and carries its composite role.  \nA QueryInput makes its chips and its entry one roving tab stop inside a toolbar. The group  \nitself handles no keys.\n- The gap between chips is not a target; nothing is inserted between chips.\n\n### Layout\n\n- Chips wrap. A host that must hold one line clips and fades the overflow, and says how many  \nchips are hidden.";
    ds:tier ds:global_dataviews;
    ds:documentationStage ds:tag.needstriage;
    ds:hasProperty [
        a ds:Property;
        ds:name "label";
        ds:summary "The accessible name of the set.";
        ds:propertyType "text";
        ds:optional "true";
        ds:constraints "```required unless `aria-labelledby` is given, and not given with it```"
    ], [
        a ds:Property;
        ds:name "children";
        ds:summary "The query chips.";
        ds:propertyType "node";
        ds:optional "false";
        ds:constraints "one or more query chips"
    ];
