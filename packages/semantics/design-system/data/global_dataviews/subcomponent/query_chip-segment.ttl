@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:global_dataviews.subcomponent.query_chip-segment a ds:Subcomponent;
    ds:name "QueryChip.Segment";
    ds:summary "One settled part of a query chip, such as its field, its operator or its value: a piece of text with its own fill, which can be activated on its own; under the default `separated` unity it is also hovered and marked invalid on its own. The host composes one Segment for each settled part.";
    ds:anatomyDsl "---\n# TODO implementation: no reference in @canonical/react-ds-global or react-ds-global-form\n# Tone: a Segment reads the modifier channels. The host sets the operator Segment's\n# `condition`. Each Condition value is to have its own positions, which are to alias at\n# first to two tones:\n# Inclusion, Match, Range and Presence to the Information symbols, and Exclusion to a\n# negation tone of its own. No semantic negation symbol exists yet, so that tone is a\n# stand-in from the teal palette primitives, light and dark, which the Condition\n# specification lists. The invalid state binds the error symbols directly.\n# Element: once scripts run, and when it has onActivate, a Segment is a native <button>, so a\n# click, Enter or Space activates it. Otherwise, and before scripts run, it is plain text;\n# when its label differs from its text, the text is aria-hidden and the label is visually\n# hidden text beside it. It draws no focus ring of its own: the chip's body draws one ring\n# around the clause while focus is within it.\n# Selected: a selected chip sets @selected on all its Segments. Under `joined`, the chip's\n# hover and invalid reach every Segment the same way, from the chip's data attributes.\n# Refused: the chip's Criticality value is `error` and its Segments carry no Condition\n# value, so the channels give every Segment the error tone; Error's glyph shows on the first\n# Segment. Other Criticality values tint only. Invalid: the Segment at fault takes\n# @invalid, which wins over the channels, and shows the glyph.\n# Hover and the text cursor apply only while the Segment is a button.\nnode:\n  uri: global_dataviews.subcomponent.query_chip-segment\n  styles:\n    layout.type: inline-flex\n    layout.align: center\n    # 24 by 24 px at least, whatever the text, so a one-glyph operator is a full target.\n    size.min.width: dimension.300\n    size.min.height: dimension.300\n    layout.justify: center\n    # A native <button> does not inherit the chip's font, so it is set here.\n    typography.font: typography.text.secondary\n    # 6 px, which no symbol declares. --query-chip-segment-padding-inline\n    spacing.internal.inline.start: 0.375rem\n    spacing.internal.inline.end: 0.375rem\n    spacing.internal.block.start: dimension.025\n    spacing.internal.block.end: dimension.025\n    interaction.cursor: text\n    # The secondary fills have no Surface positions yet, so the fill does not follow the\n    # layer beneath the chip. --query-chip-segment-background\n    appearance.background: [modifier.color.foreground.secondary, color.foreground.secondary]\n    appearance.background@hover: color.foreground.secondary.hover\n    # @selected is drawn from a data attribute, never aria-selected, which a button does\n    # not support; selection reaches assistive technology through focus.\n    appearance.background@selected: color.foreground.secondary.active\n    appearance.background@disabled: color.foreground.secondary.disabled\n    appearance.background@invalid: color.foreground.secondary.error\n    # --query-chip-segment-text\n    typography.color:\n      - modifier.color.text.onForegroundSecondary\n      - color.text.onForegroundSecondary\n    typography.color@disabled: color.text.onForegroundSecondary.disabled\n    typography.color@invalid: color.text.onForegroundSecondary.error\n  edges:\n    - node:\n        # Present on the Segment at fault of an invalid chip, and on the first Segment of a\n        # refused chip, only. The glyph follows the modifier, as the colours do: Criticality\n        # Error's own glyph is `error`, and @canonical/styles maps each Criticality value to\n        # the glyph of the same name. No channel carries a glyph yet, so the Error value's\n        # glyph is written here until one does.\n        uri: global.component.icon\n        props:\n          icon: error\n        styles:\n          size.width: dimension.200\n          size.height: dimension.200\n          typography.color: color.icon.onForegroundSecondary.error\n          spacing.external.inline.end: dimension.050\n      relation:\n        cardinality: \"0..1\"\n    - node:\n        # Present on a Segment with a `condition`, before its text, for every Condition\n        # value. Its glyph is the Condition value's; no channel carries a glyph yet, so only\n        # colour is bound. No channel routes the on-secondary icon symbols per value yet, so\n        # the colour is the paired symbol. aria-hidden: the Segment's label speaks the\n        # operator.\n        role: condition mark\n        styles:\n          size.width: dimension.200\n          size.height: dimension.200\n          typography.color: color.icon.onForegroundSecondary\n          spacing.external.inline.end: dimension.050\n      relation:\n        cardinality: \"0..1\"\n    - node:\n        role: segment text\n        styles:\n          typography.overflow: ellipsis\n      relation:\n        cardinality: \"1\"\n        slotName: default\n    - node:\n        # The `label`, as visually hidden text, while the Segment is plain text and its\n        # label differs from its text; the text is then aria-hidden.\n        role: spoken label\n      relation:\n        cardinality: \"0..1\"\n    - node:\n        # The `description`, as an element with the `hidden` attribute and an id. The\n        # aria-describedby of the invalid Segment, the first Segment and a refused read-only\n        # chip's remove control still resolves it, while the Segment's name from content and\n        # browse mode skip it, so it never joins the button's name.\n        role: description\n      relation:\n        cardinality: \"0..1\"";
    ds:anatomyClassic "";
    ds:usage "### When to use\n\n- Inside a QueryChip, for each part that is not being typed.\n\n### When not to use\n\n- For the part being typed or edited: use **QueryChip.Entry**.\n- On its own. A lone piece of interactive text is a **Chip**.";
    ds:guidelines "### Accessibility\n\n- Once scripts run, and when it has `onActivate`, a Segment is a native button named by its  \ntext, or by its `label` when one is given. Otherwise, and before scripts run, it is plain  \ntext; when its `label` differs from its text, the text is `aria-hidden` and the label renders  \nbeside it as visually hidden text, so a symbol such as `≥` is spoken as “at least”.\n- A Segment with a `condition` shows that Condition value’s mark before its text. The mark is  \nhidden from assistive technology, because the `label` speaks the operator.\n- Inside a roving composite, the chip’s first Segment is the chip’s toolbar item and takes  \n`tabindex=\"0\"` only while it holds the tab stop; every other Segment button takes  \n`tabindex=\"-1\"`, reached by Enter on the chip, then Tab.\n- Each Segment button is at least 24 by 24 px, whatever its text, so a one-glyph operator such  \nas `≥` is still a full target.\n- An invalid Segment carries its state in its accessible description, through  \n`aria-describedby` on its `description`, because `aria-invalid` does not apply to a button.  \nThe `description` renders as a `hidden` element, which `aria-describedby` still resolves, so  \nit never joins the Segment’s name from content or reads inline in browse mode.  \nWhile it is invalid, the chip’s first Segment is described by it too.\n\n### States & interaction\n\nA Segment is default, hovered, selected, invalid or disabled. It is selected when its chip is  \nselected, and disabled when its chip is disabled. Its tone comes from its `condition`, or from  \nthe chip’s Criticality value, which tints every Segment; Error also marks the chip refused. Its  \nown `@invalid` state wins over either. Every transition belongs to the host.";
    ds:tier ds:global_dataviews;
    ds:documentationStage ds:tag.needstriage;
    ds:hasModifierFamily ds:global_dataviews.modifier_family.condition;
    ds:parentComponent ds:global_dataviews.component.query_chip;
