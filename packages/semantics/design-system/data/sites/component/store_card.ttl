ated\":{\"type\":\"dt\",\"input\":\"6/17/2026 3:44:34 PM\",\"epoch\":1781703874.407,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"what happens if we get rid of categories\",\"Id\":\"1807101669\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 3:38:56 PM\",\"epoch\":1781703536.476,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"make small rock card like this / instead of machine, fips?\",\"Id\":\"1807057659\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 3:19:15 PM\",\"epoch\":1781702355.191,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"even with download it is not too bad\",\"Id\":\"1806823666\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 1:18:14 PM\",\"epoch\":1781695094.329,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Kola would prefer starting there, less wasted space\",\"Id\":\"1806822967\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 1:17:51 PM\",\"epoch\":1781695071.739,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Because you can click on the publisher to see other things under this publisher, this should be clearer you can interact with it, and the whole card cannot be clickable.\",\"Id\":\"1806814640\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 1:13:10 PM\",\"epoch\":1781694790.065,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"the indent there is odd\",\"Id\":\"1806811154\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 1:11:11 PM\",\"epoch\":1781694671.19,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"indicate interaction by changing background color?\",\"Id\":\"1806800745\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 1:05:09 PM\",\"epoch\":1781694309.74,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"making any of these clickable might prompt people to think that clcking would reshape the list to show more of the listings with the same characteristics\",\"Id\":\"1806793486\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 1:00:49 PM\",\"epoch\":1781694049.325,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Also need a max size number\",\"Id\":\"1806771619\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 12:48:46 PM\",\"epoch\":1781693326.33,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"would need amax chip width to make sure it doesn't cut off weird\",\"Id\":\"1806770937\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 12:48:26 PM\",\"epoch\":1781693306.004,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"this placement helps with keeping info in same place and less risk of having to truncate title\",\"Id\":\"1806761306\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 12:43:09 PM\",\"epoch\":1781692989.744,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"when the card shortened, you need to make a choice of how to shorten the toitle and keep the element at the top\",\"Id\":\"1806760316\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/17/2026 12:42:34 PM\",\"epoch\":1781692954.045,\"formatted\":\"6/17/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"icon representation of:\\n* machines\\n* virtual machine\\n* server\",\"Id\":\"1803291192\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/15/2026 4:59:00 PM\",\"epoch\":1781535540.839,\"formatted\":\"6/15/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"https://github.com/cncf/artwork/tree/main/projects/kubernetes\",\"Id\":\"1803290739\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/15/2026 4:58:46 PM\",\"epoch\":1781535526.93,\"formatted\":\"6/15/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"there wasn't a yaru component for those, so implemented the minimal amount\",\"Id\":\"1801041263\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 3:12:33 PM\",\"epoch\":1781269953.957,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"should we be grouping static vs dynamic information together? should they be separate?\",\"Id\":\"1800833454\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 12:33:43 PM\",\"epoch\":1781260423.659,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"could I present 200 on a single page.. would it be advantageous to hide logo then for rendering?\",\"Id\":\"1800659120\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:47:07 AM\",\"epoch\":1781254027.304,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"What does this look like to a screen reader, how can the reader click tooltip links?\"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"If we had 1000's of charms, how dense could it be?\"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"1800657923\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:46:27 AM\",\"epoch\":1781253987.415,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"WWBA?\",\"Id\":\"1800635164\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:33:12 AM\",\"epoch\":1781253192.49,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Why is this 'Canonical' (team?) and a solution has 'Canonical Observability' ?\",\"Id\":\"1800622985\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:26:17 AM\",\"epoch\":1781252777.11,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"What does 'charmed' add?\",\"Id\":\"1800617778\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:23:15 AM\",\"epoch\":1781252595.016,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Title case?\",\"Id\":\"1800612503\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:20:13 AM\",\"epoch\":1781252413.588,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Why do these ones have 'Canonical' what does it add?\",\"Id\":\"1800611289\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:19:31 AM\",\"epoch\":1781252371.775,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"Can the title have the word 'solution'?\\nThey're all solutions... why not just 56 Telco\",\"Id\":\"1800610755\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/12/2026 10:19:12 AM\",\"epoch\":1781252352.684,\"formatted\":\"6/12/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"@Miguel Divo are these meant to be clickable? Let's discuss what signals interactivity + explore less colourful option to reduce the visual noise :)\",\"Id\":\"1798780225\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/11/2026 10:44:09 AM\",\"epoch\":1781167449.179,\"formatted\":\"6/11/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"featued snap\",\"Id\":\"1796771485\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/10/2026 10:47:03 AM\",\"epoch\":1781081223.716,\"formatted\":\"6/10/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"color wise the publisher marks clash a bit with the publisher name...\",\"Id\":\"1795263333\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/9/2026 3:09:47 PM\",\"epoch\":1781010587.12,\"formatted\":\"6/9/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"@Miguel Divo would be good to add this too in common maybe?\",\"Id\":\"1795216322\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Leia\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/5d0d2256-562c-4bc9-be14-57a16cf92beb\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/9/2026 2:47:14 PM\",\"epoch\":1781009234.048,\"formatted\":\"6/9/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"hover interactivity?\",\"Id\":\"1791435526\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/5/2026 5:06:42 PM\",\"epoch\":1780672002.786,\"formatted\":\"6/5/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"cve page example: https://ubuntu.com/security/cves?q=\",\"Id\":\"1791291611\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Elaine L\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/1f257a07-c2ff-4e60-90d8-8492f50e6be3\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/5/2026 3:42:31 PM\",\"epoch\":1780666951.21,\"formatted\":\"6/5/2026\"}}}]},\"CommentsCount\":72}\n\n### Prototype\n\n{\"Name\":\"26.10 - Responsive Artefact Store Cards Design - Store\",\"Image\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/thumbnails/13e70bb5-7533-4e99-a79c-77f2166ace2f?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIAQ4GOSFWCY65GOSXI%2F20261108%2Fus-west-2%2Fs3%2Faws4_request&X-Amz-Date=20261108T120000Z&X-Amz-Expires=604800&X-Amz-SignedHeaders=host&X-Amz-Signature=ffb757eddc3ecc3800db13c555bb5d286ce4ac656d5a53aacb1e0dd4324e94cc\",\"outline\":true},\"Url\":{\"type\":\"urlref\",\"url\":\"https://www.figma.com/make/BxGHNr2E8ITJnyQ2xDZHpT/26.10---Responsive-Artefact-Store-Cards-Design---Store?t=wJdduJvRmqxihOU2-1\",\"name\":\"\"},\"Modified\":{\"type\":\"dt\",\"input\":\"9/22/2026 12:26:40 PM\",\"epoch\":1790072800.599,\"formatted\":\"9/22/2026\"},\"ModifiedBy\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Label\":\"2402001065990447170\",\"CommentsCount\":0}\n\nhttps://www.figma.com/design/Fi4HFPeKJd6piB5hVxXWC4/26.10-Stores-card-workshop---Store?node-id=930-8133&t=v8X2YSx4HTg5nhNh-1\n\n1. **Card container**: The single interactive region that contains the result and opens its artefact detail page.\n2. **Body**: The primary content area, separated from the footer by a divider.\n3. **Footer**: The secondary metadata region, separated from the body by a divider.\n4. **Artefact icon**: The 44px visual identifier for the artefact.\n5. **Artefact name**: The primary, link-like identifier. It becomes the visited-link colour after the detail page has been opened.\n6. **Publisher**: The publisher name shown below the artefact name.\n   1. **Publisher status indicator**: An optional status glyph displayed with the publisher according to the relevant store's established standard.\n7. **Descriptor**: A concise, truncated description of the artefact.\n8. **Permanent qualities**: Stable metadata, such as categories, FIPS status, platform, or an LTS badge.\n9. **Fresh qualities**: Frequently changing metadata, such as version, last updated, downloads/deployments, vulnerability status, stars, or solution charms.\n10. **Quality divider**: A vertical divider that groups related quality items without turning the footer into a table.";
    ds:usage "Store cards provide a compact comparison surface for artefacts in a result list. The entire card represents one navigation target.\n\n### **When to use**\n\n**Browse and search results**\n\nUse a grid of Store cards when people need to scan several comparable artefacts and select one to inspect. Place the grid in the main content area beside the store's filtering or navigation column. The card links directly to the artefact detail page.\n\nhttps://www.figma.com/design/Fi4HFPeKJd6piB5hVxXWC4/26.10-Stores-card-workshop---Store?node-id=988-15560&t=v8X2YSx4HTg5nhNh-1\n\n**Cross-store artefact listings**\n\nUse the same skeleton for snaps, rocks, charms, and solutions when metadata differs but the browsing task is the same. Include the identifier, descriptor, categories, and core fresh qualities as the baseline; use the optional quality slots only for metadata meaningful to that artefact type.\n\n**Loading results**\n\nUse the loading variant while result data is being fetched. Preserve the card's dimensions and content hierarchy with placeholder blocks and the existing Snap Store/Charmhub shimmer so the grid does not shift when data arrives.  \n  \nhttps://www.figma.com/design/Fi4HFPeKJd6piB5hVxXWC4/26.10-Stores-card-workshop---Store?node-id=988-15559&t=v8X2YSx4HTg5nhNh-1\n\n### **When not to use**\n\n**Multiple independent actions are needed**\n\nDo not use a fully clickable Store card for an item that needs operational actions such as edit, delete, approve, or configure. This makes the card's navigation target compete with its actions. Use a management list or table with explicit action controls instead.\n\n**The information is not an artefact result**\n\nDo not use it for editorial articles, campaign promotions, or generic navigation links. The card assumes a publisher, artefact identity, descriptor, and store quality metadata. Use the appropriate promotional, article, or navigation pattern instead.\n\n**Full detail or comparison is required**\n\nDo not put long descriptions, exhaustive metadata, or installation controls in the card. They compromise scanability and create unequal card heights. Link to the artefact detail page";
    ds:guidelines "### **States**\n\nThe cards have to following states:\n\n- Default: border visible; body/footer separator visible. \n- Focus: when tabbing through cards, a focus ring appears on the card's border (3px, inner alignment, `color/focusRing/root`).\n- Hover: the card background changes to grey and the outer border is hidden; only the body/footer separator remains visible. There is a slight fade-in/fade-out animation as the cursor enters and leaves the card. Background token: `color/foreground/ghost/hover`.\n- Visited: for returning users, the artefact name changes from black to blue (`color/text/link/visited`) to indicate a card they've already opened.\n- Visited + hover: Both states stack. the visited link colour on the name stays visible while the hover background is applied.\n- Loading (skeleton): while page data is being fetched, a placeholder card is shown with a shimmer animation (reusing the existing Snapstore/Charmhub loading shimmer). Loading block colour: `color/palette/gray/40`.\n\n\n\n**Interaction rules**\n\n- Whole card is clickable and navigates to the artefact's detail page.\n- Specific sub-components may carry their own hover interaction (e.g. revealing a version, or the charm in a solution) when a piece of information is useful but there isn't room to show it in full inline. In those cases the card still shows its hover background because the cursor is over the card.\n\nhttps://www.figma.com/design/Fi4HFPeKJd6piB5hVxXWC4/26.10-Stores-card-workshop---Store?node-id=803-24535&t=v8X2YSx4HTg5nhNh-1\n\n### **Device specification**\n\n**Breakpoints and grid**\n\nUse XL at 1680px and above, L from 1038px to 1679px, M from 620px to 1037px, S from 461px to 619px, and XS at 460px and below. Switch the store layout from six to four columns below 620px.\n\n**Responsive card sizes**\n\nDo not render long cards in M, S, or XS; render them as medium cards. In the M band from 620px to below 800px, promote small cards to medium. Small cards may remain small from 800px to 1037px.\n\n\n\n**Grid capacity and spacing**\n\nShow no more than five rows of cards at once. Small cards have a maximum of three cards per row; medium cards a maximum of two; long cards one. Use 32px column and 24px row gaps for small and medium cards, and a 24px row gap for long cards.\n\n### **Content specification**\n\n**Baseline content**\n\nEvery Store card must include the identifier, descriptor, categories, downloads/deployments, and last updated. Add other qualities only where they support selection.\n\n**Truncation**\n\nTruncate identifiers and descriptors with an ending ellipsis to prevent overflow and preserve visual alignment. Below are the exact maximum line count per text element has available before it truncates with an ending ellipsis:\n\n\n\n**Date compression**\n\nFor constrained small cards with substantial fresh metadata, compress date units dynamically, for example `year` to `yr`, `month` to `mo`, `day` to `d`, `hour` to `hr`, and `minute` to `min`. This is a proposed responsive behaviour and is not in the current prototype.\n\n### **Animation**\n\n**Hover transition**\n\nFade the card background in and out when the pointer enters or leaves. On hover, apply `color/foreground/ghost/hover`, hide the outer border, and retain the body/footer divider. Respect reduced-motion preferences by removing or shortening the fade.\n\n**Loading shimmer**\n\nUse the existing Snap Store/Charmhub shimmer rather than a new animation. Apply `color/palette/gray/40` to loading blocks and respect reduced-motion preferences with a static placeholder treatment.";
    ds:tier ds:sites;
    ds:documentationStage ds:tag.docscomplete;
    ds:hasProperty [
        a ds:Property;
        ds:name "artefact_name";
        ds:summary "Primary artefact identifier and accessible-card label source";
        ds:propertyType "text";
        ds:optional "false";
        ds:constraints "Truncate to the variant's available line limit"
    ], [
        a ds:Property;
        ds:name "artefact_icon";
        ds:summary "Recognisable icon for the artefac.";
        ds:optional "false";
        ds:constraints "44px square in the identifier";
        ds:defaultValue "Default blank icon used currently in stores"
    ], [
        a ds:Property;
        ds:name "publisher_name";
        ds:summary "Artefact publisher";
        ds:propertyType "text";
        ds:optional "false";
        ds:constraints "Truncate with the identifier metadata"
    ], [
        a ds:Property;
        ds:name "publisher_status";
        ds:summary "Publisher status indicator";
        ds:optional "true";
        ds:constraints "Must follow the host store's status standard"
    ], [
        a ds:Property;
        ds:name "descriptor";
        ds:summary "Concise artefact description";
        ds:propertyType "text";
        ds:optional "false";
        ds:constraints "Truncate with an ellipsis to the variant's available line limit"
    ], [
        a ds:Property;
        ds:name "permanent_qualities";
        ds:summary "Stable artefact metadata";
        ds:propertyType "list of objects";
        ds:optional "false";
        ds:constraints "Include categories; add only qualities meaningful to the artefact type";
        ds:defaultValue "Categories"
    ], [
        a ds:Property;
        ds:name "fresh_qualities";
        ds:summary "Frequently updated artefact metadata";
        ds:propertyType "list of objects";
        ds:optional "false";
        ds:constraints "Include downloads/deployments and last updated";
        ds:defaultValue "Version, last updated"
    ], [
        a ds:Property;
        ds:name "size";
        ds:summary "Grid card width variant";
        ds:propertyType "choice";
        ds:optional "false";
        ds:constraints "Responsive rules may change the rendered variant";
        ds:defaultValue "Determined by grid and viewport"
    ], [
        a ds:Property;
        ds:name "loading";
        ds:summary "Replaces content with the loading skeleton";
        ds:propertyType "boolean";
        ds:optional "true";
        ds:constraints "Reuse the existing store shimmer and `color/palette/gray/40`";
        ds:defaultValue "`false`"
    ], [
        a ds:Property;
        ds:name "href";
        ds:summary "Artefact detail-page destination";
        ds:propertyType "url";
        ds:optional "false";
        ds:constraints "The whole card must resolve to one destination"
    ];
    ds:changeLog [
        a ds:ChangeLogEntry;
        ds:timestamp "2026-09-16T00:00:00.000+02:00";
        ds:change "initial contribution draft";
        ds:githubLink "https://github.com/canonical/design-system/issues/77"
    ].
