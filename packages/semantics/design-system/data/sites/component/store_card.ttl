\":1781857533.311,\"formatted\":\"6/19/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"need to prototype with different screen width to ensure responsiveness\"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"when does the card break to the next size \"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"how do lines break? how much footer content react? to shorter and longer screen widths while the card adheres to the col-2 size\"}],\"id\":\"cl-2\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"1810283341\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/19/2026 10:21:42 AM\",\"epoch\":1781857302.293,\"formatted\":\"6/19/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"does this make sense locally (stores) and generally (cards)\",\"Id\":\"1810261344\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Hayden Chambers\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/b02432dd-ee87-4a9d-994c-60371061a4a8\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/19/2026 10:09:08 AM\",\"epoch\":1781856548.578,\"formatted\":\"6/19/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"what goes in the footer vs just above the footer?\"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"dynamic content in the footer? static above the footer?\"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"1810258466\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/19/2026 10:07:24 AM\",\"epoch\":1781856444.63,\"formatted\":\"6/19/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":\"these cards for snaps and charms might work quite well.\",\"Id\":\"1810205186\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-4242-939b-52ef7c903106\",\"outline\":true}}},\"Created\":{\"type\":\"dt\",\"input\":\"6/19/2026 9:34:23 AM\",\"epoch\":1781854463.577,\"formatted\":\"6/19/2026\"}}},{\"type\":\"obj\",\"value\":{\"Message\":{\"type\":\"slate\",\"root\":{\"children\":[{\"alignment\":\"Left\",\"children\":[{\"text\":\"i link this approach of having +2 to indicate the artefact belongs to multiple categories \"}],\"id\":\"cl-0\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"maybe we should only display one category and include +1 if it includes 2 (as 2 categories per artefact is the maximum as discussed with the store team)\"}],\"id\":\"cl-1\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"question becomes which category get display and which one is represented by +1\"}],\"id\":\"cl-2\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"},{\"alignment\":\"Left\",\"children\":[{\"text\":\"+1 should be hoverable for users to know what the other category is\"}],\"id\":\"cl-3\",\"lineLevel\":0,\"style\":\"Paragraph\",\"type\":\"Line\"}]}},\"Id\":\"1810193464\",\"User\":{\"type\":\"obj\",\"value\":{\"Handle\":\"Miguel Divo\",\"Avatar\":{\"type\":\"imageurlref\",\"url\":\"https://s3-alpha.figma.com/profile/a66fc895-d1cf-