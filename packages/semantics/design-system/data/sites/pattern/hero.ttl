@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites.pattern.hero a ds:Pattern;
    ds:name "Hero";
    ds:summary "A hero is the prominent banner at the top of a page. It captures attention on arrival with a title, supporting copy, a call to action and a visual.";
    ds:anatomyDsl "---\n# DRAFT, authored from the spec (specs/sites.pattern.hero.md) and the Figma export\n# of the Hero frame (variants Hero/25-75, /Tablet, /Mobile, Hero/50-50), not from an\n# implementation: no reference build exists. Not yet run through\n# `anatomies validate --authored`.\n# This anatomy fixes the 25/75 signpost skeleton at Large; 50/50 and the Tablet and\n# Mobile stacking are layout variations of the same slots, described in the spec.\nnode:\n  uri: sites.pattern.hero\n  styles:\n    layout.type: flex\n    layout.direction: column\n    # Figma frame padding is 24px top, 64px bottom. 64px is 4rem, which is\n    # spacing.inset.strip.block. The 24px top has no matching inset symbol, so it is unbound.\n    spacing.internal.block.end: spacing.inset.strip.block\n\n  edges:\n    - node:\n        # The row holding the visual column and the content column (Figma: \"row p-section is-shallow\").\n        role: columns\n        styles:\n          layout.type: flex\n          layout.direction: row\n          layout.align: flex-start\n          # Figma gap is 32px (2rem); no spacing symbol carries it, so the literal is written.\n          spacing.gap: 2rem\n        edges:\n          - node:\n              # Narrow 25% column. Holds a logo or small image associated with the title.\n              # No image-container block exists in the graph, so this is a role, not a uri.\n              role: visual\n            relation:\n              cardinality: \"0..1\"\n              slotName: media\n\n          - node:\n              role: content\n              styles:\n                layout.type: flex\n                layout.direction: column\n                spacing.gap.block: spacing.gap.group.block\n              edges:\n                - node:\n                    uri: global.component.heading\n                    props:\n                      # Level 1. The graph's `importance` property is a number standing\n                      # for the heading level; unconfirmed, so check the name before relying on it.\n                      importance: 1\n                  relation:\n                    cardinality: \"1\"\n                    slotName: title\n\n                - node:\n                    uri: global.component.heading\n                    props:\n                      importance: 2\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: subtitle\n\n                - node:\n                    # Vanilla's static \"chip\". Tag, not Chip: Chip is always actionable.\n                    uri: global.component.tag\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: tag\n\n                - node:\n                    # Body copy. No Text/Paragraph block exists, so this is a role.\n                    role: description\n                    styles:\n                      typography.color: [modifier.color.text, color.text]\n                  relation:\n                    cardinality: \"0..*\"\n                    slotName: default\n\n                - node:\n                    # The CTA block. No such block in the graph (Figma still uses the Sites\n                    # library's CTA block), so it is a role. Actions wrap; the gap lives here,\n                    # not as padding on each button.\n                    role: actions\n                    styles:\n                      layout.type: flex\n                      layout.wrap: wrap\n                      spacing.gap: spacing.gap.group.block\n                    edges:\n                      - node:\n                          uri: global.component.button\n                        relation:\n                          cardinality: \"0..1\"\n                          slotName: primary\n\n                      - node:\n                          uri: global.component.button\n                        relation:\n                          cardinality: \"0..*\"\n                          slotName: secondary\n\n                      - node:\n                          # ButtonLink is empty in the graph today.\n                          uri: global.component.button_link\n                        relation:\n                          cardinality: \"0..1\"\n                          slotName: link\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: actions\n            relation:\n              cardinality: \"1\"\n              slotName: default\n      relation:\n        cardinality: \"1\"\n        slotName: default";
    ds:anatomyClassic "";
    ds:usage "### The hero is the prominent banner at the top of a page. It states what the page is  \nabout in one title, supports it with a short description and a visual, and offers one  \nclear next step. It is used once per page, as the first region a visitor sees.\n\n### When to use\n\nUse a hero when the page has to introduce itself and move the visitor to a next step  \nin a single glance. Every use case below shares that intent: orient, then direct.\n\n**Landing page opener**  \nThe visitor arrives from a search, a link or an advert and does not yet know the  \nproduct. The hero names it in the title, adds a subtitle and a short description,  \nand offers one primary action. It sits at the top of the page, above all other  \nsections, and is the only `h1`.\n\n- Image: TODO (annotated screenshot of a released page)\n- Example: TODO (released [ubuntu.com](http://ubuntu.com) landing page)\n\n**Product or campaign page**  \nA page promotes one product, release or campaign. The hero carries the campaign  \nmessage and the primary action (sign up, download, contact). A tag may call out status  \nor availability, such as “Available with Ubuntu Pro”. Secondary actions and a link  \naction may follow the primary one.\n\n- Image: TODO\n- Example: TODO\n\n**Page introduced by a logo or small mark (25/75 signpost)**  \nA small image, such as a partner or product logo, should be associated with the title.  \nIt sits in the narrow column beside the content, which fills the wide column. On  \nsmaller screens the columns stack.\n\n- Image: TODO (Figma variants Hero/25-75, /Tablet, /Mobile)\n- Example: TODO\n\n**Page introduced by a large visual (50/50)**  \nThe image is as important as the text. The visual and the content share the page  \nwidth equally. On smaller screens the columns stack.\n\n- Image: TODO (Figma variant Hero/50-50)\n- Example: TODO\n\n### When not to use\n\n**Promoting content part-way down a page**  \nThe content is a secondary promotion in the middle of a page, introduced with its own  \nheading. A hero here competes with the real page opener and breaks the page’s  \noutline, because it implies a second top-level message.\n\n- Example: TODO (made-up scenario based on a real page)\n- Instead: use `Section` with a `Heading` at the right level.\n\n**Titling a page inside an application**  \nThe page is a working screen, such as a list, a form or a settings page, and needs a  \ntitle for orientation. A hero here takes screen space from the task and adds a call to  \naction nobody needs.\n\n- Example: TODO\n- Instead: use `Heading` for the page title.\n\n**Offering several equal actions**  \nThe banner has two or more actions of equal weight and no clear next step. The visitor  \nhas to choose, and the banner loses its focus.\n\n- Example: TODO\n- Instead: choose one primary action, and demote the rest to secondary actions or a  \nlink action. If they are truly equal, move them into the sections below the hero.\n\n**Carrying long text**  \nThe banner holds several paragraphs of body copy, so the first screen reads as a  \ndocument and the action is pushed out of sight.\n\n- Example: TODO\n- Instead: keep a short description in the hero and move the detail into a `Section`  \nbelow it.\n\n## Context and composition rule\n\n**Context:** a visitor has just landed on a marketing or product page and needs to  \nknow what it is, why it matters and what to do next, in one glance.\n\n**Fixed:** one `Heading` (level 1) as the title; a single primary action; the hero  \nis the first `Section` on the page.\n\n**Varies:** subtitle, tag, description, secondary actions, link action, visual,  \nand the column layout.\n\n**Composition**\n\nTable 83\n\n**Unlike** `PricingSection` and `ReadMoreSection`, which present a set of items,  \nthe hero is a single message with a single action.\n\n**Note on Tag:** Vanilla calls this element a “chip”, but the “Available with Ubuntu  \nPro” label is static. Pragma’s `Chip` is always actionable and `Badge` is for numeric  \nvalues, so `Tag` (non-interactive, categorises or indicates status) is the fit.  \nCheck Tag’s variants cover the pill radius and branded colour. **[confirm with owners]**\n\nVerified against `global.component.tag`: non-interactive pill, optional `icon` slot,  \nrequired `content` slot, modifiers Anticipation, Criticality and Importance. Open items:\n\n- Use `Importance=Primary` for the branded look. There is no Branded variant, and the  \nPrimary colour is unconfirmed. Raise a Branded variant with the owners if Primary doesn’t match.\n- The anatomy binds no radius; `dimension.radius.full` is inferred from the “pill” wording.\n- The entry’s guidelines are empty, and it calls itself a “label” in its summary.\n\n## Layouts in scope\n\nThe four variants in the supplied Figma frame (confirmed from the export):\n\nTable 84";
    ds:guidelines "";
    ds:tier ds:sites;
    ds:hasProperty [
        a ds:Property;
        ds:name "Layout";
        ds:summary "25/75 signpost, 50/50";
        ds:optional "false"
    ], [
        a ds:Property;
        ds:name "Breakpoint";
        ds:optional "false"
    ];
    ds:documentationStage ds:tag.needstriage;
    ds:hasTokenBinding [
        a ds:TokenBinding;
        ds:viaBlock ds:sites.pattern.hero;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.block.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.inset.strip.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:sites.pattern.hero;
        ds:node "$root/columns/content";
        anatomy:styleKey "spacing.gap.block";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.group.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.bold
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root/case[h1]";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.heading.1
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root/case[h2]";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.heading.2
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root/case[h3]";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.heading.3
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root/case[h4]";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.heading.4
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root/case[h5]";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.heading.5
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.heading;
        ds:node "$root/case[h6]";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.heading.6
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.tag;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:sites.pattern.hero;
        ds:node "$root/columns/content/description";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:sites.pattern.hero;
        ds:node "$root/columns/content/description";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:sites.pattern.hero;
        ds:node "$root/columns/content/actions";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:spacing.gap.group.block
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.width";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.stroke.thickness.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.foreground.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.foreground.primary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "hover";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.primary.hover
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "active";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.primary.active
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.background";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.foreground.primary.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.border.highlighted
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "default";
        ds:rank 3;
        ds:consumesSymbol dt:color.border
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.border.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.border.highlighted.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.text.disabled
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.weight";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.weight.medium
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.size";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.size.fontSize.300
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "typography.font";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:typography.text.secondary
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "spacing.gap";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.100
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.start";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "spacing.internal.inline.end";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:dimension.200
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.outline.color";
        anatomy:styleState "focus";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root";
        anatomy:styleKey "appearance.outline.color";
        anatomy:styleState "focus";
        ds:rank 2;
        ds:consumesSymbol dt:color.focusRing
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root/icon";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 1;
        ds:consumesSymbol dt:modifier.color.icon
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root/icon";
        anatomy:styleKey "typography.color";
        anatomy:styleState "default";
        ds:rank 2;
        ds:consumesSymbol dt:modifier.color.text
    ], [
        a ds:TokenBinding;
        ds:viaBlock ds:global.component.button;
        ds:node "$root/icon";
        anatomy:styleKey "typography.color";
        anatomy:styleState "disabled";
        ds:rank 1;
        ds:consumesSymbol dt:color.icon.disabled
    ].
