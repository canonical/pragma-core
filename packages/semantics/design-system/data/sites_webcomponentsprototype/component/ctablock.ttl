@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.component.ctablock a ds:Component;
    ds:name "CTABlock";
    ds:summary "A CTA (call to action) block is is used to encourage users to take a specific action. This could be to learn more details about a product, contact someone, or to download a file.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.cta-block\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.padding.vertical: spacing/x-large\n    spacing.padding.horizontal: spacing/large\n    appearance.background: color/surface/cta\n  edges:\n    - node:\n        role: cta inner container\n        styles:\n          layout.type: grid\n          layout.direction: horizontal\n          layout.align: center\n          spacing.gap: spacing/x-large\n          size.max.width: size/container/max\n          spacing.margin.horizontal: auto\n        edges:\n          - node:\n              uri: vanilla.subcomponent.cta-block_content\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                layout.flex: 1\n                spacing.gap: spacing/small\n              edges:\n                - node:\n                    role: title text\n                    styles:\n                      typography.size: font/size/heading/3\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/cta\n                  relation:\n                    cardinality: \"1\"\n                    slotName: title\n                - node:\n                    role: body text\n                    styles:\n                      typography.size: font/size/medium\n                      typography.color: color/text/cta-muted\n                      size.max.width: size/text/readable\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: body\n            relation:\n              cardinality: \"1\"\n              slotName: content\n          - node:\n              uri: vanilla.subcomponent.cta-block_actions\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.wrap: wrap\n                layout.align: center\n                layout.flex-shrink: 0\n                spacing.gap: spacing/medium\n              edges:\n                - switch:\n                    on: override\n                    cases:\n                      - uri: vanilla.component.button\n                      - uri: $custom\n                  relation:\n                    cardinality: \"1..*\"\n            relation:\n              cardinality: \"1\"\n              slotName: actions\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
