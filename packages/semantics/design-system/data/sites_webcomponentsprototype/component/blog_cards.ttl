@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.component.blog_cards a ds:Component;
    ds:name "BlogCards";
    ds:summary "**Blog Card** is a reusable card component for displaying a single blog post preview. It stacks an optional **cover image** above a **body area** containing optional metadata (topic, date, author), a required **title**, optional **excerpt**, and an optional **read-more link**, all within a rounded, optionally shadowed container.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.component.blog-card\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.height: fill\n    appearance.background: color/surface/card\n    appearance.radius: shape/rounded/medium\n    appearance.shadow: shadow/card?\n    layout.overflow: hidden\n  edges:\n    - node:\n        uri: vanilla.subcomponent.blog-card_image\n        styles:\n          layout.display: block\n          size.width: fill\n          size.height: size/blog-card/image\n          object.fit: cover\n          layout.flex-shrink: 0\n      relation:\n        cardinality: \"0..1\"\n        slotName: image\n    - node:\n        uri: vanilla.subcomponent.blog-card_body\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          layout.flex: 1\n          spacing.internal: spacing/medium\n          spacing.gap: spacing/small\n        edges:\n          - node:\n              uri: vanilla.subcomponent.blog-card_meta\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.wrap: wrap\n                layout.align: center\n                spacing.gap: spacing/small\n              edges:\n                - node:\n                    role: topic label\n                    styles:\n                      typography.size: font/size/small\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/link\n                      typography.transform: uppercase\n                      typography.letter-spacing: typography/letter-spacing/wide\n                  relation:\n                    cardinality: \"0..1\"\n                - node:\n                    role: publish date\n                    styles:\n                      typography.size: font/size/small\n                      typography.color: color/text/muted\n                  relation:\n                    cardinality: \"0..1\"\n                - node:\n                    role: author name\n                    styles:\n                      typography.size: font/size/small\n                      typography.color: color/text/muted\n                  relation:\n                    cardinality: \"0..1\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: meta\n          - node:\n              role: post title\n              styles:\n                typography.size: font/size/heading/4\n                typography.weight: font/weight/bold\n                typography.color: color/text/default\n            relation:\n              cardinality: \"1\"\n              slotName: title\n          - node:\n              role: post excerpt\n              styles:\n                typography.size: font/size/medium\n                typography.color: color/text/muted\n                layout.flex: 1\n            relation:\n              cardinality: \"0..1\"\n              slotName: excerpt\n          - node:\n              role: read more link\n              styles:\n                typography.size: font/size/medium\n                typography.color: color/text/link\n                typography.decoration: none\n                interaction.cursor: pointer\n                spacing.margin.top: auto\n            relation:\n              cardinality: \"0..1\"\n              slotName: link\n      relation:\n        cardinality: \"1\"\n        slotName: body";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
