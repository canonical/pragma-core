@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.component.tabs a ds:Component;
    ds:name "Tabs";
    ds:summary "**Tabs** is a navigation pattern that organises content into multiple panels, only one of which is visible at a time. A horizontal **tab bar** presents a row of clickable tab items, each corresponding to a **content panel** below. Selecting a tab reveals its associated panel while hiding all others.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.tabs\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n  edges:\n    - node:\n        uri: vanilla.subcomponent.tabs-nav\n        styles:\n          layout.type: flow\n          layout.direction: horizontal\n          layout.align: end\n          spacing.gap: spacing/none\n          appearance.border.bottom: border/style/divider\n          layout.overflow.x: auto\n          size.width: fill\n        edges:\n          - node:\n              uri: vanilla.subcomponent.tabs-nav_item\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.align: center\n                spacing.padding.horizontal: spacing/medium\n                spacing.padding.vertical: spacing/small\n                typography.size: font/size/medium\n                typography.weight: font/weight/regular\n                typography.color: color/text/link\n                typography.decoration: none\n                appearance.background: color/surface/transparent\n                appearance.border.bottom: border/style/none\n                interaction.cursor: pointer\n                layout.white-space: nowrap\n              edges:\n                - node:\n                    role: tab label text\n                    styles:\n                      typography.size: font/size/medium\n                      typography.color: color/text/link\n                  relation:\n                    cardinality: \"1\"\n            relation:\n              cardinality: \"2..*\"\n      relation:\n        cardinality: \"1\"\n        slotName: nav\n    - node:\n        uri: vanilla.subcomponent.tabs-content\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          size.width: fill\n        edges:\n          - node:\n              uri: vanilla.subcomponent.tabs-content_panel\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                spacing.internal: spacing/large\n              edges:\n                - node:\n                    role: panel content\n                    styles:\n                      layout.display: block\n                  relation:\n                    cardinality: \"1\"\n                    slotName: default\n            relation:\n              cardinality: \"2..*\"\n      relation:\n        cardinality: \"1\"\n        slotName: content";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
