@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.logo_section a ds:Pattern;
    ds:name "LogoSection";
    ds:summary "**Logo Section** is a presentational pattern for showcasing a collection of logos in a uniform grid layout, optionally introduced by a centred heading. It is typically used to display partner, client, technology, or certification logos as a trust-building element on landing pages and marketing content.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.logo-section\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.gap: spacing/large\n    spacing.padding.vertical: spacing/x-large\n  edges:\n    - node:\n        uri: vanilla.subcomponent.logo-section_heading\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          layout.align: center\n          spacing.gap: spacing/small\n        edges:\n          - node:\n              role: section title\n              styles:\n                typography.size: font/size/heading/4\n                typography.weight: font/weight/bold\n                typography.color: color/text/default\n                typography.align: center\n            relation:\n              cardinality: \"1\"\n          - node:\n              role: section subtitle\n              styles:\n                typography.size: font/size/medium\n                typography.color: color/text/muted\n                typography.align: center\n            relation:\n              cardinality: \"0..1\"\n      relation:\n        cardinality: \"0..1\"\n        slotName: heading\n    - node:\n        uri: vanilla.subcomponent.logo-section_grid\n        styles:\n          layout.type: grid\n          layout.direction: horizontal\n          layout.align: center\n          layout.justify: center\n          layout.wrap: wrap\n          spacing.gap: spacing/large\n          size.width: fill\n        edges:\n          - node:\n              uri: vanilla.subcomponent.logo-section_grid-item\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.align: center\n                layout.justify: center\n                size.width: size/logo-cell/width\n                size.height: size/logo-cell/height\n                spacing.internal: spacing/medium\n              edges:\n                - node:\n                    role: logo image\n                    styles:\n                      size.max.width: fill\n                      size.max.height: fill\n                      object.fit: contain\n                  relation:\n                    cardinality: \"1\"\n                    slotName: default\n            relation:\n              cardinality: \"2..*\"\n      relation:\n        cardinality: \"1\"\n        slotName: grid";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
