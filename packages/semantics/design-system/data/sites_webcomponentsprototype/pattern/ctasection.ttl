@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.ctasection a ds:Pattern;
    ds:name "CTASection";
    ds:summary "**CTA Section** is a full-width page section pattern designed to persuade users to take action by combining a header, optional supporting content, and a prominent call-to-action row. Unlike the compact CTA Block, a CTA Section provides space for richer content, such as a grid of feature items with icons, titles, and descriptions, making it suitable for more detailed persuasion before the call-to-action.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.cta-section\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.padding.vertical: spacing/xx-large\n    spacing.padding.horizontal: spacing/large\n    appearance.background: color/surface/section\n  edges:\n    - node:\n        role: section inner container\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          spacing.gap: spacing/x-large\n          size.max.width: size/container/max\n          spacing.margin.horizontal: auto\n          size.width: fill\n        edges:\n          - node:\n              uri: vanilla.subcomponent.cta-section_header\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                spacing.gap: spacing/small\n                size.max.width: size/text/readable-wide\n              edges:\n                - node:\n                    role: section title\n                    styles:\n                      typography.size: font/size/heading/2\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/default\n                  relation:\n                    cardinality: \"1\"\n                    slotName: title\n                - node:\n                    role: section subtitle\n                    styles:\n                      typography.size: font/size/large\n                      typography.color: color/text/muted\n                      size.max.width: size/text/readable\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: subtitle\n            relation:\n              cardinality: \"1\"\n              slotName: header\n          - node:\n              uri: vanilla.subcomponent.cta-section_body\n              styles:\n                layout.type: grid\n                layout.direction: horizontal\n                layout.wrap: wrap\n                layout.align: start\n                spacing.gap: spacing/large\n                size.width: fill\n              edges:\n                - node:\n                    uri: vanilla.subcomponent.cta-section_body-item\n                    styles:\n                      layout.type: stack\n                      layout.direction: vertical\n                      layout.flex: 1\n                      size.min.width: size/cta-section/item-min\n                      spacing.gap: spacing/small\n                    edges:\n                      - node:\n                          role: item icon or image\n                          styles:\n                            size.width: size/icon/large\n                            size.height: size/icon/large\n                            layout.flex-shrink: 0\n                        relation:\n                          cardinality: \"0..1\"\n                          slotName: icon\n                      - node:\n                          role: item title\n                          styles:\n                            typography.size: font/size/heading/4\n                            typography.weight: font/weight/bold\n                            typography.color: color/text/default\n                        relation:\n                          cardinality: \"0..1\"\n                          slotName: title\n                      - node:\n                          role: item description\n                          styles:\n                            typography.size: font/size/medium\n                            typography.color: color/text/muted\n                        relation:\n                          cardinality: \"0..1\"\n                          slotName: description\n                  relation:\n                    cardinality: \"1..*\"\n            relation:\n              cardinality: \"0..1\"\n              slotName: body\n          - node:\n              uri: vanilla.subcomponent.cta-section_cta\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.wrap: wrap\n                layout.align: center\n                spacing.gap: spacing/medium\n                spacing.padding.top: spacing/medium\n                appearance.border.top: border/style/divider?\n              edges:\n                - switch:\n                    on: override\n                    cases:\n                      - uri: vanilla.component.button\n                      - uri: $custom\n                  relation:\n                    cardinality: \"1..*\"\n            relation:\n              cardinality: \"1\"\n              slotName: cta\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
