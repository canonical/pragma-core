@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.basic_section a ds:Pattern;
    ds:name "BasicSection";
    ds:summary "**Basic Section** is the foundational page section pattern in the Vanilla Framework. It uses a **side-by-side split layout**, a header column (title and optional subtitle) on the left and a content column (body text and optional CTA) on the right, within a max-width constrained, centred container.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.basic-section\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.padding.vertical: spacing/xx-large\n    spacing.padding.horizontal: spacing/large\n    appearance.background: color/surface/section?\n  edges:\n    - node:\n        role: section inner container\n        styles:\n          layout.type: grid\n          layout.direction: horizontal\n          layout.align: start\n          spacing.gap: spacing/x-large\n          size.max.width: size/container/max\n          spacing.margin.horizontal: auto\n          size.width: fill\n        edges:\n          - node:\n              uri: vanilla.subcomponent.basic-section_header\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                layout.flex: 1\n                spacing.gap: spacing/small\n                size.min.width: size/basic-section/header-min\n              edges:\n                - node:\n                    role: section title\n                    styles:\n                      typography.size: font/size/heading/2\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/default\n                  relation:\n                    cardinality: \"1\"\n                    slotName: title\n                - node:\n                    role: section subtitle\n                    styles:\n                      typography.size: font/size/large\n                      typography.color: color/text/muted\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: subtitle\n            relation:\n              cardinality: \"1\"\n              slotName: header\n          - node:\n              uri: vanilla.subcomponent.basic-section_content\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                layout.flex: 2\n                spacing.gap: spacing/medium\n              edges:\n                - node:\n                    role: section body content\n                    styles:\n                      typography.size: font/size/medium\n                      typography.color: color/text/default\n                      size.max.width: size/text/readable\n                  relation:\n                    cardinality: \"1\"\n                    slotName: default\n                - node:\n                    uri: vanilla.subcomponent.basic-section_content-cta\n                    styles:\n                      layout.type: flow\n                      layout.direction: horizontal\n                      layout.wrap: wrap\n                      layout.align: center\n                      spacing.gap: spacing/medium\n                      spacing.margin.top: spacing/small\n                    edges:\n                      - switch:\n                          on: override\n                          cases:\n                            - uri: vanilla.component.button\n                            - uri: $custom\n                        relation:\n                          cardinality: \"1..*\"\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: cta\n            relation:\n              cardinality: \"1\"\n              slotName: content\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
