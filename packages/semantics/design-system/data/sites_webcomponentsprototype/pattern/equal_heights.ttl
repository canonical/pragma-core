@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.equal_heights a ds:Pattern;
    ds:name "EqualHeights";
    ds:summary "**Equal Heights** is a layout pattern that arranges sibling content items in a responsive horizontal grid where all items share the same height, regardless of individual content length. It uses CSS stretch alignment to enforce height equalisation and flexbox auto-margins to keep footers pinned to the bottom of each item.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.equal-heights\n  styles:\n    layout.type: grid\n    layout.direction: horizontal\n    layout.wrap: wrap\n    layout.align-items: stretch\n    size.width: fill\n    spacing.gap: spacing/large\n  edges:\n    - node:\n        uri: vanilla.subcomponent.equal-heights_item\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          layout.flex: 1\n          size.min.width: size/equal-heights/item-min\n          size.height: fill\n          spacing.gap: spacing/medium\n        edges:\n          - node:\n              uri: vanilla.subcomponent.equal-heights_item-media\n              styles:\n                layout.display: block\n                size.width: fill\n                size.height: size/equal-heights/media\n                object.fit: cover\n                appearance.radius: shape/rounded/top\n                layout.flex-shrink: 0\n            relation:\n              cardinality: \"0..1\"\n              slotName: media\n          - node:\n              uri: vanilla.subcomponent.equal-heights_item-content\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                layout.flex: 1\n                spacing.gap: spacing/small\n                spacing.internal: spacing/medium\n              edges:\n                - node:\n                    role: content title\n                    styles:\n                      typography.size: font/size/heading/4\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/default\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: title\n                - node:\n                    role: content body\n                    styles:\n                      typography.size: font/size/medium\n                      typography.color: color/text/muted\n                      layout.flex: 1\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: body\n            relation:\n              cardinality: \"1\"\n              slotName: content\n          - node:\n              uri: vanilla.subcomponent.equal-heights_item-footer\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.align: center\n                layout.wrap: wrap\n                spacing.gap: spacing/small\n                spacing.internal: spacing/medium\n                spacing.margin.top: auto\n                appearance.border.top: border/style/divider\n              edges:\n                - node:\n                    role: footer content\n                    styles:\n                      layout.display: block\n                  relation:\n                    cardinality: \"1\"\n                    slotName: default\n            relation:\n              cardinality: \"0..1\"\n              slotName: footer\n      relation:\n        cardinality: \"2..*\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
