@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.blog_section a ds:Pattern;
    ds:name "BlogSection";
    ds:summary "**Blog Section** is a page-level pattern for showcasing a collection of blog post preview cards within a titled section. It combines a **section header** (title and optional \"view all\" link) with a responsive **card grid** where each card presents a blog post through an optional image, metadata, title, excerpt, and read-more link.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.blog-section\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.padding.vertical: spacing/xx-large\n    spacing.padding.horizontal: spacing/large\n    appearance.background: color/surface/section\n  edges:\n    - node:\n        role: blog section inner container\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          spacing.gap: spacing/x-large\n          size.max.width: size/container/max\n          spacing.margin.horizontal: auto\n          size.width: fill\n        edges:\n          - node:\n              uri: vanilla.subcomponent.blog-section_header\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.justify: space-between\n                layout.align: baseline\n                layout.wrap: wrap\n                spacing.gap: spacing/medium\n                size.width: fill\n              edges:\n                - node:\n                    role: section title\n                    styles:\n                      typography.size: font/size/heading/2\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/default\n                  relation:\n                    cardinality: \"1\"\n                    slotName: title\n                - node:\n                    role: view all link\n                    styles:\n                      typography.size: font/size/medium\n                      typography.color: color/text/link\n                      typography.decoration: none\n                      interaction.cursor: pointer\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: link\n            relation:\n              cardinality: \"1\"\n              slotName: header\n          - node:\n              uri: vanilla.subcomponent.blog-section_grid\n              styles:\n                layout.type: grid\n                layout.direction: horizontal\n                layout.wrap: wrap\n                layout.align-items: stretch\n                spacing.gap: spacing/large\n                size.width: fill\n              edges:\n                - node:\n                    uri: vanilla.subcomponent.blog-section_card\n                    styles:\n                      layout.type: stack\n                      layout.direction: vertical\n                      layout.flex: 1\n                      size.min.width: size/blog-card/min\n                      size.height: fill\n                      appearance.background: color/surface/card\n                      appearance.radius: shape/rounded/medium\n                      appearance.shadow: shadow/card?\n                      layout.overflow: hidden\n                    edges:\n                      - node:\n                          uri: vanilla.subcomponent.blog-section_card-image\n                          styles:\n                            layout.display: block\n                            size.width: fill\n                            size.height: size/blog-card/image\n                            object.fit: cover\n                            layout.flex-shrink: 0\n                        relation:\n                          cardinality: \"0..1\"\n                          slotName: image\n                      - node:\n                          uri: vanilla.subcomponent.blog-section_card-body\n                          styles:\n                            layout.type: stack\n                            layout.direction: vertical\n                            layout.flex: 1\n                            spacing.internal: spacing/medium\n                            spacing.gap: spacing/small\n                          edges:\n                            - node:\n                                uri: vanilla.subcomponent.blog-section_card-meta\n                                styles:\n                                  layout.type: flow\n                                  layout.direction: horizontal\n                                  layout.wrap: wrap\n                                  layout.align: center\n                                  spacing.gap: spacing/small\n                                edges:\n                                  - node:\n                                      role: topic label\n                                      styles:\n                                        typography.size: font/size/small\n                                        typography.weight: font/weight/bold\n                                        typography.color: color/text/link\n                                        typography.transform: uppercase\n                                        typography.letter-spacing: typography/letter-spacing/wide\n                                    relation:\n                                      cardinality: \"0..1\"\n                                  - node:\n                                      role: publish date\n                                      styles:\n                                        typography.size: font/size/small\n                                        typography.color: color/text/muted\n                                    relation:\n                                      cardinality: \"0..1\"\n                                  - node:\n                                      role: author name\n                                      styles:\n                                        typography.size: font/size/small\n                                        typography.color: color/text/muted\n                                    relation:\n                                      cardinality: \"0..1\"\n                              relation:\n                                cardinality: \"0..1\"\n                                slotName: meta\n                            - node:\n                                role: post title\n                                styles:\n                                  typography.size: font/size/heading/4\n                                  typography.weight: font/weight/bold\n                                  typography.color: color/text/default\n                              relation:\n                                cardinality: \"1\"\n                                slotName: title\n                            - node:\n                                role: post excerpt\n                                styles:\n                                  typography.size: font/size/medium\n                                  typography.color: color/text/muted\n                                  layout.flex: 1\n                              relation:\n                                cardinality: \"0..1\"\n                                slotName: excerpt\n                            - node:\n                                role: read more link\n                                styles:\n                                  typography.size: font/size/medium\n                                  typography.color: color/text/link\n                                  typography.decoration: none\n                                  interaction.cursor: pointer\n                                  spacing.margin.top: auto\n                              relation:\n                                cardinality: \"0..1\"\n                                slotName: link\n                        relation:\n                          cardinality: \"1\"\n                          slotName: body\n                  relation:\n                    cardinality: \"1..*\"\n            relation:\n              cardinality: \"1\"\n              slotName: grid\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
