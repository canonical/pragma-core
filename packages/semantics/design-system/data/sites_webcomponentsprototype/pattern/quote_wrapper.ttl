@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.quote_wrapper a ds:Pattern;
    ds:name "QuoteWrapper";
    ds:summary "**Quote Wrapper** is a presentational pattern for displaying a highlighted quotation with optional attribution. It pairs a visually distinct **blockquote**, marked by a left accent border and italic typography, with an optional **citation block** that identifies the source through a name, role/organisation, and an optional avatar image.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.quote-wrapper\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.internal: spacing/large\n    spacing.padding.vertical: spacing/x-large\n  edges:\n    - node:\n        uri: vanilla.subcomponent.quote-wrapper_quote\n        styles:\n          layout.type: stack\n          layout.direction: vertical\n          spacing.gap: spacing/medium\n          spacing.padding.left: spacing/large\n          appearance.border.left: border/style/accent\n        edges:\n          - node:\n              role: quotation text\n              styles:\n                typography.size: font/size/large\n                typography.weight: font/weight/light\n                typography.color: color/text/default\n                typography.style: italic\n            relation:\n              cardinality: \"1\"\n      relation:\n        cardinality: \"1\"\n        slotName: quote\n    - node:\n        uri: vanilla.subcomponent.quote-wrapper_citation\n        styles:\n          layout.type: flow\n          layout.direction: horizontal\n          layout.align: center\n          spacing.gap: spacing/medium\n        edges:\n          - node:\n              uri: vanilla.subcomponent.quote-wrapper_citation-image\n              styles:\n                size.width: size/avatar/medium\n                size.height: size/avatar/medium\n                appearance.radius: shape/rounded/full\n                object.fit: cover\n            relation:\n              cardinality: \"0..1\"\n              slotName: image\n          - node:\n              uri: vanilla.subcomponent.quote-wrapper_citation-text\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                spacing.gap: spacing/xx-small\n              edges:\n                - node:\n                    role: citation name\n                    styles:\n                      typography.size: font/size/medium\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/default\n                  relation:\n                    cardinality: \"1\"\n                - node:\n                    role: citation role and organisation\n                    styles:\n                      typography.size: font/size/small\n                      typography.color: color/text/muted\n                  relation:\n                    cardinality: \"0..1\"\n            relation:\n              cardinality: \"1\"\n              slotName: text\n      relation:\n        cardinality: \"0..1\"\n        slotName: citation";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
