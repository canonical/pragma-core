@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.tiered_list a ds:Pattern;
    ds:name "Tiered list";
    ds:summary "A **tiered list** is a structured layout pattern used to present grouped content in a tabular, multi-column format. Each row pairs a **title section** (with an optional description) on the left with one or more **tier columns** on the right, separated by horizontal dividers. It is commonly used for pricing tables, feature comparisons, service breakdowns, or any content that benefits from side-by-side categorisation across tiers.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.tiered-list\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    appearance.border.top: border/style/divider\n  edges:\n    - node:\n        uri: vanilla.subcomponent.tiered-list-item\n        styles:\n          layout.type: grid\n          layout.direction: horizontal\n          layout.align: start\n          spacing.internal: spacing/large\n          appearance.border.bottom: border/style/divider\n          spacing.padding.top: spacing/large\n          spacing.padding.bottom: spacing/large\n        edges:\n          - node:\n              uri: vanilla.subcomponent.tiered-list-item_title\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                layout.flex: 1\n                spacing.gap: spacing/small\n              edges:\n                - node:\n                    role: heading text\n                    styles:\n                      typography.size: font/size/heading/4\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/default\n                  relation:\n                    cardinality: \"1\"\n                - node:\n                    role: description text\n                    styles:\n                      typography.size: font/size/medium\n                      typography.color: color/text/muted\n                  relation:\n                    cardinality: \"0..1\"\n            relation:\n              cardinality: \"1\"\n              slotName: title\n          - node:\n              uri: vanilla.subcomponent.tiered-list-item_tiers\n              styles:\n                layout.type: grid\n                layout.direction: horizontal\n                layout.align: start\n                layout.flex: 2\n                spacing.gap: spacing/large\n              edges:\n                - node:\n                    uri: vanilla.subcomponent.tiered-list-item_tier\n                    styles:\n                      layout.type: stack\n                      layout.direction: vertical\n                      layout.flex: 1\n                      spacing.gap: spacing/x-small\n                    edges:\n                      - node:\n                          role: tier heading\n                          styles:\n                            typography.size: font/size/small\n                            typography.weight: font/weight/bold\n                            typography.color: color/text/default\n                        relation:\n                          cardinality: \"0..1\"\n                      - node:\n                          role: tier content\n                          styles:\n                            typography.size: font/size/medium\n                            typography.color: color/text/muted\n                        relation:\n                          cardinality: \"1\"\n                  relation:\n                    cardinality: \"1..*\"\n            relation:\n              cardinality: \"1\"\n              slotName: tiers\n      relation:\n        cardinality: \"1..*\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
