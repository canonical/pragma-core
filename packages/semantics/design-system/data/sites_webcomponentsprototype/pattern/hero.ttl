@prefix ds: <https://ds.canonical.com/>.
@prefix anatomy: <https://anatomy.canonical.com/>.
@prefix dt: <https://dt.canonical.com/>.

ds:sites_webcomponentsprototype.pattern.hero a ds:Pattern;
    ds:name "Hero";
    ds:summary "**Hero** is a prominent full-width banner pattern used at the top of pages to introduce key content and drive user action. It employs a two-column grid layout, a **content column** on one side and an optional **media column** on the other, within a max-width constrained inner container.";
    ds:anatomyDsl "---\nnode:\n  uri: vanilla.pattern.hero\n  styles:\n    layout.type: stack\n    layout.direction: vertical\n    size.width: fill\n    spacing.padding.vertical: spacing/xx-large\n    appearance.background: color/surface/hero\n  edges:\n    - node:\n        role: hero inner container\n        styles:\n          layout.type: grid\n          layout.direction: horizontal\n          layout.align: center\n          spacing.gap: spacing/x-large\n          size.max.width: size/container/max\n          spacing.margin.horizontal: auto\n          spacing.padding.horizontal: spacing/large\n        edges:\n          - node:\n              uri: vanilla.subcomponent.hero-content\n              styles:\n                layout.type: stack\n                layout.direction: vertical\n                layout.flex: 1\n                spacing.gap: spacing/medium\n              edges:\n                - node:\n                    role: signpost eyebrow\n                    styles:\n                      typography.size: font/size/small\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/muted\n                      typography.transform: uppercase\n                      typography.letter-spacing: typography/letter-spacing/wide\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: signpost\n                - node:\n                    role: headline text\n                    styles:\n                      typography.size: font/size/heading/1\n                      typography.weight: font/weight/bold\n                      typography.color: color/text/hero\n                  relation:\n                    cardinality: \"1\"\n                    slotName: title\n                - node:\n                    role: subtitle text\n                    styles:\n                      typography.size: font/size/heading/4\n                      typography.weight: font/weight/light\n                      typography.color: color/text/hero-muted\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: subtitle\n                - node:\n                    role: body text\n                    styles:\n                      typography.size: font/size/large\n                      typography.color: color/text/hero-muted\n                      size.max.width: size/text/readable\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: body\n                - node:\n                    uri: vanilla.subcomponent.hero-content_cta-group\n                    styles:\n                      layout.type: flow\n                      layout.direction: horizontal\n                      layout.wrap: wrap\n                      layout.align: center\n                      spacing.gap: spacing/medium\n                      spacing.margin.top: spacing/small\n                    edges:\n                      - switch:\n                          on: override\n                          cases:\n                            - uri: vanilla.component.button\n                            - uri: $custom\n                        relation:\n                          cardinality: \"1..*\"\n                  relation:\n                    cardinality: \"0..1\"\n                    slotName: cta\n            relation:\n              cardinality: \"1\"\n              slotName: content\n          - node:\n              uri: vanilla.subcomponent.hero-media\n              styles:\n                layout.type: flow\n                layout.direction: horizontal\n                layout.align: center\n                layout.justify: center\n                layout.flex: 1\n              edges:\n                - switch:\n                    on: props\n                    cases:\n                      - node:\n                          uri: vanilla.subcomponent.hero-media_image\n                          styles:\n                            size.max.width: fill\n                            size.height: auto\n                            object.fit: contain\n                            appearance.radius: shape/rounded/medium\n                      - node:\n                          uri: vanilla.subcomponent.hero-media_video\n                          styles:\n                            size.width: fill\n                            size.height: auto\n                            object.fit: contain\n                            appearance.radius: shape/rounded/medium\n                  relation:\n                    cardinality: \"1\"\n                    slotName: default\n            relation:\n              cardinality: \"0..1\"\n              slotName: media\n      relation:\n        cardinality: \"1\"";
    ds:anatomyClassic "";
    ds:usage "";
    ds:guidelines "";
    ds:tier ds:sites_webcomponentsprototype.
