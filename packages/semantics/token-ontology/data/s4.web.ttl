<--active--color-foreground-checkbox-unselected>
    a dt:Variable ;
    rdfs:label "active--color-foreground-checkbox-unselected" ;
    dt:tier dt:tier.derived ;
    dt:visibility dt:visibility.internal ;
    dt:declaredAt [
        a dt:Declaration ;
        dt:under <cond/layer-ds-states/universal> ;
        dt:emits "oklch(from var(--surface-color-foreground-checkbox-unselected, var(--color-foreground-checkbox-unselected)) calc(l + var(--delta-active-color-foreground-checkbox-unselected)) c h)" ;
        dt:at "states.css:23" ;
        dt:references ( <--surface-color-foreground-checkbox-unselected> <--color-foreground-checkbox-unselected> <--delta-active-color-foreground-checkbox-unselected> ) ;
        dt:derives dt:derivation.active ;
        dt:computedFrom <--color-foreground-checkbox-unselected> ] .

