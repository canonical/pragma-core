dt:axis.surface
    a w3c-tokens:ResolverModifier ;
    w3c-tokens:name "surface" ;
    w3c-tokens:description "Surface modifier for layer-aware token rebinding. Contexts: layer1, layer2, layer3 (depth-based, compounding .surface selectors), contrasted (polarity-based, a non-compounding .contrasted selector) and modal (identity of layer1 under a non-compounding .modal selector). NOTE: the `contrasted` and `modal` contexts are EXPERIMENTAL — their token set may change; CSS var names are not yet stable API." ;
    w3c-tokens:context dt:context.surface.contrasted ;
    w3c-tokens:context dt:context.surface.layer1 ;
    w3c-tokens:context dt:context.surface.layer2 ;
    w3c-tokens:context dt:context.surface.layer3 ;
    w3c-tokens:context dt:context.surface.modal ;
    w3c-tokens:context dt:context.surface.none ;
    w3c-tokens:default dt:context.surface.none .

dt:context.surface.contrasted
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "contrasted" ;
    w3c-tokens:includes ( <global/semantic/modifier/surface/contrasted.tokens.json> ) .

dt:context.surface.layer1
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "layer1" ;
    w3c-tokens:includes ( <global/semantic/modifier/surface/layer1.tokens.json> ) .

dt:context.surface.layer2
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "layer2" ;
    w3c-tokens:includes ( <global/semantic/modifier/surface/layer2.tokens.json> ) .

dt:context.surface.layer3
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "layer3" ;
    w3c-tokens:includes ( <global/semantic/modifier/surface/layer3.tokens.json> ) .

dt:context.surface.modal
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "modal" ;
    w3c-tokens:includes ( <global/semantic/modifier/surface/modal.tokens.json> ) .

dt:context.surface.none
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "none" ;
    w3c-tokens:includes () .

dt:axis.theme
    a w3c-tokens:ResolverModifier ;
    w3c-tokens:name "theme" ;
    w3c-tokens:description "Theme modifier for light/dark color tokens. Output uses light-dark() per DE015B section 2.E.a." ;
    w3c-tokens:context dt:context.theme.dark ;
    w3c-tokens:context dt:context.theme.light ;
    w3c-tokens:default dt:context.theme.light .

dt:context.theme.dark
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "dark" ;
    w3c-tokens:includes ( <global/semantic/color/dark.tokens.json> ) .

dt:context.theme.light
    a w3c-tokens:ResolverContext ;
    w3c-tokens:name "light" ;
    w3c-tokens:includes ( <global/semantic/color/light.tokens.json> ) .

