<canonical.resolver.json>
    a w3c-tokens:Resolver ;
    w3c-tokens:version "2025.10" ;
    w3c-tokens:schema "https://designtokens.org/schemas/2025.10/resolver.json" ;
    w3c-tokens:set dt:set.primitive ;
    w3c-tokens:modifier dt:axis.anticipation ;
    w3c-tokens:modifier dt:axis.breakpoint ;
    w3c-tokens:modifier dt:axis.criticality ;
    w3c-tokens:modifier dt:axis.emphasis ;
    w3c-tokens:modifier dt:axis.importance ;
    w3c-tokens:modifier dt:axis.lifecycle ;
    w3c-tokens:modifier dt:axis.product ;
    w3c-tokens:modifier dt:axis.release ;
    w3c-tokens:modifier dt:axis.surface ;
    w3c-tokens:modifier dt:axis.theme ;
    w3c-tokens:resolutionOrder ( dt:set.primitive dt:axis.breakpoint dt:axis.theme dt:axis.product dt:axis.anticipation dt:axis.criticality dt:axis.emphasis dt:axis.importance dt:axis.lifecycle dt:axis.release dt:axis.surface ) .

dt:set.primitive
