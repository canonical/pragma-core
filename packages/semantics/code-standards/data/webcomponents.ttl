@prefix cs: <http://pragma.canonical.com/codestandards#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Web Components Category
cs:webcomponents a cs:Category ;
    rdfs:label "Web Components"@en ;
    rdfs:comment "Framework-agnostic standards for web component authoring"@en ;
    cs:slug "webcomponents" .

# Component Naming
cs:webcomponents.component.naming a cs:CodeStandard ;
    rdfs:label "Component and custom element naming"@en ;
    cs:hasCategory cs:webcomponents ;
    cs:description "Component classes must use PascalCase and be descriptive. Custom element names must be kebab-case and include a namespace (for example, `ds-button`). The class name does not include the namespace prefix — it matches the component concept only (for example, `Button`, not `DsButton`)." ;
    cs:do [
        cs:description "Use PascalCase for the class name and a namespaced kebab-case custom element tag." ;
        cs:language "typescript" ;
        cs:code """
class Button extends HTMLElement {}
customElements.define('ds-button', Button);
    """
    ] ;
    cs:dont [
        cs:description "Include the namespace prefix in the class name. The namespace already exists in the tag name." ;
        cs:language "typescript" ;
        cs:code """
// Bad: class name redundantly repeats namespace intent
class DsButton extends HTMLElement {}
customElements.define('ds-button', DsButton);
    """
    ] ;
    cs:dont [
        cs:description "Use a non-namespaced or non-kebab-case custom element name." ;
        cs:language "typescript" ;
        cs:code """
// Bad: no namespace
customElements.define('button', Button);

// Bad: not kebab-case
customElements.define('dsButton', Button);
    """
    ] .

# Component Class Names
cs:webcomponents.component.class-names a cs:CodeStandard ;
    rdfs:label "Namespaced CSS class names"@en ;
    cs:hasCategory cs:webcomponents ;
  cs:description "A `componentCssClassName` constant should be defined at the top of the component module, using a ds namespace plus kebab name (for example, `ds button`). Apply it to the root element rendered inside shadow DOM, never to the host element itself — the host's class attribute is owned by consumers. When modifier states are accepted, build the class list from an array with `.filter(Boolean).join(' ')`. Child class names should be short and role-based; the root `.ds.{component}` selector provides scope." ;
    cs:do [
        cs:description "Define a `componentCssClassName` constant and apply it on the internal root element." ;
        cs:language "typescript" ;
        cs:code """
const componentCssClassName = "ds button";

const template = `
  <button class="${componentCssClassName}">
    <slot></slot>
  </button>
`;
    """
    ] ;
    cs:do [
        cs:description "When the component accepts modifier states, compose the class string from an ordered array." ;
        cs:language "typescript" ;
        cs:code """
const className = [componentCssClassName, emphasis, size]
  .filter(Boolean)
  .join(" ");
    """
    ] ;
    cs:do [
        cs:description "Use short, role-based child class names and scope them under the root selector in CSS." ;
        cs:language "css" ;
        cs:code """
.ds.button .header { /* ... */ }
.ds.button .content { /* ... */ }
    """
    ] ;
    cs:dont [
        cs:description "Hardcode repeated class strings inline without a shared constant." ;
        cs:language "typescript" ;
        cs:code """
// Bad: repeated magic string
const template = `<button class="ds button">...</button>`;
    """
    ] ;
    cs:dont [
        cs:description "Mutate host classes to inject design-system namespace classes." ;
        cs:language "typescript" ;
        cs:code """
// Bad: host classes are consumer-owned
this.classList.add("ds", "button");
    """
    ] ;
    cs:dont [
        cs:description "Prefix child class names with component names or BEM suffixes when root scoping already provides context." ;
        cs:language "html" ;
        cs:code """
<!-- Bad: redundant prefixes -->
<div class="my-component__header"></div>
<div class="my-component-content"></div>
    """
    ] .

# Component Slots
cs:webcomponents.component.slots a cs:CodeStandard ;
    rdfs:label "Typed props over open slots"@en ;
    cs:hasCategory cs:webcomponents ;
    cs:description "Default to structured data APIs (typed props such as objects and arrays) instead of open content projection. Slots allow arbitrary light-DOM markup, making styling, layout guarantees, and semantic consistency harder to enforce. Only use slots when the consumer must provide real interactive/content nodes that cannot be expressed by the component's typed API. If a slot is required, it must be explicitly named and documented as part of a constrained contract (for example, named trigger/content slots), never as an unrestricted default slot. `::slotted()` can style only direct slotted children and cannot enforce full visual control, so tokenized props remain the primary customization mechanism." ;
    cs:do [
        cs:description "Model visual content with typed object props so rendering stays controlled by the component." ;
        cs:language "typescript" ;
        cs:code """
interface ButtonContent {
  label: string;
  iconName?: string;
}

interface ButtonProps {
  content: ButtonContent;
}
    """
    ] ;
    cs:do [
        cs:description "Use arrays/objects for repeatable structured regions instead of requiring projected children." ;
        cs:language "typescript" ;
        cs:code """
interface MenuItem {
  id: string;
  label: string;
  disabled?: boolean;
}

interface MenuProps {
  items: MenuItem[];
}
    """
    ] ;
    cs:do [
        cs:description "When slot usage is unavoidable, expose only named slots with a strict contract and keep free-form default content disabled." ;
        cs:language "html" ;
        cs:code """
<ds-popover>
  <button slot="trigger">Open</button>
  <div slot="content">Popover content</div>
</ds-popover>

<!-- Contract: only trigger/content named slots are accepted. -->
    """
    ] ;
    cs:do [
        cs:description "Define object-shape contracts and validate inputs at runtime for stable rendering and styling." ;
        cs:language "typescript" ;
        cs:code """
interface CardActions {
  primary: { label: string; disabled?: boolean };
  secondary?: { label: string; disabled?: boolean };
}

function hasValidActions(actions?: CardActions): boolean {
  return Boolean(actions?.primary?.label);
}
    """
    ] ;
    cs:dont [
        cs:description "Expose an unrestricted default slot as a public API for core components. This permits arbitrary consumer markup and breaks visual/semantic guarantees." ;
        cs:language "html" ;
        cs:code """
<!-- Bad: unrestricted default content -->
<ds-button>
  <p>Any markup can be injected here</p>
</ds-button>
    """
    ] ;
    cs:dont [
        cs:description "Use slots as the primary API for data that is already representable as typed objects." ;
        cs:language "typescript" ;
        cs:code """
// Bad: caller must compose markup for simple data
interface ListProps {
  itemsSlotOnly?: true;
}

// Good: accept structured data
interface BetterListProps {
  items: Array<{ label: string }>;
}
    """
    ] ;
    cs:dont [
        cs:description "Rely on `::slotted()` for strict design enforcement. Slotted elements keep their own styles and can override component intent." ;
        cs:language "css" ;
        cs:code """
/* Bad: consumer element styles can still win */
::slotted(*) {
  font-size: var(--text-size-2);
}
    """
    ] .

# Accessibility: Keyboard Interaction
cs:webcomponents.component.a11y.keyboard a cs:CodeStandard ;
    rdfs:label "Keyboard interaction patterns"@en ;
    cs:hasCategory cs:webcomponents ;
    cs:description "Interactive components must handle `keydown` events following WAI-ARIA Authoring Practices. Arrow keys navigate, `Enter`/`Space` activate, `Home`/`End` jump to first/last, `Escape` dismisses." ;
    cs:do [
        cs:description "Handle keyboard events for the component's widget role." ;
        cs:language "typescript" ;
        cs:code """
private onKeyDown(e: KeyboardEvent): void {
  switch (e.key) {
    case "ArrowDown":
      e.preventDefault();
      this.focusNextItem();
      break;
    case "ArrowUp":
      e.preventDefault();
      this.focusPreviousItem();
      break;
    case "Home":
      e.preventDefault();
      this.focusFirstItem();
      break;
    case "End":
      e.preventDefault();
      this.focusLastItem();
      break;
    case "Enter":
    case " ":
      e.preventDefault();
      this.toggleItem();
      break;
  }
}
    """
    ] ;
    cs:do [
        cs:description "Bind keydown handling on the interactive container and set an explicit role." ;
        cs:language "html" ;
        cs:code """
<div role="tablist" onkeydown="handleTabs(event)">
  <!-- tab controls -->
</div>
    """
    ] ;
    cs:dont [
        cs:description "Use only click handlers — keyboard-only users cannot activate the UI." ;
        cs:language "html" ;
        cs:code """
<!-- Bad: no keyboard handling -->
<div onclick="togglePanel()">Toggle</div>
    """
    ] .

# Accessibility: Focus Delegation
cs:webcomponents.component.a11y.focus a cs:CodeStandard ;
    rdfs:label "Shadow root focus delegation"@en ;
    cs:hasCategory cs:webcomponents ;
    cs:description "Use `delegatesFocus: true` when attaching a shadow root so host focus forwards to the first focusable shadow element. This avoids managing host tabindex manually for button-like components." ;
    cs:do [
        cs:description "Attach shadow root with focus delegation enabled." ;
        cs:language "typescript" ;
        cs:code """
class DsButton extends HTMLElement {
  constructor() {
    super();
    const root = this.attachShadow({ mode: "open", delegatesFocus: true });
    root.innerHTML = `<button part="button"><slot></slot></button>`;
  }
}

customElements.define("ds-button", DsButton);
    """
    ] ;
    cs:dont [
        cs:description "Add host tabindex management solely to compensate for missing focus delegation when the component already wraps a native focusable control." ;
        cs:language "typescript" ;
        cs:code """
// Bad: manual host focus plumbing for a wrapped native button
this.setAttribute("tabindex", "0");
this.addEventListener("focus", () => {
  this.shadowRoot?.querySelector("button")?.focus();
});
    """
    ] .

# Accessibility: ARIA on Interactive Elements
cs:webcomponents.component.a11y.aria a cs:CodeStandard ;
    rdfs:label "ARIA on the interactive element"@en ;
    cs:hasCategory cs:webcomponents ;
    cs:description "Apply ARIA attributes to the element that receives user focus and interaction. In wrapper components, this is usually an inner native control (for example, button or input), not the custom-element host. When the accessible name is dynamic, expose an explicit API (for example, an aria-label property) rather than relying on projected content to infer it." ;
    cs:do [
        cs:description "Forward accessible-name attributes to the inner interactive element." ;
        cs:language "html" ;
        cs:code """
<ds-button aria-label="Close dialog"></ds-button>

<!-- Component output contract -->
<button aria-label="Close dialog">...</button>
    """
    ] ;
    cs:do [
        cs:description "Treat explicit aria props as the primary accessibility contract for icon-only controls." ;
        cs:language "html" ;
        cs:code """
<ds-button aria-label="Close">
  <ds-icon name="close"></ds-icon>
</ds-button>
    """
    ] ;
    cs:dont [
        cs:description "Set ARIA only on the host when a separate inner control receives focus." ;
        cs:language "typescript" ;
        cs:code """
// Bad: aria on host does not label the focused inner button
this.setAttribute("aria-label", "Close dialog");
    """
    ] ;
    cs:dont [
        cs:description "Rely exclusively on projected content to derive accessible names for critical controls." ;
        cs:language "html" ;
        cs:code """
<!-- Bad: no explicit accessible name contract -->
<ds-button>
  <ds-icon name="close"></ds-icon>
</ds-button>
    """
    ] .
