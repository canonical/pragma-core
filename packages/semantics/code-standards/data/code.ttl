@prefix cs: <http://pragma.canonical.com/codestandards#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# General Code Category
cs:code a cs:Category ;
    rdfs:label "Code"@en ;
    rdfs:comment "General typescript coding standards and best practices"@en ;
    cs:slug "code" .

# Function Purity Standard
cs:code.function.purity a cs:CodeStandard ;
    rdfs:label "Pure functions by default"@en ;
    cs:hasCategory cs:code ;
    cs:description "Functions should be pure where possible. A pure function returns the same output for the same input and does not modify external state or perform I/O operations. If a function must perform side effects (e.g., I/O in CLI tools), it must be explicitly annotated and documented with the reason for impurity using the @note tag in TSDoc/JSDoc." ;
    cs:do [
        cs:description "Create pure functions that rely only on their inputs to compute the output." ;
        cs:language "typescript" ;
        cs:code """
const calculatePrice = (basePrice: number, taxRate: number): number => {
  return basePrice * (1 + taxRate);
};
    """
    ] ;
    cs:do [
        cs:description "Annotate and document impure functions that perform I/O or modify external state, explaining why impurity is necessary using @note." ;
        cs:language "typescript" ;
        cs:code """
/**
 * Writes data to the file system.
 * @note - This function is impure - it modifies the file system.
 */
function writeOutputToFile(data: string, path: string) {
  fs.writeFileSync(path, data);
}
    """
    ] ;
    cs:dont [
        cs:description "Create impure functions without annotation or documentation." ;
        cs:language "typescript" ;
        cs:code """
let total = 0;
const addToTotal = (value: number) => {
  total += value; // Modifies external state, not documented
};
    """
    ] ;
    cs:dont [
        cs:description "Hide side effects in functions that appear pure." ;
        cs:language "typescript" ;
        cs:code """
function getConfig() {
  // Reads from disk without annotation
  return fs.readFileSync('config.json');
}
    """
    ] .

# Function Composition Standard
cs:code.function.composition a cs:CodeStandard ;
    rdfs:label "One responsibility per function"@en ;
    cs:hasCategory cs:code ;
    cs:description "Each function must handle exactly one specific task. Complex operations must be broken down into smaller, single-purpose functions." ;
    cs:do [
        cs:description "Define functions with a single, clear responsibility." ;
        cs:language "typescript" ;
        cs:code """
const validateEmail = (email: string): boolean => {
  return /^[^@]+@[^@]+\\.[^@]+$/.test(email);
};
    """
    ] ;
    cs:do [
        cs:description "Compose single-purpose functions to build complex logic." ;
        cs:language "typescript" ;
        cs:code """
const validatePassword = (password: string): boolean => {
  return password.length >= 8;
};

const validateForm = (email: string, password:string): boolean => {
  return validateEmail(email) && validatePassword(password);
};
    """
    ] ;
    cs:dont [
        cs:description "Mix multiple responsibilities in a single function." ;
        cs:language "typescript" ;
        cs:code """
const processUserData = (user: any) => {
  // Validates user data
  // Transforms the data
  // Saves to the database
  // Sends a notification
};
    """
    ] .

# Function Location Standard
cs:code.function.location a cs:CodeStandard ;
    rdfs:label "Define functions near their use"@en ;
    cs:hasCategory cs:code ;
    cs:description "Functions must be defined as close to their broadest point of use as possible. Shared utilities must be placed in a common location, and each function must serve a single feature or responsibility." ;
    cs:do [
        cs:description "Place functions in the file or module where they are most broadly used. If a function is shared across multiple components or modules, place it in a common utility location." ;
        cs:language "typescript" ;
        cs:code """
// utils/math.ts
export function calculateSum(a: number, b: number): number {
  return a + b;
}

// Used in multiple places
import { calculateSum } from './utils/math.js';

// For single-use functions, keep them close to their usage:
    """
    ] ;
    cs:dont [
        cs:description "Place functions far from where they are used, or in a generic location if only used in one place." ;
        cs:language "typescript" ;
        cs:code """
// utils/validators.ts
export const validateUser = (user: User) => { ... }; // Only used in one component

// services/UserService.ts
import { validateUser } from '../utils/validators.js'; // Less ideal if only used here

// Don't mix unrelated functions in a single file:
    """
    ] .

# API Stability Standard
cs:code.api.stability a cs:CodeStandard ;
    rdfs:label "Mark experimental APIs"@en ;
    cs:hasCategory cs:code ;
    cs:description "Experimental APIs must be marked with the @experimental JSDoc tag in type definition files. The tag must include a description of what is experimental." ;
    cs:do [
        cs:description "Mark an experimental interface with a clear @experimental JSDoc tag and description." ;
        cs:language "typescript" ;
        cs:code """
/**
 * Configuration for the data processing pipeline.
 * @experimental The streaming API is experimental and may change
 * in future releases. Currently, it only supports JSON data.
 */
interface PipelineConfig {
  // ...
}
    """
    ] ;
    cs:do [
        cs:description "Add an @experimental tag to a specific property with context about its experimental status." ;
        cs:language "typescript" ;
        cs:code """
interface PipelineConfig {
  /**
   * @experimental The custom transformers API is in beta, and the interface
   * may change to support stronger type validation.
   */
  transformers?: DataTransformer[];
}
    """
    ] ;
    cs:do [
        cs:description "Describe the experimental status and any future plans for the API." ;
        cs:language "typescript" ;
        cs:code """
interface CacheConfig {
  /**
   * @experimental The distributed cache API is experimental and will be
   * replaced with a new consensus-based implementation in v2.1.
   */
  distributed?: boolean;
}
    """
    ] ;
    cs:dont [
        cs:description "Use the @experimental tag without an explanation." ;
        cs:language "typescript" ;
        cs:code """
interface ProcessorConfig {
  /** @experimental */ // Bad: No context provided.
  streaming?: boolean;
}
    """
    ] ;
    cs:dont [
        cs:description "Use the @experimental tag without describing what is experimental." ;
        cs:language "typescript" ;
        cs:code """
/**
 * @experimental // Bad: No description of what is experimental.
 */
interface QueueConfig {
  processor: (item: any) => Promise<void>;
}
    """
    ] .

# Function Verb Naming Standard
cs:code.naming.function_verb a cs:CodeStandard ;
    rdfs:label "Name functions with a verb"@en ;
    cs:hasCategory cs:code ;
    cs:description "All function and method names must start with a verb that describes the action the function performs. Names like `pathToX` or `dataForUser` describe a result, not an action — use `findPathToX` or `fetchDataForUser` instead. This makes the function's intent immediately clear and distinguishes functions from plain values or constants. One exception: the members of a message record (a `MessageRecord` from `@canonical/i18n-core`) are named after the words they produce, whether a member holds text or a function that returns text, so code reads a record as words (`m.heading`, `m.instanceCount(3)`). Every function outside a record keeps the rule, including each locale's factory, such as `createFrench`." ;
    cs:do [
        cs:description "Start function names with an action verb" ;
        cs:language "typescript" ;
        cs:code """
const findPathToModule = (name: string): string => { /* ... */ };
const fetchDataForUser = (userId: string): Promise<User> => { /* ... */ };
const parseConfigFile = (path: string): Config => { /* ... */ };
const calculateTotalPrice = (items: Item[]): number => { /* ... */ };
const isValidEmail = (email: string): boolean => { /* ... */ };
const hasPermission = (user: User, action: string): boolean => { /* ... */ };
    """
    ] ;
    cs:do [
        cs:description "Use descriptive verb prefixes that convey the operation" ;
        cs:language "typescript" ;
        cs:code """
// Retrieval: get, fetch, find, resolve, load, read
const getUser = (id: string): User => { /* ... */ };
const fetchOrders = (): Promise<Order[]> => { /* ... */ };
const findMatchingRule = (rules: Rule[], input: string): Rule | undefined => { /* ... */ };

// Transformation: format, parse, convert, transform, map, normalize
const formatDate = (date: Date): string => { /* ... */ };
const parseResponse = (raw: string): Response => { /* ... */ };

// Validation: is, has, can, should, validate, check
const isActive = (user: User): boolean => { /* ... */ };
const hasExpired = (token: Token): boolean => { /* ... */ };
const validateInput = (data: unknown): data is FormData => { /* ... */ };

// Mutation: set, update, add, remove, delete, reset, clear
const setTheme = (theme: Theme): void => { /* ... */ };
const removeItem = (id: string): void => { /* ... */ };

// Creation: create, build, generate, compose, make
const createConnection = (config: Config): Connection => { /* ... */ };
const buildQuery = (params: Params): string => { /* ... */ };
    """
    ] ;
    cs:do [
        cs:description "Name the members of a message record after the words they produce, and name the factory that builds the record with a verb" ;
        cs:language "typescript" ;
        cs:code """
// A record member is read as words, so it is named after them, not after an action.
export default function createFrench(f: Formatters): InstanceMessages {
  return {
    heading: "Instances",
    instanceCount: (count) =>
      f.selectPlural(count, {
        one: `${f.formatNumber(count)} instance`,
        many: `${f.formatNumber(count)} d’instances`,
        other: `${f.formatNumber(count)} instances`,
      }),
  };
}
    """
    ] ;
    cs:dont [
        cs:description "Name functions as nouns or noun phrases — they read like values, not actions" ;
        cs:language "typescript" ;
        cs:code """
// Bad: reads like a variable, not a function
const pathToModule = (name: string): string => { /* ... */ };
// Good: findPathToModule

const dataForUser = (userId: string): Promise<User> => { /* ... */ };
// Good: fetchDataForUser

const userPermissions = (user: User): Permission[] => { /* ... */ };
// Good: getPermissions or listPermissions
    """
    ] ;
    cs:dont [
        cs:description "Use vague or non-descriptive verbs that don't convey meaning" ;
        cs:language "typescript" ;
        cs:code """
// Bad: "do" and "process" are too vague on their own
const doEmail = (email: string) => { /* ... */ };
// Good: sendEmail, validateEmail, formatEmail

const processUser = (user: User) => { /* ... */ };
// Good: activateUser, deactivateUser, updateUser
    """
    ] .

# Constants File Standard
cs:code.constants.file a cs:CodeStandard ;
    rdfs:label "Domain constants in constants.ts"@en ;
    cs:hasCategory cs:code ;
    cs:description "Domain constants live in their domain's `constants.ts` as named plain values; frozen records, frozen arrays and `as const` literals are plain values. Except: a constant one file uses stays in that file." ;
    cs:do [
        cs:description "Name plain and frozen values in `constants.ts`" ;
        cs:language "typescript" ;
        cs:code """
// features/pricing/constants.ts
export const TAX_RATE = 0.21;
export const CURRENCIES = Object.freeze(["USD", "EUR"] as const);
    """
    ] ;
    cs:dont [
        cs:description "Put functions or types in `constants.ts`" ;
        cs:language "typescript" ;
        cs:code """
export const formatRetry = (n: number) => `Retry ${n}`;
export type Currency = "USD" | "EUR";
    """
    ] .

# Types File Standard
cs:code.types.file a cs:CodeStandard ;
    rdfs:label "Reusable types in types.ts"@en ;
    cs:hasCategory cs:code ;
    cs:description "Types several files use live in their domain's `types.ts`; a type one file uses stays inline. Except: a framework standard's types file wins (component Props in the folder's `types.ts`, hook types in `hooks/types.ts`); shared test and story types live in `testing/types.ts`." ;
    cs:do [
        cs:description "Keep a domain's shared types in its `types.ts`" ;
        cs:code """
features/pricing/
├── index.ts
├── types.ts            # shared pricing types
├── calculatePrice.ts
└── calculatePrice.test.ts
    """
    ] ;
    cs:dont [
        cs:description "Declare a shared type in an implementation file" ;
        cs:language "typescript" ;
        cs:code """
// calculatePrice.ts
export type Currency = "USD" | "EUR";
    """
    ] .

# Non-Null Assertion Standard
cs:code.assertion.non_null a cs:CodeStandard ;
    rdfs:label "Assert invariants at runtime"@en ;
    cs:hasCategory cs:code ;
    cs:description "Prefer runtime assertions over non-null assertions (`!`). TypeScript's `!` operator suppresses null/undefined checks at the type level without any runtime effect. When the invariant breaks (refactoring, upstream change), the program silently proceeds with `undefined` instead of failing fast. Use a runtime assert to document the invariant and fail visibly. Exception: inline expressions where a throw would add noise (`.map()` callbacks, ternaries). There `as T` or `!` are acceptable when the proof is on the same line." ;
    cs:do [
        cs:description "Use a runtime assertion to document and enforce the invariant." ;
        cs:language "typescript" ;
        cs:code """
// assertInvariant throws if the value is null or undefined
const first = assertInvariant(items.at(0), "expected at least one item");
    """
    ] ;
    cs:do [
        cs:description "In inline expressions where an assertion would add noise, `as T` or `!` is acceptable when the proof is on the same line." ;
        cs:language "typescript" ;
        cs:code """
// Acceptable — filter guarantees non-empty rows, proof is one line up
const maxLen = Math.max(...rows.map((r) => (r.name as string).length));
    """
    ] ;
    cs:dont [
        cs:description "Use `!` to suppress the type checker — it has no runtime effect and fails silently when the invariant breaks." ;
        cs:language "typescript" ;
        cs:code """
const first = items.at(0)!;
    """
    ] ;
    cs:dont [
        cs:description "Use `as T` to cast away nullability outside of inline expressions." ;
        cs:language "typescript" ;
        cs:code """
const config = loadConfig() as Config;
    """
    ] .

# Safe Array Access Standard
cs:code.array.safe_access a cs:CodeStandard ;
    rdfs:label "Safe array access with .at()"@en ;
    cs:hasCategory cs:code ;
    cs:description "Use `.at(index)` instead of bracket notation for array element access. Bracket notation (`arr[i]`) returns `T` in TypeScript even though the index may be out of bounds — the type system hides a potential `undefined`. `.at(index)` returns `T | undefined`, making the fallibility visible at the type level and forcing callers to handle the missing case." ;
    cs:do [
        cs:description "Use `.at()` for index-based array access." ;
        cs:language "typescript" ;
        cs:code """
// .at() returns T | undefined — callers must handle the missing case
const first = items.at(0);
const last = items.at(-1);
    """
    ] ;
    cs:dont [
        cs:description "Use bracket notation — TypeScript infers `T` instead of `T | undefined`, hiding potential out-of-bounds access." ;
        cs:language "typescript" ;
        cs:code """
// TypeScript says this is `string`, but it can be `undefined` at runtime
const first = items[0];
    """
    ] .

# Defensive Fallback Standard
cs:code.fallback.defensive a cs:CodeStandard ;
    rdfs:label "Defensive fallbacks at external boundaries"@en ;
    cs:hasCategory cs:code ;
    cs:description """Defensive fallbacks (`?? ""`, `?? 0`, `?? []`) at external API boundaries are correct even when the left side appears guaranteed. External contracts change, APIs have bugs, and types lie. Keep the fallback as runtime safety. When the `??` creates an untestable V8 branch, annotate with `v8 ignore` per `cs:testing.coverage.ignore_pragma` rather than removing the fallback. This does NOT apply to internal code where the guarantee is structural — there, the `??` is noise and an explicit assertion per `cs:code.assertion.non_null` is preferred.""" ;
    cs:do [
        cs:description "Use defensive `??` fallbacks at external boundaries, even when the left side appears guaranteed." ;
        cs:language "typescript" ;
        cs:code """
// Defensive — safe even if the upstream API contract changes
const name = response.headers.get("x-request-id") ?? "";
const retries = Number.parseInt(env.MAX_RETRIES ?? "3", 10);
    """
    ] ;
    cs:dont [
        cs:description "Trust external contracts with unsafe casts instead of defensive fallbacks." ;
        cs:language "typescript" ;
        cs:code """
const name = response.headers.get("x-request-id") as string;
const retries = Number.parseInt(env.MAX_RETRIES as string, 10);
    """
    ] .
