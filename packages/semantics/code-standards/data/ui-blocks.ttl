@prefix cs: <http://pragma.canonical.com/codestandards#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cs:ui_blocks a cs:Category ;
    rdfs:label "UI Blocks"@en ;
    rdfs:comment "Framework-agnostic capabilities and patterns for implementing UI blocks"@en ;
    cs:slug "ui-blocks" .

cs:ui_blocks.nojs a cs:Category ;
    rdfs:label "No-JavaScript"@en ;
    rdfs:comment "UI block capabilities delivered without client-side JavaScript, using semantic HTML and declarative platform features"@en ;
    skos:broader cs:ui_blocks ;
    cs:slug "ui-blocks-nojs" ;
    skos:scopeNote "These standards apply where requirements include operation before or without client-side JavaScript. They do not apply to flows explicitly dependent on a client-side application runtime. Use declarative platform features only when they meet the product's browser-support requirements, or provide an appropriate fallback."@en .

cs:ui_blocks.principles.scripting_progressive_enhancement a cs:CodeStandard ;
    rdfs:label "Progressive enhancement baseline"@en ;
    cs:hasCategory cs:ui_blocks ;
    cs:description "Build every UI block in layers: semantic HTML first, CSS for presentation and declarative interactivity second, and client-side JavaScript as an optional final layer. The primary task must still work when JavaScript does not load or is disabled." ;
    cs:do [
        cs:description "Render the core task in HTML that works on its own; a real link navigates and a real form submits to a server endpoint." ;
        cs:language "html" ;
        cs:code """
<form action="/search" method="get">
  <label for="q">Search</label>
  <input id="q" name="q" type="search" required />
  <button type="submit">Search</button>
</form>
        """
    ] ;
    cs:dont [
        cs:description "Gate the core task behind JavaScript so it is unreachable until, and unless, a script runs." ;
        cs:language "html" ;
        cs:code """
<div class="button" onclick="doSearch()">Search</div>
        """
    ] .

cs:ui_blocks.nojs.aria_contracts a cs:CodeStandard ;
    rdfs:label "Honor ARIA behavior contracts"@en ;
    cs:hasCategory cs:ui_blocks.nojs ;
    cs:description "Do not server-render ARIA roles, states, or properties that advertise interactive behavior unless that behavior is available at first paint. If behavior depends on scripting, gate ARIA contracts until hydration confirms scripting is active. Use native semantics as the baseline." ;
    cs:do [
          cs:description "Render a semantic baseline first; apply ARIA contracts only after hydration and behavior wiring are active." ;
          cs:language "html" ;
          cs:code """
<nav><a href="#overview">Overview</a> <a href="#specs">Specs</a></nav>
<section id="overview"><h2>Overview</h2>...</section>
<section id="specs"><h2>Specs</h2>...</section>

<script type="module">
    const tabs = document.querySelector('nav');
    if (tabs) {
        // After hydration and keyboard behavior setup, apply ARIA tab roles/states.
    }
</script>
        """
    ] ;
    cs:dont [
        cs:description "Server-render ARIA semantics before hydration when scripts may fail or be unavailable." ;
        cs:language "html" ;
        cs:code """
<div role="tablist">
  <button role="tab" aria-selected="true" aria-controls="overview">Overview</button>
  <button role="tab" aria-selected="false" aria-controls="specs">Specs</button>
</div>
        """
    ] .

cs:ui_blocks.nojs.invoker_commands a cs:CodeStandard ;
    rdfs:label "Declarative button behavior with invoker commands"@en ;
    cs:hasCategory cs:ui_blocks.nojs ;
    cs:description "Wire buttons to interactive elements declaratively with the Invoker Commands API (`command` and `commandfor`) instead of attaching click listeners when possible. Prefer built-in commands (`toggle-popover`, `show-modal`, `close`, `request-close`) over custom commands that require JavaScript. See cs:ui_blocks.nojs.popover. See cs:ui_blocks.nojs.dialog." ;
    cs:do [
        cs:description "Use a built-in command to toggle a popover with no event listener." ;
        cs:language "html" ;
        cs:code """
<button commandfor="tips" command="toggle-popover">Tips</button>
<div id="tips" popover>Keyboard shortcuts: ...</div>
        """
    ] ;
    cs:dont [
        cs:description "Reach for a click listener for an action the platform already provides declaratively." ;
        cs:language "javascript" ;
        cs:code """
document.querySelector('#btn').addEventListener('click', () => tips.togglePopover());
        """
    ] .

cs:ui_blocks.nojs.disclosure a cs:CodeStandard ;
    rdfs:label "Disclosure and accordion with details/summary"@en ;
    cs:hasCategory cs:ui_blocks.nojs ;
    cs:description "Use native `<details>` and `<summary>` for disclosure. Use a shared `name` attribute to create a single-open accordion without JavaScript. Do not add `role` or `aria-expanded`; the element manages semantics and state." ;
    cs:do [
        cs:description "Build a single-open accordion by giving each `<details>` the same `name`." ;
        cs:language "html" ;
        cs:code """
<details name="faq">
  <summary>How do I reset my password?</summary>
  <p>Use the reset link on the sign-in page.</p>
</details>
<details name="faq">
  <summary>How do I contact support?</summary>
  <p>Email support@example.com.</p>
</details>
        """
    ] ;
    cs:dont [
        cs:description "Re-implement disclosure with a generic element and JavaScript, losing built-in focus, keyboard, and state semantics." ;
        cs:language "html" ;
        cs:code """
<div class="summary" onclick="toggle(this)">How do I reset my password?</div>
<div class="panel" hidden>Use the reset link on the sign-in page.</div>
        """
    ] .

cs:ui_blocks.nojs.popover a cs:CodeStandard ;
    rdfs:label "Non-modal overlays with the Popover API"@en ;
    cs:hasCategory cs:ui_blocks.nojs ;
    cs:description "Use the declarative Popover API (`popover` with `popovertarget`) for non-modal overlays such as menus, tooltips, and toasts. Use a real `<button>` as the trigger." ;
    cs:do [
        cs:description "Toggle a non-modal menu declaratively with popovertarget." ;
        cs:language "html" ;
        cs:code """
<button popovertarget="menu">Actions</button>
<div id="menu" popover>
  <button>Rename</button>
  <button>Delete</button>
</div>
        """
    ] ;
    cs:dont [
        cs:description "Hand-roll an overlay with manual outside-click and Escape handling that only works once JavaScript runs." ;
        cs:language "html" ;
        cs:code """
<button onclick="openMenu()">Actions</button>
<div class="menu" style="display:none" id="menu"><!-- bespoke dismiss logic --></div>
        """
    ] .

cs:ui_blocks.nojs.dialog a cs:CodeStandard ;
    rdfs:label "Modal dialogs with the dialog element"@en ;
    cs:hasCategory cs:ui_blocks.nojs ;
    cs:description "Use native `<dialog>` for modal dialogs and control it declaratively with invoker commands (`show-modal` and `close`). See cs:ui_blocks.nojs.invoker_commands." ;
    cs:do [
        cs:description "Open and close a modal declaratively with invoker commands." ;
        cs:language "html" ;
        cs:code """
<button commandfor="confirm" command="show-modal">Delete</button>
<dialog id="confirm" aria-labelledby="confirm-title">
  <h2 id="confirm-title">Delete item?</h2>
  <button commandfor="confirm" command="close">Cancel</button>
</dialog>
        """
    ] ;
    cs:dont [
        cs:description "Fake a modal with a positioned div, which lacks focus trapping and background inertness." ;
        cs:language "html" ;
        cs:code """
<div class="overlay"><div class="modal" role="dialog">...</div></div>
        """
    ] .

cs:ui_blocks.nojs.toggles a cs:CodeStandard ;
    rdfs:label "Form-state toggles, not checkbox hacks"@en ;
    cs:hasCategory cs:ui_blocks.nojs ;
    cs:description "Use `:checked` styling for real form state only (checkboxes and radios that submit values). Do not repurpose hidden checkboxes to power menus, dialogs, or disclosure; use `<details>`, `popover`, or `<dialog>` instead. See cs:ui_blocks.nojs.disclosure. See cs:ui_blocks.nojs.popover. See cs:ui_blocks.nojs.dialog." ;
    cs:do [
        cs:description "Use a real checkbox for a real on/off setting that submits with the form." ;
        cs:language "html" ;
        cs:code """
<label><input type="checkbox" name="notifications" /> Email notifications</label>
        """
    ] ;
    cs:dont [
        cs:description "Drive a navigation menu with a hidden checkbox, exposing checkbox semantics for a button-like control." ;
        cs:language "html" ;
        cs:code """
<input type="checkbox" id="nav-toggle" hidden>
<label for="nav-toggle">Menu</label>
<nav class="drawer"><!-- shown via #nav-toggle:checked ~ .drawer --></nav>
        """
    ] .

cs:ui_blocks.forms.native_validation a cs:CodeStandard ;
    rdfs:label "Native form validation"@en ;
    cs:hasCategory cs:ui_blocks ;
    cs:description "Express form constraints with native HTML attributes (e.g., `required`, `type=email`, `pattern`, `min`, `max`, `minlength`, etc.) and style state with `:user-valid` and `:user-invalid`. Treat native validation as the baseline; advanced JavaScript validation may be layered on top, not used as a replacement." ;
    cs:do [
        cs:description "Declare constraints natively and style after interaction." ;
        cs:language "html" ;
        cs:code """
<label for="email">Email</label>
<input id="email" name="email" type="email" required />
<style>
  input:user-invalid { border-color: var(--ds-color-negative); }
</style>
        """
    ] ;
    cs:dont [
        cs:description "Disable native validation by default and rebuild it in JavaScript." ;
        cs:language "html" ;
        cs:code """
<form novalidate>
  <input name="email" /><!-- all checks deferred to a script -->
</form>
        """
    ] .

cs:ui_blocks.media.lazy_loading a cs:CodeStandard ;
    rdfs:label "Native lazy media loading"@en ;
    cs:hasCategory cs:ui_blocks ;
    cs:description "Use native lazy-loading (`loading=lazy`, `decoding=async`) and responsive sources (`srcset`, `sizes`) instead of JavaScript lazy-loader patterns." ;
    cs:do [
        cs:description "Defer offscreen images natively while keeping a real, responsive source." ;
        cs:language "html" ;
        cs:code """
<img src="card-800.jpg" srcset="card-400.jpg 400w, card-800.jpg 800w"
     sizes="(max-width: 600px) 400px, 800px"
     width="800" height="450" loading="lazy" decoding="async" alt="Product overview" />
        """
    ] ;
    cs:dont [
        cs:description "Defer real media sources to JavaScript with placeholder-src lazy-loader patterns." ;
        cs:language "html" ;
        cs:code """
<img src="blank.gif" data-src="card-800.jpg" class="lazy" alt="Product overview" />
        """
    ] .
