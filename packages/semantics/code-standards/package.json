{
  "name": "@canonical/code-standards",
  "version": "0.43.0",
  "description": "Code standards ontology and documentation generator",
  "type": "module",
  "scripts": {
    "build": "bun run docs",
    "check": "biome check && tsc --noEmit && bun run docs:check",
    "check:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "docs": "bun src/scripts/generate-docs.ts",
    "docs:check": "bun run docs && git diff --exit-code docs/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@canonical/biome-config": "^0.43.0",
    "@canonical/typescript-config": "^0.43.0",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-core"
  },
  "bugs": {
    "url": "https://github.com/canonical/pragma-core/issues"
  },
  "homepage": "https://github.com/canonical/pragma-core#readme"
}
