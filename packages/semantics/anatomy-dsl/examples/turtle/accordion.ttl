@prefix : <https://anatomy.canonical.com/> .
@prefix dt: <https://dt.canonical.com/> .

[] a :Specification ;
    :rootNode [
        a :NamedNode ;
        :uri "global.component.accordion" ;
        :hasStyle
            [ a :Style ; :styleKey "layout.type" ; :styleValue "grid" ] ,
            [ a :Style ; :styleKey "appearance.border.width" ; :styleValue "dimension.stroke.thickness.medium" ; :consumes ( dt:dimension.stroke.thickness.medium ) ] ,
            [ a :Style ; :styleKey "appearance.border.style" ; :styleValue "solid" ] ,
            [ a :Style ; :styleKey "appearance.border.color" ; :styleValue "color.border.muted" ; :consumes ( dt:color.border.muted ) ] ,
            [ a :Style ; :styleKey "appearance.radius" ; :styleValue "dimension.radius.medium" ; :consumes ( dt:dimension.radius.medium ) ] ;
        :hasEdge [
            a :Edge ;
            :edgeTarget [
                a :NamedNode ;
                :uri "global.subcomponent.accordion-item" ;
                :hasEdge [
                    a :Edge ;
                    :edgeTarget [
                        a :NamedNode ;
                        :uri "global.subcomponent.accordion-item_header" ;
                        :hasStyle
                            [ a :Style ; :styleKey "layout.type" ; :styleValue "flex" ] ,
                            [ a :Style ; :styleKey "layout.align" ; :styleValue "center" ] ,
                            [ a :Style ; :styleKey "interaction.cursor" ; :styleValue "pointer" ] ,
                            [ a :Style ; :styleKey "appearance.background" ; :styleValue "[surface.color.background, color.background.container]" ; :consumes ( dt:surface.color.background dt:color.background.container ) ] ,
                            [ a :Style ; :styleKey "typography.color" ; :styleValue "[modifier.color.text, color.text]" ; :consumes ( dt:modifier.color.text dt:color.text ) ] ,
                            [ a :Style ; :styleKey "typography.weight" ; :styleValue "typography.weight.semiBold" ; :consumes ( dt:typography.weight.semiBold ) ] ,
                            [ a :Style ; :styleKey "spacing.internal.inline.start" ; :styleValue "spacing.inset.surface.inline" ; :consumes ( dt:spacing.inset.surface.inline ) ] ,
                            [ a :Style ; :styleKey "spacing.internal.inline.end" ; :styleValue "spacing.inset.surface.inline" ; :consumes ( dt:spacing.inset.surface.inline ) ] ,
                            [ a :Style ; :styleKey "spacing.internal.block.start" ; :styleValue "spacing.inset.strip.block" ; :consumes ( dt:spacing.inset.strip.block ) ] ,
                            [ a :Style ; :styleKey "spacing.internal.block.end" ; :styleValue "spacing.inset.strip.block" ; :consumes ( dt:spacing.inset.strip.block ) ] ,
                            [ a :Style ; :styleKey "motion.property" ; :styleValue "background-color" ] ,
                            [ a :Style ; :styleKey "motion.duration" ; :styleValue "150ms" ] ,
                            [ a :Style ; :styleKey "motion.easing" ; :styleValue "ease" ]
                    ] ;
                    :hasRelation [
                        a :Relation ;
                        :cardinality "1" ;
                        :slotName "header"
                    ]
                ] , [
                    a :Edge ;
                    :edgeTarget [
                        a :NamedNode ;
                        :uri "global.subcomponent.accordion-item_content" ;
                        :hasStyle
                            [ a :Style ; :styleKey "layout.type" ; :styleValue "block" ] ,
                            [ a :Style ; :styleKey "layout.overflow" ; :styleValue "hidden" ] ,
                            [ a :Style ; :styleKey "spacing.internal.inline.start" ; :styleValue "spacing.inset.continuation.inline" ; :consumes ( dt:spacing.inset.continuation.inline ) ] ,
                            [ a :Style ; :styleKey "spacing.internal.inline.end" ; :styleValue "spacing.inset.continuation.inline" ; :consumes ( dt:spacing.inset.continuation.inline ) ] ,
                            [ a :Style ; :styleKey "spacing.internal.block.end" ; :styleValue "spacing.inset.surface.block" ; :consumes ( dt:spacing.inset.surface.block ) ] ,
                            [ a :Style ; :styleKey "typography.color" ; :styleValue "[modifier.color.text, color.text]" ; :consumes ( dt:modifier.color.text dt:color.text ) ]
                    ] ;
                    :hasRelation [
                        a :Relation ;
                        :cardinality "1" ;
                        :slotName "default"
                    ]
                ]
            ] ;
            :hasRelation [
                a :Relation ;
                :cardinality "1..*"
            ]
        ]
    ] .
