@prefix : <https://anatomy.canonical.com/> .

[] a :Specification ;
    :rootNode [
        a :NamedNode ;
        :uri "global.component.field" ;
        :hasEdge [
            a :Edge ;
            :edgeSwitch [
                a :Switch ;
                :discriminator "props" ;
                :hasCase [
                    a :SwitchCase ;
                    :caseNode [
                        a :NamedNode ;
                        :uri "global.component.checkbox"
                    ]
                ] , [
                    a :SwitchCase ;
                    :caseNode [
                        a :NamedNode ;
                        :uri "global.component.radio"
                    ]
                ] , [
                    a :SwitchCase ;
                    :caseNode [
                        a :NamedNode ;
                        :uri "global.component.text-input"
                    ]
                ]
            ] ;
            :hasRelation [
                a :Relation ;
                :cardinality "1" ;
                :slotName "input"
            ]
        ]
    ] .
