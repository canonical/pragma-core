{
  "name": "@canonical/anatomy-dsl",
  "description": "Anatomy DSL meta-model: TypeScript types mirroring the OWL ontology, and a YAML-to-Turtle transform",
  "version": "0.43.0",
  "type": "module",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./definitions/*": "./definitions/*"
  },
  "files": [
    "dist",
    "definitions"
  ],
  "license": "LGPL-3.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "check": "biome check && tsc --noEmit",
    "check:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "generate:registry": "bun run src/generate.ts registry",
    "generate:shapes": "bun run src/generate.ts shapes",
    "generate": "bun run src/generate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@canonical/biome-config": "^0.43.0",
    "@canonical/token-ontology": "^0.43.0",
    "@canonical/typescript-config": "^0.43.0",
    "@types/n3": "^1.26.3",
    "@types/node": "^26.4.0",
    "expect-type": "^1.3.0",
    "n3": "^1.26.0",
    "rdf-validate-shacl": "^0.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-core"
  },
  "bugs": {
    "url": "https://github.com/canonical/pragma-core/issues"
  },
  "homepage": "https://github.com/canonical/pragma-core#readme"
}
