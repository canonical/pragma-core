{
  "name": "@canonical/terrazzo-plugin-css",
  "version": "0.43.0",
  "description": "Terrazzo CSS plugin for Canonical design tokens. Transforms DTCG tokens into CSS custom properties with light-dark(), modifier families, @layer ordering, and @media scoping.",
  "type": "module",
  "license": "LGPL-3.0",
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-core"
  },
  "bugs": {
    "url": "https://github.com/canonical/pragma-core/issues"
  },
  "homepage": "https://github.com/canonical/pragma-core#readme",
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "terrazzo",
    "canonical",
    "dtcg",
    "light-dark",
    "css-layers"
  ],
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:tsc",
    "build:all": "bun run build",
    "build:tsc": "tsc -p tsconfig.build.json",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:webarchitect": "webarchitect library",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@canonical/token-types": "^0.43.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@canonical/biome-config": "^0.43.0",
    "@canonical/typescript-config": "^0.43.0",
    "@canonical/webarchitect": "^0.43.0",
    "@terrazzo/token-tools": "2.7.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "gitHead": "715800edd9e0cf4743af85aca438b37b08d55667"
}
