exports[`build output snapshots > modifiers.theme.css matches snapshot 1`] = `
"/* Generated by @canonical/terrazzo-plugin-css. DO NOT EDIT. */
@layer ds.modifiers {
	:root {
		color-scheme: light dark;
		--color-backdrop: light-dark(oklch(0% 0 0 / 0.15), oklch(100% 0 0 / 0.15));
		--color-background: light-dark(var(--color-palette-white), var(--color-palette-gray-930));
		--color-background-container: light-dark(var(--color-palette-gray-40), var(--color-palette-gray-990));
		--color-background-contrasted: light-dark(var(--color-palette-black), var(--color-palette-white));
		--color-background-layer2: light-dark(var(--color-palette-gray-20), var(--color-palette-gray-960));
		--color-background-layer3: light-dark(var(--color-palette-white), var(--color-palette-gray-930));
		--color-background-logo: var(--color-brand-primary);
		--color-border: light-dark(var(--color-palette-gray-520), var(--color-palette-gray-398));
		--color-border-branded: light-dark(var(--color-palette-orange-520), var(--color-palette-orange-398));
		--color-border-branded-disabled: light-dark(oklch(83% 0.1 37.97), oklch(32% 0.1 37.76));
		--color-border-category: light-dark(var(--color-palette-gray-520), var(--color-palette-gray-398));
		--color-border-category-disabled: light-dark(oklch(83% 0 0), oklch(32% 0 0));
		--color-border-constructive: light-dark(var(--color-palette-green-520), var(--color-palette-green-398));
		--color-border-constructive-disabled: light-dark(oklch(83% 0.1 144.01), oklch(32% 0.1 144.01));
		--color-border-destructive: light-dark(var(--color-palette-red-520), var(--color-palette-red-398));
		--color-border-destructive-disabled: light-dark(oklch(83% 0.1 23.83), oklch(32% 0.1 24.11));
		--color-border-disabled: light-dark(oklch(83% 0 0), oklch(32% 0 0));
		--color-border-error: light-dark(var(--color-palette-red-520), var(--color-palette-red-398));
		--color-border-error-disabled: light-dark(oklch(83% 0.1 23.83), oklch(32% 0.1 24.11));
		--color-border-highlighted: light-dark(var(--color-palette-black), var(--color-palette-white));
		--color-border-highlighted-disabled: light-dark(oklch(69% 0 0), oklch(45% 0 0));
		--color-border-information: light-dark(var(--color-palette-blue-520), var(--color-palette-blue-398));
		--color-border-information-disabled: light-dark(oklch(83% 0.1 256), oklch(32% 0.1 256.08));
		--color-border-muted: light-dark(var(--color-palette-gray-100), var(--color-palette-gray-820));
		--color-border-muted-disabled: light-dark(oklch(96% 0 0), oklch(23% 0 0));
		--color-border-success: light-dark(var(--color-palette-green-520), var(--color-palette-green-398));
		--color-border-success-disabled: light-dark(oklch(83% 0.1 144.01), oklch(32% 0.1 144.01));
		--color-border-warning: light-dark(var(--color-palette-yellow-520), var(--color-palette-yellow-398));
