  "--surface-color-text": {
    "cssVar": "--surface-color-text",
    "id": null,
    "type": "color",
    "tier": "semantic",
    "visibility": "internal",
    "isPaired": false,
    "cssOutputFile": "modifiers.surfaces.css",
    "derivedFrom": "--color-text-contrasted",
    "derivation": "channel-surface",
    "description": "[EXPERIMENTAL] Text color for a contrasted surface, legible against the contrasted background. This channel is unique to \`contrasted\` (and any future polarity-inverting surface): a depth surface (layer1/2/3) keeps the ambient page polarity, so its text stays \`--color-text\` and it deliberately emits no \`--surface-color-text\`. Consume as \`var(--surface-color-text, var(--color-text))\` — the fallback is the surface family's consistency mechanism: polarity-inverting surfaces override, same-polarity surfaces fall through.",
    "declarations": [
      {
        "selector": ".contrasted",
        "file": "modifiers.surfaces.css",
        "line": 69,
        "atRules": [
          {
            "name": "layer",
            "prelude": "ds.surfaces"
          }
        ]
      }
    ]
  },
