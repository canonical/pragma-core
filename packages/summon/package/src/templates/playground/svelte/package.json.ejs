{
  "name": "<%= name %>",
  "description": "A Storybook playground for prototyping components with the pragma design system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check": "bun run check:biome && bun run check:ts",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
<% if (dsApp) { -%>
    "@canonical/svelte-ds-app": "^<%= webVersion %>",
<% } -%>
<% if (dsGlobal) { -%>
    "@canonical/svelte-ds-global": "^<%= webVersion %>",
<% } -%>
    "@canonical/styles": "^<%= webVersion %>",
    "svelte": "^5.47.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@canonical/biome-config": "^<%= coreVersion %>",
    "@canonical/storybook-config": "^<%= webVersion %>",
    "@canonical/typescript-config-svelte": "^<%= webVersion %>",
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@storybook/svelte-vite": "^10.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "storybook": "^10.6.0",
    "svelte-check": "^4.4.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.1"
  }
}
