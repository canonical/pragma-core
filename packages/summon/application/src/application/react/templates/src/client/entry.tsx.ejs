// The stylesheet comes first, before the routes and before every component
// import below. CSS is emitted in the order the bundler evaluates the modules
// that import it, so a component imported earlier would put its own rules —
// and its own `@layer` blocks — ahead of the design system's layer statement,
// and the layer order a browser applies is the one it reads first. Keeping
// this line at the top is what makes the built stylesheet deterministic.
import "#styles/index.css";
<% if (intl) { -%>
<% if (spa) { -%>
import { negotiateLocale } from "@canonical/i18n-core";
<% } else { -%>
import { isSupportedLocale, negotiateLocale } from "@canonical/i18n-core";
<% } -%>
<% } -%>
import { createBrowserAdapter, createRouter } from "@canonical/router-core";
<% if (!spa) { -%>
import { readDehydratedState } from "@canonical/router-react";
<% } -%>
<% if (spa) { -%>
import { createRoot } from "react-dom/client";
<% } else { -%>
import { hydrateRoot } from "react-dom/client";
<% } -%>
<% if (intl) { -%>
import { i18nConfig } from "#i18n/index.js";
<% } -%>
import Shell from "#lib/Shell/index.js";
<% if (relay) { -%>
import { createEnvironment } from "#relay/environment.js";
import { setPrefetchEnvironment } from "#relay/prefetchEnvironment.js";
<% } -%>
<% if (relay && !spa) { -%>
import type { RelayRecords } from "#relay/types.js";
<% } -%>
import { appRoutes, middleware, notFoundRoute } from "../routes.js";
<% if (relay && spa) { -%>

// Create the browser-session Relay environment and publish it as the prefetch
// environment FIRST — before the router exists — so the warm fired during
// router construction fills the store the first `useLazyLoadQuery` reads. A
// client-only app has no server records to seed from, so the store starts
// empty and the first warm or query fetches.
const relayEnvironment = createEnvironment();
setPrefetchEnvironment(relayEnvironment);
<% } -%>
<% if (relay && !spa) { -%>

/**
 * Whether a value read off `window.__INITIAL_DATA__` can seed a Relay store:
 * the server embeds the records as a plain object keyed by record id. The
 * value crosses a page boundary, so anything else is ignored rather than
 * trusted.
 */
function isRelayRecords(value: unknown): value is RelayRecords {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

// Create the browser-session Relay environment FIRST — before the router
// exists — seeded from the store records riding __INITIAL_DATA__ (SSR pages),
// so the first `useLazyLoadQuery` reads the store instead of refetching. In
// the SPA cells there are no records and the store starts empty. It is
// published as the prefetch environment before the router is created, because
// router construction can fire the matched route's warm, which must fill this
// same store.
const embeddedRelayRecords = (
  window as { __INITIAL_DATA__?: { relayRecords?: unknown } }
).__INITIAL_DATA__?.relayRecords;
const relayEnvironment = createEnvironment({
  records: isRelayRecords(embeddedRelayRecords)
    ? embeddedRelayRecords
    : undefined,
});
setPrefetchEnvironment(relayEnvironment);
<% } -%>

<% if (spa) { -%>
// Nothing was rendered server-side, so there is no dehydrated state to resume
// from: the router always performs a normal initial load.
const router = createRouter(appRoutes, {
  adapter: createBrowserAdapter(),
  middleware: [...middleware],
  notFound: notFoundRoute,
});
<% } else { -%>
// On SSR pages __INITIAL_DATA__ carries the flat dehydrated router state
// (href/kind/routeId/status); hydrating from it resumes the server-rendered
// match and skips the duplicate initial load. In the SPA cells there is no
// payload (or no router fields) and readDehydratedState() returns null, so
// the router performs a normal initial load.
const router = createRouter(appRoutes, {
  adapter: createBrowserAdapter(),
  middleware: [...middleware],
  notFound: notFoundRoute,
  hydratedState: readDehydratedState() ?? undefined,
});
<% } -%>

<% if (intl && spa) { -%>
/**
 * Resolve the locale for the first client render. Nothing negotiated it
 * server-side, so the pure negotiation runs here: the cookie wins, then the
 * browser's language list (the client-side stand-in for the Accept-Language
 * header).
 */
function resolveInitialLocale(): string {
  return negotiateLocale(i18nConfig, {
    cookieHeader: document.cookie,
    acceptLanguage: navigator.languages?.join(",") ?? navigator.language,
  });
}

<% } -%>
<% if (intl && !spa) { -%>
/**
 * Resolve the locale for the first client render.
 *
 * When the page was server-rendered, `window.__INITIAL_DATA__.locale` carries
 * the server's negotiated value — reusing it guarantees the first client
 * render matches the server markup, so hydration stays mismatch-free. In the
 * SPA cells (`dev` / `preview`, no SSR) there is no embedded data, so the
 * same pure negotiation runs here: the cookie wins, then the browser's
 * language list (the client-side stand-in for the Accept-Language header).
 */
function resolveInitialLocale(): string {
  const embedded = (window as { __INITIAL_DATA__?: { locale?: string } })
    .__INITIAL_DATA__?.locale;
  if (isSupportedLocale(i18nConfig, embedded)) return embedded;

  return negotiateLocale(i18nConfig, {
    cookieHeader: document.cookie,
    acceptLanguage: navigator.languages?.join(",") ?? navigator.language,
  });
}

<% } -%>
const root = document.getElementById("root");
if (!root) {
  throw new Error('Root element "#root" not found');
}

<%# One mount site. The formatter keeps the Shell inline in the mount call -%>
<%# while it fits, and breaks it onto its own lines once the props do not. -%>
<% if (relay && intl) { -%>
<% if (spa) { -%>
createRoot(root).render(
<% } else { -%>
hydrateRoot(
  root,
<% } -%>
  <Shell
    router={router}
    environment={relayEnvironment}
    locale={resolveInitialLocale()}
  />,
);
<% } else if (relay) { -%>
<% if (spa) { -%>
createRoot(root).render(
  <Shell router={router} environment={relayEnvironment} />,
);
<% } else { -%>
hydrateRoot(root, <Shell router={router} environment={relayEnvironment} />);
<% } -%>
<% } else if (intl) { -%>
<% if (spa) { -%>
createRoot(root).render(
  <Shell router={router} locale={resolveInitialLocale()} />,
);
<% } else { -%>
hydrateRoot(root, <Shell router={router} locale={resolveInitialLocale()} />);
<% } -%>
<% } else if (spa) { -%>
createRoot(root).render(<Shell router={router} />);
<% } else { -%>
hydrateRoot(root, <Shell router={router} />);
<% } -%>
