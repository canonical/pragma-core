<% if (intl) { -%>
import { useTranslation } from "@canonical/i18n-react";
<% } -%>
<% if (forms) { -%>
import { SelectInput } from "@canonical/react-ds-global-form";
<% } -%>
import { usePreferredTheme } from "@canonical/react-hooks";
import type { ChangeEvent, ReactElement } from "react";

<% if (forms) { -%>
/**
 * Colour-scheme picker driving `usePreferredTheme`. Built on the form
 * package's standalone `SelectInput`, so it wears the design system's input
 * chrome.
 */
<% } else { -%>
/** Colour-scheme picker driving `usePreferredTheme`. */
<% } -%>
export default function ThemeSelector(): ReactElement {
  const { value, source, set, reset } = usePreferredTheme();
<% if (intl) { -%>
  const { t } = useTranslation();
<% } -%>

  function handleChange(event: ChangeEvent<HTMLSelectElement>) {
    const selected = event.target.value;

    if (selected === "system") {
      reset();
    } else {
      set(selected as "light" | "dark");
    }
  }

  const selectValue = source === "system" ? "system" : value;

  return (
<% if (forms) { -%>
    <SelectInput
      aria-label=<%- attr("theme.label", "Color theme") %>
      onChange={handleChange}
      options={[
        { value: "system", label: <%- str("theme.system", "System") %> },
        { value: "light", label: <%- str("theme.light", "Light") %> },
        { value: "dark", label: <%- str("theme.dark", "Dark") %> },
      ]}
      value={selectValue}
    />
<% } else { -%>
    <select
      aria-label=<%- attr("theme.label", "Color theme") %>
      onChange={handleChange}
      value={selectValue}
    >
      <option value="system"><%- msg("theme.system", "System") %></option>
      <option value="light"><%- msg("theme.light", "Light") %></option>
      <option value="dark"><%- msg("theme.dark", "Dark") %></option>
    </select>
<% } -%>
  );
}
