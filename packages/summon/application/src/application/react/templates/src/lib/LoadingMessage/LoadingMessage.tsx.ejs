<% if (intl) { -%>
import { useTranslation } from "@canonical/i18n-react";
<% } -%>
import type { ReactElement } from "react";

/**
 * The route fallback rendered while a page suspends<% if (intl) { %>, in the active
 * locale<% } %>. On the SSR arm the server and the client render the same one, so
 * the streamed shell hydrates without a mismatch.
 *
 * `import { LoadingMessage } from "#lib/index.js";`
 */
export default function LoadingMessage(): ReactElement {
<% if (intl) { -%>
  const { t } = useTranslation();

  return <p>{t("app.loading")}</p>;
<% } else { -%>
  return <p>Loading…</p>;
<% } -%>
}
