<% if (intl) { -%>
import type { Locale } from "@canonical/i18n-core";
<% } -%>
import type { AnyRoute, RouteMap, Router } from "@canonical/router-core";
<% if (relay) { -%>
import type { IEnvironment } from "relay-runtime";
<% } -%>

/** Props accepted by `Shell`. */
export interface ShellProps<
  TRoutes extends RouteMap,
  TNotFound extends AnyRoute | undefined = undefined,
> {
  /** The router whose matched route renders through the nest's `Outlet`. */
  readonly router: Router<TRoutes, TNotFound>;
<% if (relay) { -%>
<% if (spa) { -%>
  /**
   * The browser session's Relay environment, which every query and fragment
   * below the nest reads.
   */
<% } else { -%>
  /**
   * The Relay environment every query and fragment below the nest reads: the
   * browser session's on the client, the request's own on the server.
   */
<% } -%>
  readonly environment: IEnvironment;
<% } -%>
<% if (intl) { -%>
<% if (spa) { -%>
  /**
   * The locale of the first render, which the client entry negotiates from
   * the locale cookie and the browser's languages.
   */
<% } else { -%>
  /**
   * The locale of the first render. The server passes the one it negotiated
   * and the client reuses it, so hydration renders the same language.
   */
<% } -%>
  readonly locale: Locale;
<% } -%>
}
