// Styles first, for the same reason as in the client entry: the order the
// bundler evaluates style imports in is the order the rules are emitted in.
// The server build only needs the application's own sheet — the design
// system's layers reach the browser through the client bundle's stylesheet,
// which the renderer links from the built HTML.
import "#styles/app.css";
<% if (intl) { -%>
import { documentAttrs, isSupportedLocale } from "@canonical/i18n-core";
<% } -%>
import type { ServerEntrypointProps } from "@canonical/react-ssr/renderer";
import {
<% if (relay) { -%>
  type AnyRoute,
<% } -%>
  createRouter,
  createServerAdapter,
  StatusResponse,
} from "@canonical/router-core";
<% if (relay) { -%>
import type { IEnvironment } from "relay-runtime";
<% } -%>
<% if (intl) { -%>
import { i18nConfig } from "#i18n/index.js";
<% } -%>
import Shell from "#lib/Shell/index.js";
<% if (relay) { -%>
import { createEnvironment } from "#relay/environment.js";
import {
  getPrefetchEnvironment,
  setPrefetchEnvironment,
} from "#relay/prefetchEnvironment.js";
import type { RelayRecords } from "#relay/types.js";
<% } -%>
import {
  appRoutes,
  getAuthRedirectForMatch,
  middleware,
  notFoundRoute,
} from "../routes.js";

interface InitialData extends Record<string, unknown> {
  readonly url?: string;
  /** Colour-scheme preference resolved from the request cookie, if any. */
  readonly theme?: "light" | "dark";
  /**
   * Flat dehydrated router state (from resolveRouteDisposition), read back by
   * router-react's readDehydratedState() on the client. Absent in SPA cells.
   */
  readonly href?: string;
  readonly kind?: "route" | "not-found";
  readonly routeId?: string | null;
  readonly status?: number;
<% if (relay) { -%>
  /**
   * The Relay store records the matched route's warm fetched (see
   * `prefetchRouteData`), seeded into the store of both the server render
   * and the client. A dedicated nested key — the router state is flat-spread
   * into this same object, so nesting avoids any collision.
   */
  readonly relayRecords?: RelayRecords;
<% } -%>
<% if (intl) { -%>
  /** Locale negotiated from the request cookie / Accept-Language, if any. */
  readonly locale?: string;
<% } -%>
}

/** How the server should answer a request for this URL. */
export type RouteDisposition =
  | {
      readonly kind: "render";
      readonly status: number;
      readonly dehydratedState: {
        readonly href: string;
        readonly kind: "route" | "not-found";
        readonly routeId: string | null;
        readonly status: number;
      } | null;
    }
  | {
      readonly kind: "redirect";
      readonly status: number;
      readonly location: string;
    };

// A module-scope adapterless router is a pure matcher: without an adapter,
// construction fires no load and no warm hooks, and match() runs no hooks at
// all. Never use a server-adapter router here — it warms at construction.
const dispositionMatcher = createRouter(appRoutes, {
  middleware: [...middleware],
  notFound: notFoundRoute,
});

/**
 * Resolve a request URL to the HTTP answer the router implies: a redirect
 * (auth guard or a static redirect route) or a render with the matched
 * document's real status — a matched not-found page is a 404 response, not a
 * soft 200.
 */
export function resolveRouteDisposition(url: string): RouteDisposition {
  let matchResult: ReturnType<typeof dispositionMatcher.match>;

  try {
    matchResult = dispositionMatcher.match(url);
  } catch (error) {
    // A rejected search schema is a client error; render the shell with the
    // error status and let the client router re-derive the same state.
    return {
      kind: "render",
      status: error instanceof StatusResponse ? error.status : 500,
      dehydratedState: null,
    };
  }

  if (matchResult?.kind === "redirect") {
    return {
      kind: "redirect",
      status: matchResult.status,
      location: matchResult.redirectTo,
    };
  }

  // Auth is decided from the router's own match (pattern + validated search),
  // never from the raw URL — the two normalize differently.
  const authRedirect =
    matchResult?.kind === "route" ? getAuthRedirectForMatch(matchResult) : null;

  if (authRedirect) {
    return { kind: "redirect", status: 302, location: authRedirect };
  }

  const status = matchResult?.status ?? 404;

  return {
    kind: "render",
    status,
    dehydratedState: {
      href: url,
      kind: matchResult?.kind === "route" ? "route" : "not-found",
      routeId: matchResult?.kind === "route" ? String(matchResult.name) : null,
      status,
    },
  };
}

<% if (relay) { -%>
/**
 * Start a route's warm against `environment`, published as the prefetch
 * environment for the synchronous part of the call only: the previous value
 * is restored before this returns. A warm reads the holder before its first
 * `await`, so it captures this request's environment, and no other request
 * can observe it.
 *
 * @note Impure: writes, then restores, the module-scope prefetch environment,
 * and starts whatever side effects the warm performs.
 */
function startRouteWarm(
  route: AnyRoute,
  match: { readonly params: unknown; readonly search: unknown },
  environment: IEnvironment,
  signal: AbortSignal,
): void | Promise<void> {
  const previous = getPrefetchEnvironment();
  setPrefetchEnvironment(environment);

  try {
    return route.warm?.(match.params, match.search, { signal });
  } finally {
    setPrefetchEnvironment(previous);
  }
}

/**
 * Settle as `pending` does, or reject with the abort reason as soon as
 * `signal` aborts, whichever comes first.
 *
 * @note Impure: subscribes to the signal's `abort` event.
 */
function raceAbort(
  pending: void | Promise<void>,
  signal: AbortSignal,
): Promise<void> {
  return Promise.race([
    pending,
    new Promise<never>((_resolve, reject) => {
      signal.addEventListener("abort", () => reject(signal.reason), {
        once: true,
      });
    }),
  ]);
}

/** How long the server waits for a route's warm before rendering without it. */
const SSR_PREFETCH_TIMEOUT_MS = 5_000;

/**
 * Start the prefetch deadline: the returned signal aborts, with an error
 * naming the limit, once `SSR_PREFETCH_TIMEOUT_MS` pass, unless `clear` is
 * called first.
 *
 * @note Impure: schedules a timer, which `clear` cancels.
 */
function startPrefetchDeadline(): {
  readonly signal: AbortSignal;
  readonly clear: () => void;
} {
  const controller = new AbortController();
  const timer = setTimeout(() => {
    controller.abort(
      new Error(`SSR data prefetch exceeded ${SSR_PREFETCH_TIMEOUT_MS}ms`),
    );
  }, SSR_PREFETCH_TIMEOUT_MS);

  return { signal: controller.signal, clear: () => clearTimeout(timer) };
}

/**
 * Run a route's warm against `environment` and settle as it does, or reject
 * once the prefetch deadline passes, whichever comes first. The warm receives
 * the deadline's signal, so a warm that honours it stops fetching then.
 *
 * @note Impure: starts the warm and its deadline timer, and clears the timer
 * once either settles.
 */
async function awaitRouteWarm(
  route: AnyRoute,
  match: { readonly params: unknown; readonly search: unknown },
  environment: IEnvironment,
): Promise<void> {
  const deadline = startPrefetchDeadline();

  try {
    await raceAbort(
      startRouteWarm(route, match, environment, deadline.signal),
      deadline.signal,
    );
  } finally {
    deadline.clear();
  }
}

/**
 * Await the matched route's `warm` against a fresh, request-scoped Relay
 * environment and return that environment's store records in serializable
 * form. Fetch-then-render: the records exist before the renderer is
 * constructed, so they ride the fixed `__INITIAL_DATA__` bootstrap script.
 *
 * Only the route's own warm is awaited. Wrapper warms are not: the router
 * fires them when the client loads.
 *
 * The prefetch is bounded by `SSR_PREFETCH_TIMEOUT_MS`: on the deadline the
 * warm's signal aborts and the page renders without records. A warm that
 * ignores the signal keeps fetching into the discarded environment, but the
 * response no longer waits for it. On any failure the request degrades the
 * same way — render without records, the client fetches after hydration — so
 * a data hiccup never takes the page down.
 *
 * @note Impure: performs whatever I/O the route's warm performs, and logs a
 * warning when the prefetch fails.
 */
export async function prefetchRouteData(
  disposition: RouteDisposition,
): Promise<RelayRecords | undefined> {
  if (
    disposition.kind !== "render" ||
    disposition.dehydratedState?.kind !== "route"
  ) {
    return undefined;
  }

  const match = dispositionMatcher.match(disposition.dehydratedState.href);

  if (match?.kind !== "route" || !match.route.warm) {
    return undefined;
  }

  const environment = createEnvironment();

  try {
    await awaitRouteWarm(match.route, match, environment);
  } catch (error) {
    console.warn(
      "SSR data prefetch failed; rendering without server data (the client will fetch).",
      error,
    );

    return undefined;
  }

  return environment.getStore().getSource().toJSON();
}
<% } else { -%>
/**
 * Resolve the data the server embeds for a route. No data layer is
 * scaffolded, so there is none: every route renders without server data.
 * The signature matches the one the Relay data layer emits, so the renderer
 * and the dev servers call it the same way in every flag combination.
 */
export async function prefetchRouteData(
  disposition: RouteDisposition,
): Promise<undefined> {
  void disposition;

  return undefined;
}
<% } -%>

export default function EntryServer(props: ServerEntrypointProps<InitialData>) {
  const initialData = props.initialData ?? {};
  const url = initialData.url ?? "/";
<% if (relay) { -%>
  // A server-adapter router fires the matched route's warm at construction.
  // No prefetch environment is published outside `prefetchRouteData`'s
  // synchronous call, so that warm finds nothing to fill: this render reads
  // the records `prefetchRouteData` already serialized.
<% } -%>
  const router = createRouter(appRoutes, {
    middleware: [...middleware],
    notFound: notFoundRoute,
    adapter: createServerAdapter(url),
  });
  // A rejected search schema throws from match(); resolveRouteDisposition
  // already turned that into the response status (400-class), so render the
  // shell unhydrated instead of letting the throw reach React — a shell
  // error would override the supplied status with 500. The client router
  // re-derives the same error state on load.
  let serverMatch: ReturnType<typeof router.match>;

  try {
    serverMatch = router.match(url);
  } catch {
    serverMatch = null;
  }

  // Hydrate the store synchronously so render() works without awaiting
  // load(). Redirects and unmatched URLs are the server's concern before
  // rendering, so only real matches hydrate.
  if (serverMatch?.kind === "route" || serverMatch?.kind === "not-found") {
    router.hydrate({
      href: url,
      kind: serverMatch.kind,
      routeId: serverMatch.kind === "route" ? serverMatch.name : null,
      status: serverMatch.status,
    });
  }
<% if (relay) { -%>

  // A fresh Relay environment per server render, so no store state leaks
  // between requests, seeded with the records the matched route's warm
  // fetched — the same records the client seeds its store with, so server
  // markup and first client render read identical data. Without records (the
  // route has no warm, or the prefetch failed) a querying component renders
  // its fallback and the client fetches after hydration.
  const relayEnvironment = createEnvironment({
    records: initialData.relayRecords,
  });
<% } -%>

<% if (intl) { -%>
  // The servers negotiate the locale (cookie > Accept-Language > default,
  // via i18n-core's negotiateLocale) and pass it through initialData; the
  // same value reaches the client via `window.__INITIAL_DATA__`, so the
  // server markup and the first client render agree on the language.
  const locale = isSupportedLocale(i18nConfig, initialData.locale)
    ? initialData.locale
    : i18nConfig.defaultLocale;
  // `<html lang dir>` must be right on first paint for assistive technology
  // and RTL locales; after hydration the client's locale source keeps both
  // attributes in sync with every switch.
  const { lang, dir } = documentAttrs(i18nConfig, locale);

<% } -%>
  // The root declaration plus the theme, on one element. `app` is the context
  // and `comfortable` the density; together they choose the --density-* channel
  // every control reads. The cookie-resolved theme joins them so the first
  // paint is flash-free — it is the same element `usePreferredTheme` toggles on
  // the client, and React does not hydrate it (only `#root` is), so there is no
  // mismatch to reconcile. index.html carries the same classes for the
  // client-only build.
  //
  // Context, density and the theme are the whole of the root contract. Nothing
  // on this element declares the design system itself: its stylesheet applies
  // to the page as it stands.
  return (
<% if (intl) { -%>
    <html
      lang={lang}
      dir={dir}
      className={["app comfortable", initialData.theme]
        .filter(Boolean)
        .join(" ")}
    >
<% } else { -%>
    <html
      lang={props.lang}
      className={["app comfortable", initialData.theme]
        .filter(Boolean)
        .join(" ")}
    >
<% } -%>
      <head>
        {props.otherHeadElements}
        {props.scriptElements}
        {props.linkElements}
      </head>
      <body>
        <div id="root">
<% if (relay && intl) { -%>
          <Shell
            router={router}
            environment={relayEnvironment}
            locale={locale}
          />
<% } else if (relay) { -%>
          <Shell router={router} environment={relayEnvironment} />
<% } else if (intl) { -%>
          <Shell router={router} locale={locale} />
<% } else { -%>
          <Shell router={router} />
<% } -%>
        </div>
      </body>
    </html>
  );
}

export type { InitialData };
