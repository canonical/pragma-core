{
  "name": "<%= name %>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-icons.js && vite dev",
    "build": "node scripts/copy-icons.js && vite build",
    "preview": "<%= spa ? 'vite preview' : 'node build/index.js' %>",
    "storybook": "node scripts/copy-icons.js && storybook dev -p 6009 --no-open",
    "build:storybook": "node scripts/copy-icons.js && storybook build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test test/app.test.js"<% if (forms) { %>,
    "test:browser": "node --test test/contact.browser.test.js"<% } %>
  },
  "dependencies": {
    "@canonical/styles": "<%= pragmaWebVersion %>",
    "@canonical/ds-assets": "<%= pragmaWebVersion %>",
    "@canonical/svelte-ds-global": "<%= pragmaWebVersion %>"<% if (appShell) { %>,
    "@canonical/svelte-ds-app": "<%= pragmaWebVersion %>"<% } %><% if (intl) { %>,
    "@canonical/i18n-core": "<%= pragmaWebVersion %>"<% } %>
  },
  "overrides": { "cookie": "0.7.2" },
  "devDependencies": {
<% if (forms) { %>    "playwright": "1.61.1",
<% } %>
    "@canonical/storybook-config": "<%= pragmaWebVersion %>",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@storybook/sveltekit": "^10.6.0",
    "storybook": "^10.6.0",
    "@sveltejs/adapter-<%= spa ? 'static' : 'node' %>": "<%= spa ? '3.0.10' : '5.5.4' %>",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "^4.4.5",
    "typescript": "~6.0.3",
    "vite": "8.3.5"
  },
  "engines": { "node": "^22.13.0 || ^24.0.0 || ^26.0.0" }
}
