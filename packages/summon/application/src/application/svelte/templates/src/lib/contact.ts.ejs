export const fields = [
  { name: "email", inputType: "email", label: "email", required: true },
  { name: "message", inputType: "textarea", label: "message", required: true },
] as const;
export type FieldName = (typeof fields)[number]["name"];
export type Values = Record<FieldName, string>;
export type Errors = Partial<Record<FieldName, "emailError" | "messageError" | "tooLong">>;
export function decode(data: FormData): Values {
  const readText = (name: FieldName) => { const value = data.get(name); return typeof value === "string" ? value : ""; };
  return { email: readText("email"), message: readText("message") };
}
export function validate(values: Values): Errors {
  const errors: Errors = {};
  if (values.email.length > 4000) errors.email = "tooLong";
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email.trim())) errors.email = "emailError";
  if (values.message.length > 4000) errors.message = "tooLong";
  else if (!values.message.trim()) errors.message = "messageError";
  return errors;
}
