import { fail, redirect } from "@sveltejs/kit";
import { readInstances, releases, isValidInstance } from "$lib/instances";
import type { Actions, PageServerLoad } from "./$types";

export const load: PageServerLoad = ({ cookies, url }) => {
  const instances = readInstances(cookies.get("demo-instances"));
  return { instances, selected: instances.find((instance) => instance.name === url.searchParams.get("selected")), create: url.searchParams.get("create") === "1", release: releases.find((item) => item === url.searchParams.get("release")) ?? "noble" };
};
export const actions: Actions = {
  create: async ({ request, cookies, url }) => {
    const data = await request.formData();
    const name = data.get("name"), release = data.get("release"), cloudInit = data.get("cloudInit");
    const values = { name: typeof name === "string" ? name : "", release: typeof release === "string" ? release : "", pro: data.get("pro") === "on", cloudInit: typeof cloudInit === "string" ? cloudInit : "" };
    const instances = readInstances(cookies.get("demo-instances"));
    if (!isValidInstance(values)) return fail(400, { values, issue: "instanceInvalid" });
    if (instances.some((instance) => instance.name === values.name)) return fail(400, { values, issue: "instanceDuplicate" });
    if (instances.length >= 10) return fail(400, { values, issue: "instanceLimit" });
    const payload = JSON.stringify([...instances, values]);
    if (encodeURIComponent(payload).length > 3000) return fail(400, { values, issue: "instanceLimit" });
    cookies.set("demo-instances", payload, { path: "/", sameSite: "lax", httpOnly: true, secure: url.protocol === "https:", maxAge: 86400 });
    redirect(303, `/dashboard/instances?selected=${encodeURIComponent(values.name)}`);
  },
};
