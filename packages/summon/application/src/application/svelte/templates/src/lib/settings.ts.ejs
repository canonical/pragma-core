export type Settings = { name: string; bridge: string; ipv6: boolean; snapshots: boolean; maxInstances: string };
export const defaults: Settings = { name: "Demo", bridge: "lxdbr0", ipv6: true, snapshots: true, maxInstances: "50" };
export const settingsFields = [
  { inputType: "text", name: "name", label: "displayName", required: true },
  { inputType: "select", name: "bridge", label: "bridge", options: [{ value: "lxdbr0", label: "lxdbr0" }, { value: "ovn-1", label: "ovn-1" }], required: true },
  { inputType: "switch", name: "ipv6", label: "ipv6" },
  { inputType: "number", name: "maxInstances", label: "maxInstances", required: true },
  { inputType: "switch", name: "snapshots", label: "snapshots" },
] as const;
export function isValidMaximum(value: string) { return /^\d{1,3}$/.test(value) && Number(value) >= 1 && Number(value) <= 100; }
export function decodeSettings(data: FormData): Settings {
  const readText = (name: string) => { const value = data.get(name); return typeof value === "string" ? value : ""; };
  return { name: readText("name").trim(), bridge: readText("bridge"), ipv6: data.has("ipv6"), snapshots: data.has("snapshots"), maxInstances: readText("maxInstances") };
}
export function validateSettings(value: Settings) {
  return { ...(!value.name || value.name.length > 60 ? { name: value.name.length > 60 ? "nameTooLong" : "nameError" } : {}), ...(!["lxdbr0", "ovn-1"].includes(value.bridge) ? { bridge: "bridgeError" } : {}), ...(!isValidMaximum(value.maxInstances) ? { maxInstances: "maximumError" } : {}) };
}
export function readSettings(value: string | undefined): Settings {
  if (!value || value.length > 1000) return { ...defaults };
  try {
    const data: unknown = JSON.parse(value);
    if (!data || typeof data !== "object") return { ...defaults };
    const record = data as Record<string, unknown>;
    if (typeof record.name !== "string" || typeof record.bridge !== "string" || typeof record.ipv6 !== "boolean" || typeof record.snapshots !== "boolean" || typeof record.maxInstances !== "string") return { ...defaults };
    const settings: Settings = { name: record.name, bridge: record.bridge, ipv6: record.ipv6, snapshots: record.snapshots, maxInstances: record.maxInstances };
    return Object.keys(validateSettings(settings)).length ? { ...defaults } : settings;
  } catch { return { ...defaults }; }
}
