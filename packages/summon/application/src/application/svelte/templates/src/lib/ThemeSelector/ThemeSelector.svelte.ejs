<script lang="ts">
  import { Button } from "@canonical/svelte-ds-global";
<% if (forms) { -%>
  import { SelectInput } from "@canonical/svelte-ds-global-form";
<% } -%>
<% if (intl) { -%>
  import { createAppTranslator, getLocaleSource } from "../../i18n/index.js";
<% } -%>
  import setTheme from "./setTheme.js";
  import type { ThemePreference, ThemeSelectorProps } from "./types.js";

  let { preference, ...rest }: ThemeSelectorProps = $props();
<% if (intl) { -%>

  const locale = getLocaleSource();
  const t = $derived(createAppTranslator($locale));
<% } -%>
  // The select owns the value once rendered; the prop only seeds it.
  // svelte-ignore state_referenced_locally
  let value = $state<string>(preference);

  function handleChange() {
    setTheme(value as ThemePreference);
  }
</script>

<form {...rest} method="post" action="/preferences"><% if (forms) { %><SelectInput aria-label=<%- attr("theme.label", "Color theme") %> name="theme" onchange={handleChange} options={[{ value: "system", label: <%- str("theme.system", "System") %> }, { value: "light", label: <%- str("theme.light", "Light") %> }, { value: "dark", label: <%- str("theme.dark", "Dark") %> }]} bind:value /><% } else { %><select aria-label=<%- attr("theme.label", "Color theme") %> name="theme" onchange={handleChange} bind:value><option value="system"><%- msg("theme.system", "System") %></option><option value="light"><%- msg("theme.light", "Light") %></option><option value="dark"><%- msg("theme.dark", "Dark") %></option></select><% } %><noscript><Button importance="secondary" type="submit"><%- msg("preferences.apply", "Apply") %></Button></noscript></form>

<!-- @component
The colour-theme picker. With JavaScript, a change applies at once:
`setTheme` swaps the class on
`<html>` and writes the `theme` cookie. Without JavaScript, the form posts to
`/preferences`, which stores the cookie and sends the reader back, and the
server renders the theme class on `<html>`; its Apply button is in `<noscript>`,
so it never shows while JavaScript runs.

`import { ThemeSelector } from "$lib";`
-->
