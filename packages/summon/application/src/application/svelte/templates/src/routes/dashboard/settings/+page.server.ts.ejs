import { fail } from "@sveltejs/kit";
import { decodeSettings, readSettings, validateSettings } from "$lib/settings";
import type { Actions, PageServerLoad } from "./$types";
export const load: PageServerLoad = ({ cookies }) => ({ settings: readSettings(cookies.get("demo-settings")) });
export const actions: Actions = {
  default: async ({ request, cookies, url }) => {
    const values = decodeSettings(await request.formData());
    const errors = validateSettings(values);
    if (Object.keys(errors).length) return fail(400, { values, errors });
    cookies.set("demo-settings", JSON.stringify(values), { path: "/", sameSite: "lax", httpOnly: true, secure: url.protocol === "https:", maxAge: 31536000 });
    return { values, saved: true };
  },
};
