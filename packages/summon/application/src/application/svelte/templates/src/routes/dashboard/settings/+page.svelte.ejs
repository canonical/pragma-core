<script lang="ts">
  import ProjectDanger from "$lib/ProjectDanger.svelte";
<% if (forms) { %>  import { settingsFields<% if (spa) { %>, decodeSettings, readSettings, validateSettings, defaults, type Settings<% } %> } from "$lib/settings";
<% if (!spa) { %>  import type { PageProps } from "./$types";
  let { data, form }: PageProps = $props();
  let values = $derived(form?.values ?? data.settings);
  let errors = $derived(form && "errors" in form ? form.errors : {});
<% } else { %>  import { onMount } from "svelte";
  let values = $state<Settings>({ ...defaults });
  let errors = $state<{ name?: string; bridge?: string; maxInstances?: string }>({});
  let saved = $state(false);
  onMount(() => { values = readSettings(localStorage.getItem("demo-settings") ?? undefined); });
  function submit(event: SubmitEvent) {
    event.preventDefault();
    const next = decodeSettings(new FormData(event.currentTarget as HTMLFormElement));
    errors = validateSettings(next);
    saved = !Object.keys(errors).length;
    if (saved) { localStorage.setItem("demo-settings", JSON.stringify(next)); values = next; }
  }
<% } %><% } %><% if (intl) { %>  import { getLocaleSource, getTranslator } from "$lib/i18n";
  const locale = getLocaleSource(); let t = $derived(getTranslator($locale));
<% } else { %>  const messages: Record<string, string> = { settings: "Settings", settingsDemo: "These settings are stored locally for this demonstration.", saved: "Settings saved.", displayName: "Display name", nameError: "Enter a display name.", nameTooLong: "Enter no more than 60 characters.", bridge: "Bridge", bridgeError: "Choose a valid bridge.", ipv6: "Enable IPv6", snapshots: "Enable snapshots", maxInstances: "Instance limit", maximumError: "Enter a number from 1 to 100.", save: "Save", demo: "This is a demonstration dashboard." };
  const t = (key: string) => messages[key] ?? key;
<% } %></script>
<svelte:head><title>{t("settings")} | <%= name %></title></svelte:head>
<h1>{t("settings")}</h1>
<% if (forms) { %><p>{t("settingsDemo")}</p>
{#if <%- spa ? 'saved' : 'form?.saved' %>}<p role="status">{t("saved")}</p>{/if}
{#if errors && Object.keys(errors).length}<section aria-labelledby="settings-errors"><h2 id="settings-errors"><%- intl ? '{t("reviewErrors")}' : 'Review errors' %></h2><ul>{#each Object.entries(errors) as [name, message]}<li><a href={`#${name}`}>{t(message)}</a></li>{/each}</ul></section>{/if}
<form <%- spa ? 'onsubmit={submit}' : 'method="POST"' %> novalidate>
  {#each settingsFields as field (field.name)}
    <div class="field">
      <label for={field.name}>{t(field.label)}</label>
      {#if field.inputType === "switch"}
        <input id={field.name} name={field.name} type="checkbox" role="switch" checked={values[field.name]} />
      {:else if field.inputType === "select"}
        <select id={field.name} name={field.name} value={values[field.name]} aria-invalid={errors?.bridge ? "true" : undefined} aria-describedby={errors?.bridge ? "bridge-error" : undefined}>{#each field.options as option}<option value={option.value}>{option.label}</option>{/each}</select>
        {#if errors?.bridge}<p id="bridge-error">{t(errors.bridge)}</p>{/if}
      {:else if field.inputType === "number"}
        <input id={field.name} name={field.name} type="number" value={values[field.name]} min="1" max="100" step="1" required aria-invalid={errors?.maxInstances ? "true" : undefined} aria-describedby={errors?.maxInstances ? "maxInstances-error" : undefined} />
        {#if errors?.maxInstances}<p id="maxInstances-error">{t(errors.maxInstances)}</p>{/if}
      {:else}
        <input id={field.name} name={field.name} type="text" value={values[field.name]} maxlength="60" required aria-invalid={errors?.name ? "true" : undefined} aria-describedby={errors?.name ? "name-error" : undefined} />
        {#if errors?.name}<p id="name-error">{t(errors.name)}</p>{/if}
      {/if}
    </div>
  {/each}
  <button type="submit">{t("save")}</button>
</form>
<% } else { %><p>{t("demo")}</p>
<% } %>
<ProjectDanger />
