/** Return to a same-origin referrer without reinterpreting its path as an authority. */
export function resolveReturnTo(referer: string | null, url: URL): string {
  if (!referer) return "/";
  try {
    const previous = new URL(referer, url);
    if (previous.origin !== url.origin) return "/";
    return `${url.origin}${previous.pathname}${previous.search}`;
  } catch {
    return "/";
  }
}
