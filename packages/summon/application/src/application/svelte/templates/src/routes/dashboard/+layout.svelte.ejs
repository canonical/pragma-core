<script lang="ts">
  import { page } from "$app/state";
  import { Breadcrumbs } from "@canonical/svelte-ds-global";
  import type { LayoutProps } from "./$types";
  let { children }: LayoutProps = $props();
<% if (intl) { %>  import { getLocaleSource, getTranslator } from "$lib/i18n";
  const locale = getLocaleSource(); let t = $derived(getTranslator($locale));
<% } else { %>  const labels: Record<string, string> = { dashboard: "Dashboard", instances: "Instances", settings: "Settings", confirmRemove: "Confirm removal", confirmProject: "Confirm project deletion" };
  const t = (key: string) => labels[key] ?? key;
<% } %>  let path = $derived(page.url.pathname);
  let crumb = $derived(path.endsWith("/remove") ? "confirmRemove" : path.endsWith("/settings/confirm") ? "confirmProject" : path.split("/").at(-1) ?? "dashboard");
  let crumbs = $derived([{ label: t("dashboard"), url: "/dashboard" }, ...(path.endsWith("/remove") ? [{ label: t("instances"), url: "/dashboard/instances" }] : path.endsWith("/settings/confirm") ? [{ label: t("settings"), url: "/dashboard/settings" }] : []), { key: "current", label: t(crumb), current: true }]);
</script>
{#if path !== "/dashboard"}<Breadcrumbs items={crumbs} />{/if}
{@render children()}
