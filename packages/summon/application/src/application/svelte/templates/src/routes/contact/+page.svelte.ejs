<script lang="ts">
  import { fields, <%- spa ? 'decode, validate, ' : '' %>type Errors, type Values, type FieldName } from "$lib/contact";
<% if (intl) { %>  import { getLocaleSource, getTranslator } from "$lib/i18n";
  const locale = getLocaleSource();
  let t = $derived(getTranslator($locale));
<% } else { %>  const messages: Record<string, string> = { contact: "Contact", contactDemo: "Demo: no message is delivered.", spaContactDemo: "Client-only demo: no message is sent or stored.", sent: "Your message was received.", sentOlder: "Your earlier message was received; your current draft has not been sent.", invalidOlder: "Your earlier submission was invalid; your current draft has not been sent.", failed: "The result could not be confirmed. Please try again.", email: "Email", message: "Message", emailError: "Enter a valid email address.", messageError: "Enter a message.", tooLong: "Enter no more than 4000 characters.", sending: "Sending…", send: "Send", spaValidated: "The draft is valid. Nothing was sent." };
  const t = (key: string) => messages[key] ?? key;
<% } %><% if (!spa) { %>  import { enhance } from "$app/forms";
  import type { SubmitFunction } from "@sveltejs/kit";
  import { onDestroy } from "svelte";
  import type { PageProps } from "./$types";
  let { form }: PageProps = $props();
  // svelte-ignore state_referenced_locally
  let values = $state<Values>({ email: form?.values?.email ?? "", message: form?.values?.message ?? "" });
  let pending = $state(false);
  let notice = $state<"sentOlder" | "invalidOlder" | "failed" | "">("");
  let edited = $state(false);
  let editedFields = $state<Partial<Record<FieldName, boolean>>>({});
  let enhancedResult = $state<{ success?: boolean; errors?: Errors } | undefined>();
  let errors = $derived.by(() => {
    const source = enhancedResult ? enhancedResult.errors : form?.errors;
    return Object.fromEntries(Object.entries(source ?? {}).filter(([name]) => !editedFields[name as FieldName])) as Errors;
  });
  let revision = 0;
  let generation = 0;
  let active: AbortController | undefined;
  onDestroy(() => { generation++; active?.abort(); });
  function onEdit(event: Event) {
    const target = event.target;
    if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
    if (target.name !== "email" && target.name !== "message") return;
    revision++; edited = true; editedFields[target.name] = true;
  }
  const submit: SubmitFunction<{ success: boolean }, { values: Values; errors: Errors }> = ({ cancel, controller, formData, formElement, submitter }) => {
    if (pending) { cancel(); return; }
    pending = true; notice = ""; active = controller;
    const started = revision;
    const currentGeneration = ++generation;
    const captured = JSON.stringify([...formData.entries()]);
    return ({ result }) => {
      if (currentGeneration !== generation) return;
      active = undefined; pending = false;
      if (!formElement.isConnected) return;
      const current = JSON.stringify([...new FormData(formElement, submitter).entries()]);
      if (result.type === "error" || result.type === "redirect") { notice = "failed"; return; }
      if (started !== revision || captured !== current) { notice = result.type === "success" ? "sentOlder" : "invalidOlder"; return; }
      edited = false;
      editedFields = {};
      enhancedResult = result.type === "success" ? { success: true } : { errors: result.data?.errors };
    };
  };
<% } else { %>  let errors = $state<Errors>({});
  let submitted = $state(false);
  function onEdit(event: Event) {
    const target = event.target;
    if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
    if (target.name !== "email" && target.name !== "message") return;
    delete errors[target.name]; submitted = false;
  }
  function submit(event: SubmitEvent) {
    event.preventDefault();
    errors = validate(decode(new FormData(event.currentTarget as HTMLFormElement)));
    submitted = !Object.keys(errors).length;
  }
<% } %></script>
<svelte:head><title>{t("contact")} | <%= name %></title></svelte:head>
<h1>{t("contact")}</h1><p>{t(<%- spa ? '"spaContactDemo"' : '"contactDemo"' %>)}</p>
<% if (!spa) { %>{#if (enhancedResult?.success || (!enhancedResult && form?.success)) && !notice && !edited}<p role="status">{t("sent")}</p>{/if}
{#if notice}<p role="status">{t(notice)}</p>{/if}
<form method="POST" novalidate use:enhance={submit} oninput={onEdit} onchange={onEdit}>
<% } else { %>{#if submitted}<p role="status">{t("spaValidated")}</p>{/if}
<form onsubmit={submit} oninput={onEdit} onchange={onEdit} novalidate>
<% } %>  {#each fields as field (field.name)}
    <div class="field">
      <label for={field.name}>{t(field.label)}</label>
      {#if field.inputType === "textarea"}
        <textarea id={field.name} name={field.name} required maxlength="4000" <% if (!spa) { %>bind:value={values[field.name]} <% } %>aria-invalid={errors?.[field.name] ? "true" : undefined} aria-describedby={errors?.[field.name] ? `${field.name}-error` : undefined}></textarea>
      {:else}
        <input id={field.name} name={field.name} type={field.inputType} required maxlength="4000" <% if (!spa) { %>bind:value={values[field.name]} <% } %>aria-invalid={errors?.[field.name] ? "true" : undefined} aria-describedby={errors?.[field.name] ? `${field.name}-error` : undefined} />
      {/if}
      {#if errors?.[field.name]}<p id={`${field.name}-error`}>{t(errors[field.name]!)}</p>{/if}
    </div>
  {/each}
  <button type="submit"<% if (!spa) { %> disabled={pending}<% } %>>{t(<%- spa ? '"send"' : 'pending ? "sending" : "send"' %>)}</button>
</form>
