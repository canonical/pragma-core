<script lang="ts">
  import formatDocumentTitle from "../../formatDocumentTitle.js";
<% if (intl) { -%>
  import { createAppTranslator, getLocaleSource } from "../../i18n/index.js";
<% } -%>

  let {
    from,
  }: {
    /** The protected page the reader was sent here from. */
    from?: string;
  } = $props();
<% if (intl) { -%>

  const locale = getLocaleSource();
  const t = $derived(createAppTranslator($locale));
<% } -%>
</script>

<svelte:head><title>{formatDocumentTitle(<%- str("login.title", "Login") %>)}</title></svelte:head>

<section aria-labelledby="login-title">
  <h1 id="login-title"><%- msg("login.heading", "Login") %></h1>
  <!-- The `?auth=1` literal is markup (<code>), which a plain message string
       cannot carry, so the sentence is catalogued as the fragments around it. -->
  <p><%- msg("login.hintBefore", "Demo login. Add") %> <code>?auth=1</code> <%- msg("login.hintAfter", "to any protected URL to simulate authentication.") %></p>
<% if (intl) { -%>
  {#if from}<p>{t("login.redirect", { from })}</p>{/if}
<% } else { -%>
  {#if from}<p>{`You will be redirected to ${from} after login.`}</p>{/if}
<% } -%>
</section>
