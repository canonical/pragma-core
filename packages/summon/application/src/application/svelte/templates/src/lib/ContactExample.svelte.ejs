<script lang="ts">
  import { fields, type Errors } from "./contact";
  let { language = "en", invalid = false }: { language?: string; invalid?: boolean } = $props();
<% if (intl) { %>  import { getTranslator } from "./i18n";
  let t = $derived(getTranslator(language));
<% } else { %>  const messages: Record<string, string> = { contact: "Contact", email: "Email", message: "Message", emailError: "Enter a valid email address.", send: "Send" };
  const t = (key: string) => messages[key] ?? key;
<% } %>  let errors: Errors = $derived(invalid ? { email: "emailError" } : {});
</script>
<div class="app comfortable" lang={language} dir={language === "ar" ? "rtl" : "ltr"}>
  <h1>{t("contact")}</h1><form onsubmit={(event) => event.preventDefault()}>
    {#each fields as field (field.name)}
      <div class="field"><label for={field.name}>{t(field.label)}</label>
        {#if field.inputType === "textarea"}<textarea id={field.name} name={field.name} required></textarea>{:else}<input id={field.name} name={field.name} type={field.inputType} required aria-invalid={errors[field.name] ? "true" : undefined} />{/if}
        {#if errors[field.name]}<p>{t(errors[field.name]!)}</p>{/if}</div>
    {/each}
    <button type="submit">{t("send")}</button>
  </form>
</div>
