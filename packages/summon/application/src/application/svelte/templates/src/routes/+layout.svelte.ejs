<script lang="ts">
  import RootLayout from "../layouts/RootLayout.svelte";
<% if (spa) { -%>
  import setTheme from "../lib/ThemeSelector/setTheme.js";
<% } -%>
  import type { LayoutProps } from "./$types";

  let { children<% if (intl || spa) { %>, data<% } %> }: LayoutProps = $props();
<% if (spa) { -%>

  // Applies the stored theme to <html> once the page is in the browser: the
  // static fallback page has no server to render the class. It runs once,
  // since the stored theme only changes through the selector, which applies
  // changes itself.
  $effect(() => {
    setTheme(data.theme);
  });
<% } -%>
</script>

<RootLayout<% if (intl) { %> locale={data.locale}<% } %>>{@render children()}</RootLayout>
