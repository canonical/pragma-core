<script lang="ts">
<% if (spa) { %>  import { goto } from "$app/navigation";
  function enter() { sessionStorage.setItem("demo-session", "yes"); void goto("/account"); }
<% } %><% if (intl) { %>  import { getLocaleSource, getTranslator } from "$lib/i18n";
  const locale = getLocaleSource(); let t = $derived(getTranslator($locale));
<% } %>
</script>
<svelte:head><title><%- intl ? '{t("login")}' : 'Login' %> | <%= name %></title></svelte:head>
<h1><%- intl ? '{t("login")}' : 'Login' %></h1>
<p><%- intl ? '{t("demoWarning")}' : 'This demonstration does not authenticate users or protect real data.' %></p>
<% if (spa) { %><button type="button" onclick={enter}><%- intl ? '{t("enterAccount")}' : 'Enter demo account' %></button><% } else { %><form method="POST"><button type="submit"><%- intl ? '{t("enterAccount")}' : 'Enter demo account' %></button></form><% } %>
