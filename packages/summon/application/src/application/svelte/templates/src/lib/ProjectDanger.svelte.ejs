<script lang="ts">
  import { Modal } from "@canonical/svelte-ds-global";
<% if (intl) { %>  import { getLocaleSource, getTranslator } from "$lib/i18n";
  const locale = getLocaleSource(); let t = $derived(getTranslator($locale));
<% } else { %>  const messages: Record<string, string> = { dangerZone: "Danger zone", deleteProject: "Delete demo project", deleteProjectBody: "This is a demonstration; no project will be deleted.", confirmProject: "Confirm project deletion", confirmedProject: "Demonstration confirmed; no project was deleted.", cancel: "Cancel" };
  const t = (key: string) => messages[key] ?? key;
<% } %>  let open = $state(false), completed = $state(false);
  let opener = $state<HTMLAnchorElement>();
  function show(event: MouseEvent) { if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); open = true; }
</script>
<section aria-labelledby="danger-title" class="danger-zone"><h2 id="danger-title">{t("dangerZone")}</h2><p>{t("deleteProjectBody")}</p>
  {#if completed}<p role="status">{t("confirmedProject")}</p>{/if}
  <a bind:this={opener} href="/dashboard/settings/confirm" onclick={show}>{t("deleteProject")}</a>
</section>
<Modal bind:open onclose={() => opener?.focus()}><Modal.Header closeButton={false}><h2>{t("confirmProject")}</h2></Modal.Header>
  <Modal.Content><p>{t("deleteProjectBody")}</p></Modal.Content>
  <Modal.Footer><button type="button" onclick={() => open = false}>{t("cancel")}</button><button type="button" onclick={() => { completed = true; open = false; }}>{t("deleteProject")}</button></Modal.Footer>
</Modal>
