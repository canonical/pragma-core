@import url("@canonical/styles/fonts");
@import url("@canonical/styles");

@layer app {
.navigation-menu { padding: 1rem; }
.navigation-menu ul { list-style: none; padding: 0; }
.navigation-menu li { margin-block-end: 0.75rem; }
main { grid-column: 1 / -1; min-inline-size: 0; padding: 1rem; }
header { display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem; }
.field { display: grid; gap: 0.25rem; margin-block: 1rem; max-inline-size: 40rem; }
.dashboard-navigation { padding: 1rem; }
.dashboard-navigation summary, .instance-panel summary { cursor: pointer; font-weight: 600; }
.dashboard-navigation .navigation-heading { font-size: 1rem; margin-block: 1rem 0.5rem; }
.nav-unavailable { color: var(--color-text-muted, GrayText); font-size: 0.875em; }
.dashboard-nav a[aria-current="page"] { font-weight: 700; }
.dashboard-nav { list-style: none; padding: 0; }
.dashboard-nav li { margin-block: 0.75rem; }
.instance-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem); gap: 1.5rem; align-items: start; }
.dashboard-overview { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem); gap: 1.5rem; align-items: start; }
.activity-panel { border: 1px solid var(--color-border, currentColor); padding: 1rem; }
.instance-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; list-style: none; padding: 0; }
.instance-card, .instance-panel { border: 1px solid var(--color-border, currentColor); padding: 1rem; min-inline-size: 0; }
.instance-panel.enhanced .instance-panel-content { position: fixed; z-index: 20; inset-block: 0; inset-inline-end: 0; width: min(28rem, 100vw); overflow: auto; padding: 1.5rem; background: Canvas; color: CanvasText; box-shadow: 0 0 1rem #0005; }
.instance-layout pre { white-space: pre-wrap; overflow-wrap: anywhere; }
.skip-link { position: absolute; transform: translateY(-200%); }
.skip-link:focus { transform: none; z-index: 1; background: Canvas; color: CanvasText; }
@media (max-width: 40rem) { .ds.application-layout, .instance-layout, .dashboard-overview { grid-template-columns: 1fr; } }
}
