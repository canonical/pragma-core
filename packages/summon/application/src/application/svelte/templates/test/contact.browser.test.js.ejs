test("native validation errors survive hydration independently", async () => {
  const context = await browser.newContext();
  try {
    const page = await context.newPage();
    const response = await page.request.post(`${base}/contact`, { headers: { origin: base, accept: "text/html" }, form: { email: "", message: "" } });
    assert.equal(response.status(), 400);
    const body = await response.text();
    await page.route("**/contact", (route) => route.fulfill({ status: 400, contentType: "text/html", body }), { times: 1 });
    await page.goto(`${base}/contact`); await page.waitForLoadState("networkidle");
    await page.getByLabel("Email").fill("valid@example.com"); await assertMessageError(page);
  } finally { await context.close(); }
});

test("native submission exposes both errors without JavaScript", async () => {
  const context = await browser.newContext({ javaScriptEnabled: false });
  try {
    const page = await context.newPage(); await page.goto(`${base}/contact`);
    const response = page.waitForResponse((response) => response.url().endsWith("/contact") && response.request().method() === "POST");
    await page.getByRole("button", { name: "Send" }).click(); assert.equal((await response).status(), 400);
    for (const name of ["Email", "Message"]) {
      assert.equal(await page.getByLabel(name).getAttribute("aria-invalid"), "true");
      assert.match(await page.getByLabel(name).getAttribute("aria-describedby"), new RegExp(`${name.toLowerCase()}-error`));
    }
  } finally { await context.close(); }
});

test("an obsolete failure does not replace newer edits", async () => {
  const context = await browser.newContext();
  try {
    const page = await context.newPage(); await page.goto(`${base}/contact`); await page.waitForLoadState("networkidle");
    let release; const blocked = new Promise((resolve) => { release = resolve; });
    await page.route("**/contact", async (route) => { if (route.request().method() === "POST") await blocked; await route.continue(); });
    await page.getByLabel("Email").fill("invalid"); await page.getByLabel("Message").fill("First");
    await page.getByRole("button", { name: "Send" }).click();
    await page.getByLabel("Email").fill("valid@example.com"); await page.getByLabel("Message").fill("New draft");
    release(); await page.getByText(/earlier submission was invalid/).waitFor();
    assert.equal(await page.getByLabel("Email").inputValue(), "valid@example.com");
    assert.equal(await page.getByLabel("Message").inputValue(), "New draft");
  } finally { await context.close(); }
});

test("an obsolete success does not replace newer edits", async () => {
  const context = await browser.newContext();
