import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { createServer } from "node:net";
import { after, before, test } from "node:test";
import { chromium } from "playwright";

let server, browser, base;
before(async () => {
  const socket = createServer();
  await new Promise((resolve) => socket.listen(0, "127.0.0.1", resolve));
  const { port } = socket.address();
  await new Promise((resolve) => socket.close(resolve));
  base = `http://127.0.0.1:${port}`;
<% if (spa) { %>  server = spawn(process.execPath, ["node_modules/vite/bin/vite.js", "preview", "--host", "127.0.0.1", "--port", String(port), "--strictPort"], { stdio: "ignore" });
<% } else { %>  server = spawn(process.execPath, ["build/index.js"], { env: { ...process.env, HOST: "127.0.0.1", PORT: String(port), ORIGIN: base }, stdio: "ignore" });
<% } %>  for (let i = 0; i < 100; i++) {
    if (server.exitCode !== null) throw new Error("Server exited; build the app before testing");
    try { if ((await fetch(base)).ok) break; } catch { /* Await startup. */ }
    if (i === 99) throw new Error("Server did not start");
    await new Promise((resolve) => setTimeout(resolve, 50));
  }
  browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, headless: true });
});
after(async () => { await browser?.close(); server?.kill(); });

async function assertMessageError(page) {
  assert.equal(await page.getByLabel("Email").getAttribute("aria-invalid"), null);
  assert.equal(await page.getByLabel("Message").getAttribute("aria-invalid"), "true");
  assert.match(await page.getByLabel("Message").getAttribute("aria-describedby"), /message-error/);
  assert.match(await page.locator("#message-error").innerText(), /Enter a message/);
}

test("editing email preserves the message error", async () => {
  const context = await browser.newContext();
  try {
    const page = await context.newPage();
    await page.goto(`${base}/contact`); await page.waitForLoadState("networkidle");
    await page.getByRole("button", { name: "Send" }).click();
    await page.getByText("Enter a valid email address.").waitFor();
    await page.getByText("Enter a message.").waitFor();
    await page.getByLabel("Email").fill("valid@example.com");
    await assertMessageError(page);
    await page.getByRole("button", { name: "Send" }).click();
    await page.getByText("Enter a message.").waitFor();
    await page.getByLabel("Message").fill("Hello");
    await page.getByRole("button", { name: "Send" }).click();
    await page.getByText(<%- spa ? '"The draft is valid. Nothing was sent."' : '"Your message was received."' %>).waitFor();
  } finally { await context.close(); }
});
