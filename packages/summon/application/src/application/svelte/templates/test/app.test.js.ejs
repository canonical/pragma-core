test("demo account routing, dashboard settings and instances", async () => {
  const request = (path, options = {}) => fetch(new URL(path, base), { redirect: "manual", ...options });
  assert.equal((await request("/dashboard")).status, 200);
  const account = await request("/account");
  assert.equal(account.status, 302); assert.equal(account.headers.get("location"), "/login?from=%2Faccount");
  assert.equal((await request("/account", { method: "POST", headers: { origin: base, accept: "text/html", "content-type": "application/x-www-form-urlencoded" }, body: "" })).status, 302);
  assert.equal((await request("/account", { method: "POST", headers: { origin: "https://evil.test", cookie: "demo-session=yes", "content-type": "application/x-www-form-urlencoded" }, body: "" })).status, 403);
  const accountAction = await request("/account", { method: "POST", headers: { origin: base, accept: "text/html", cookie: "demo-session=yes", "content-type": "application/x-www-form-urlencoded" }, body: "" });
  assert.equal(accountAction.status, 303); assert.equal(accountAction.headers.get("location"), "/dashboard");
  assert.equal((await request("/login", { method: "POST", headers: { origin: "https://evil.test", accept: "text/html", "content-type": "application/x-www-form-urlencoded" }, body: "" })).status, 403);
  const login = await request("/login", { method: "POST", headers: { origin: base, accept: "text/html", "content-type": "application/x-www-form-urlencoded" }, body: "" });
  assert.equal(login.status, 303);
  const cookie = login.headers.get("set-cookie").split(";")[0];
  const settings = await request("/dashboard/settings", { method: "POST", headers: { origin: base, accept: "text/html", cookie, "content-type": "application/x-www-form-urlencoded" }, body: "name=Alex&bridge=lxdbr0&maxInstances=50&ipv6=on" });
  assert.equal(settings.status, 200); assert.match(await settings.text(), /Settings saved/);
  const badSettings = await request("/dashboard/settings", { method: "POST", headers: { origin: base, accept: "text/html", cookie, "content-type": "application/x-www-form-urlencoded" }, body: `name=${"x".repeat(61)}&bridge=invalid&maxInstances=101` });
  assert.equal(badSettings.status, 400);
  const postInstance = (action, body, session = cookie) => request(`/dashboard/instances?/${action}`, { method: "POST", headers: { origin: base, accept: "text/html", cookie: session, "content-type": "application/x-www-form-urlencoded" }, body });
  assert.equal((await postInstance("create", "name=INVALID&release=noble")).status, 400);
  const created = await postInstance("create", "name=one&release=noble&pro=on&cloudInit=hello");
  assert.equal(created.status, 303);
  const instanceCookie = created.headers.get("set-cookie").split(";")[0];
  const session = `${cookie}; ${instanceCookie}`;
  const overview = await request("/dashboard", { headers: { cookie: session } });
  assert.match(await overview.text(), /<h3>Instances<\/h3>\s*<p>1<\/p>/);
  const launched = await request("/dashboard/instances?create=1&release=focal");
  const launchedHtml = await launched.text();
  assert.match(launchedHtml, /<details[^>]*\bopen/); assert.match(launchedHtml, /value="focal"[^>]*selected/);
  assert.equal((await postInstance("create", "name=one&release=noble", session)).status, 400);
  const detail = await request("/dashboard/instances?selected=one", { headers: { cookie: session } });
  const detailHtml = await detail.text(); assert.match(detailHtml, /one/); assert.match(detailHtml, /hello/);
  const duplicateRecords = encodeURIComponent(JSON.stringify([{ name: "same", release: "noble", pro: false, cloudInit: "" }, { name: "same", release: "focal", pro: false, cloudInit: "" }]));
  const duplicatePage = await request("/dashboard/instances", { headers: { cookie: `demo-instances=${duplicateRecords}` } });
  assert.match(await duplicatePage.text(), /No demo instances yet/);
  assert.equal((await postInstance("create", "name=legacy&release=focal")).status, 303);
  assert.equal((await postInstance("create", `name=long&release=noble&cloudInit=${"x".repeat(1001)}`, session)).status, 400);
  const confirmation = await request("/dashboard/instances/remove?name=one", { headers: { cookie: session } });
  assert.equal(confirmation.status, 200); assert.match(await confirmation.text(), /Confirm removal/);
  assert.equal((await request("/dashboard/instances/remove?name=missing", { headers: { cookie: session } })).status, 404);
  const postRemoval = (body, origin = base) => request("/dashboard/instances/remove?name=one", { method: "POST", headers: { origin, accept: "text/html", cookie: session, "content-type": "application/x-www-form-urlencoded" }, body });
  assert.equal((await postRemoval("name=one", "https://evil.test")).status, 403);
  assert.equal((await postRemoval("name=one&name=one")).status, 404);
  assert.equal((await postRemoval("name=one")).status, 303);
  const confirmProject = await request("/dashboard/settings/confirm", { method: "POST", headers: { origin: base, accept: "text/html", "content-type": "application/x-www-form-urlencoded" }, body: "" });
  assert.equal(confirmProject.status, 200); assert.match(await confirmProject.text(), /no project was deleted/);
});
