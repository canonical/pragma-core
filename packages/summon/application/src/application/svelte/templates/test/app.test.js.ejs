import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { createServer } from "node:net";
import { readFile } from "node:fs/promises";
import { after, before, test } from "node:test";

<% if (!spa) { %>let server;
let base;
before(async () => {
  const socket = createServer();
  await new Promise((resolve) => socket.listen(0, "127.0.0.1", resolve));
  const { port } = socket.address();
  await new Promise((resolve, reject) => socket.close((error) => error ? reject(error) : resolve()));
  base = `http://127.0.0.1:${port}`;
  server = spawn(process.env.SERVER_RUNTIME === "bun" ? "bun" : process.execPath, ["build/index.js"], { env: { ...process.env, HOST: "127.0.0.1", PORT: String(port), ORIGIN: base }, stdio: "ignore" });
  for (let attempt = 0; attempt < 100; attempt++) {
    if (server.exitCode !== null) throw new Error("Server exited");
    try { if ((await fetch(base)).ok) return; } catch { /* Await startup. */ }
    await new Promise((resolve) => setTimeout(resolve, 100));
  }
  throw new Error("Server did not start; run the build first");
});
after(() => server?.kill());

test("server renders routes, theme, assets and sitemap", async () => {
  const request = (path, options = {}) => fetch(new URL(path, base), { redirect: "manual", ...options });
  const dark = await request("/", { headers: { cookie: "theme=dark" } });
  assert.match(await dark.text(), /class="app comfortable dark"/);
  assert.equal(dark.headers.get("cache-control"), "private, no-store");
  assert.equal((await request("/home")).status, 301);
  assert.equal((await request("/missing")).status, 404);
  assert.equal((await request("/catalog/missing")).status, 404);
  assert.equal((await request("/icons/information.svg")).status, 200);
  const product = await (await request("/catalog/compute")).text();
  assert.match(product, /class="ds breadcrumbs"/);
  assert.match(await (await request("/sitemap.xml")).text(), /\/catalog\/compute/);
  const [alice, bob] = await Promise.all(["Alice", "Bob"].map((visitor) => request("/catalog/compute", { headers: { cookie: `visitor=${visitor}` } }).then((response) => response.text())));
  assert.match(alice, /Viewing as Alice/); assert.doesNotMatch(alice, /Viewing as Bob/); assert.match(bob, /Viewing as Bob/);
<% if (intl) { %>  assert.match(await (await request("/", { headers: { cookie: "locale=ar" } })).text(), /lang="ar" dir="rtl"/);
  assert.match(await (await request("/catalog", { headers: { cookie: "locale=ar" } })).text(), /منتجان/);
  assert.match(await (await request("/catalog", { headers: { cookie: "locale=fr" } })).text(), /2 produits/);
<% } %>});

test("preference redirects remain same-origin for hostile referrers", async () => {
  const endpoints = ["preferences"<% if (intl) { %>, "language"<% } %>];
  const referrers = [
    [`${base}/catalog/compute?view=detail`, "/catalog/compute?view=detail"],
    [`${base}//evil.test/path`, "//evil.test/path"],
    [`${base}/\\evil.test/path`, "//evil.test/path"],
    [`${base}/%2f%2fevil.test/path`, "/%2f%2fevil.test/path"],
    [`${base}/%5cevil.test/path`, "/%5cevil.test/path"],
    ["https://evil.test/path", "/"],
    ["//evil.test/path", "/"],
    ["http://[invalid", "/"],
    ["", "/"],
  ];
  for (const endpoint of endpoints) {
    for (const [referer, expected] of referrers) {
      const response = await fetch(`${base}/${endpoint}`, {
        method: "POST", redirect: "manual",
        headers: { origin: base, referer, "content-type": "application/x-www-form-urlencoded" },
        body: endpoint === "language" ? "locale=fr" : "theme=dark",
      });
      assert.equal(response.status, 303, `${endpoint} ${referer}`);
      const location = response.headers.get("location");
      const resolved = new URL(location, base);
      assert.equal(resolved.origin, base, `${endpoint} ${referer}: ${location}`);
      assert.equal(resolved.pathname + resolved.search, expected, `${endpoint} ${referer}`);
    }
  }
});
<% if (forms) { %>
test("contact action validates and preserves values", async () => {
  const post = (body) => fetch(`${base}/contact`, { method: "POST", headers: { origin: base, accept: "text/html", "content-type": "application/x-www-form-urlencoded" }, body });
  const invalid = await post("email=bad&message=Draft");
  assert.equal(invalid.status, 400);
  const html = await invalid.text(); assert.match(html, /email-error/); assert.match(html, /Draft/);
  const both = await post("email=&message=");
  assert.equal(both.status, 400);
  const bothHtml = await both.text();
  assert.match(bothHtml, /id="email-error"/); assert.match(bothHtml, /id="message-error"/);
  for (const name of ["email", "message"]) {
    const control = bothHtml.match(new RegExp(`<${name === "email" ? "input" : "textarea"}\\b[^>]*\\bid="${name}"[^>]*>`))?.[0];
    assert.ok(control); assert.match(control, /aria-invalid="true"/); assert.match(control, new RegExp(`aria-describedby="${name}-error"`));
  }
  const valid = await post("email=a%40example.com&message=Draft");
  assert.equal(valid.status, 200); assert.match(await valid.text(), /Your message was received/);
  const oversized = await post(`email=a%40example.com&message=${"x".repeat(4001)}`);
  assert.equal(oversized.status, 400);
});
